{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "change_type": {
      "type": "string",
      "enum": [
        "code",
        "content",
        "mixed",
        "none"
      ]
    },
    "client_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "files_changed": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "questions": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "needs_approval": {
      "type": "boolean"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  },
  "required": [
    "summary",
    "change_type",
    "client_message",
    "files_changed",
    "questions",
    "needs_approval",
    "risk"
  ],
  "additionalProperties": false
}
