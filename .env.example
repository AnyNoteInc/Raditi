# Радити — переменные для локальной разработки.
# Скопируйте в .env: cp .env.example .env
# Новая переменная → сюда и в globalEnv в turbo.json.

NODE_ENV=development
# Окружение платформы: development | test | production. Прод-проверки (обязательная капча и т. п.) — по нему, не по NODE_ENV.
APP_ENV=development
APP_URL=http://localhost:3000
PUBLIC_DOMAIN=raditi.ru

# Оркестратор (apps/orchestrator): роли процесса — core, mcp, runner; локально core и mcp в одном процессе
ORCHESTRATOR_PORT=8081
ORCHESTRATOR_ROLES=core,mcp
# MCP-шлюз — отдельный порт: песочнице доступен только он, а не API оркестратора
MCP_PORT=8082
# Где идут ходы агента: local — Docker на машине core (не в проде), runner — песочные ВМ
TURN_EXECUTOR=local
# API раннеров (TURN_EXECUTOR=runner): отдельный порт core в частной сети, песочным ВМ доступен только он
RUNNER_API_PORT=8083
# SHA-256 токенов раннеров: <runner id>:<sha256>,…, до двух на раннер для ротации.
# Выпуск: pnpm --filter orchestrator runner-token issue <runner id> <файл токена>
RUNNER_TOKENS=

# Роль runner (песочная ВМ): без HTTP-сервера, сама опрашивает API раннеров core.
# В проде раннер не запускается, если заданы DATABASE_URL, REDIS_URL, VAULT_* или S3_*.
# Адрес API раннеров core; в проде только https://
RUNNER_CORE_URL=http://127.0.0.1:8083
# Абсолютный путь к файлу с токеном ВМ (в проде — root, 0400); токен никогда не задаётся переменной
RUNNER_TOKEN_FILE=
# Свой CA для сертификата core (абсолютный путь), если core подписан не публичным CA
RUNNER_CORE_CA_FILE=
# Сколько ходов раннер ведёт одновременно; до этапа 2 — только 1
RUNNER_MAX_TURNS=1
# Образ оркестратора по digest для сервиса runner в infra/sandbox/docker-compose.yml (профиль runner)
RUNNER_IMAGE=

# PostgreSQL
DATABASE_URL=postgresql://raditi:raditi@localhost:5432/raditi

# Redis и BullMQ
REDIS_URL=redis://localhost:6379

# S3: локально SeaweedFS, в проде — S3 российского облака
S3_ENDPOINT=http://localhost:8333
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=raditi
S3_SECRET_ACCESS_KEY=raditi-dev-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_INBOX=raditi-inbox
S3_BUCKET_SESSIONS=raditi-sessions
S3_BUCKET_LOGS=raditi-logs
S3_BUCKET_ARTIFACTS=raditi-artifacts
S3_BUCKET_BACKUPS=raditi-backups
S3_BUCKET_PLATFORM=raditi-platform
# Адрес S3, каким его видит песочная ВМ раннера: под него подписываются presigned-ссылки хода. Пусто — S3_ENDPOINT
S3_RUNNER_ENDPOINT=

# Vault: локально OpenBao в dev-режиме; в проде сервисы входят по AppRole
VAULT_ADDR=http://localhost:8200
VAULT_DEV_ROOT_TOKEN=raditi-dev-root
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Gitea
GITEA_URL=http://localhost:3300
GITEA_TOKEN=
GITEA_WEBHOOK_SECRET=
GITEA_RUNNER_TOKEN=

# LiteLLM и провайдеры моделей — только российские
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-raditi-dev
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
CLOUDRU_API_KEY=
GIGACHAT_AUTH_KEY=

# Тестовый WordPress (профиль site): порт на хосте, если 8080 занят
SITE_PORT=8080

# Песочница агента: Docker ведёт роль runner, а core — только при TURN_EXECUTOR=local.
# На Linux с gVisor — runsc, на macOS — runc
SANDBOX_RUNTIME=runc
SANDBOX_IMAGE_PREFIX=raditi/agent
SANDBOX_DOCKER_SOCKET=/var/run/docker.sock
# Separate trusted deadline watchdog, started with infra/sandbox/docker-compose.yml.
SANDBOX_WATCHDOG_IMAGE=
# Opt-in integration tests only; prebuilt runtime image pinned by digest.
RADITI_DOCKER_TEST_IMAGE=
# Where gateway containers reach the test upstream on this machine (default host.docker.internal;
# a Colima VM reaches the macOS host at 192.168.5.2).
RADITI_DOCKER_TEST_UPSTREAM_HOST=
# Opt-in trusted Git publication smoke only.
P2_GITLEAKS_BINARY=
P2_SANDBOX_IMAGE=
# All four values are required to enable gateway networking. Images must use @sha256 digests.
SANDBOX_GATEWAY_IMAGE=
SANDBOX_NETWORK_GUARD_IMAGE=
SANDBOX_LLM_UPSTREAM=
SANDBOX_MCP_UPSTREAM=

# Вход
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Yandex SmartCaptcha: пусто — капча выключена (локально, e2e); в проде обязательны оба ключа
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_CLIENT_KEY=

# Telegram (через egress-прокси)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PROXY_URL=

# ЮKassa — тестовый магазин
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Почта (SendSay) и распознавание голоса
SENDSAY_API_KEY=
SPEECHKIT_API_KEY=

# Мониторинг: токен для /api/metrics (web) и /metrics (оркестратор); пароль Grafana (профиль monitoring)
# В проде METRICS_TOKEN — не короче 32 символов (например, openssl rand -hex 32).
# Тот же токен открывает подробности /api/health и /health роли core; без него — только status.
METRICS_TOKEN=raditi-dev-metrics
GRAFANA_ADMIN_PASSWORD=raditi-dev
