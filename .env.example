# Радити — переменные для локальной разработки.
# Скопируйте в .env: cp .env.example .env
# Новая переменная → сюда и в globalEnv в turbo.json.

NODE_ENV=development
APP_URL=http://localhost:3000
PUBLIC_DOMAIN=raditi.ru

# PostgreSQL
DATABASE_URL=postgresql://raditi:raditi@localhost:5432/raditi

# Redis и BullMQ
REDIS_URL=redis://localhost:6379

# S3: локально SeaweedFS, в проде — S3 российского облака
S3_ENDPOINT=http://localhost:8333
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=raditi
S3_SECRET_ACCESS_KEY=raditi-dev-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_INBOX=raditi-inbox
S3_BUCKET_SESSIONS=raditi-sessions
S3_BUCKET_LOGS=raditi-logs
S3_BUCKET_ARTIFACTS=raditi-artifacts
S3_BUCKET_BACKUPS=raditi-backups
S3_BUCKET_PLATFORM=raditi-platform

# Vault: локально OpenBao в dev-режиме; в проде сервисы входят по AppRole
VAULT_ADDR=http://localhost:8200
VAULT_DEV_ROOT_TOKEN=raditi-dev-root
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Gitea
GITEA_URL=http://localhost:3300
GITEA_TOKEN=
GITEA_WEBHOOK_SECRET=
GITEA_RUNNER_TOKEN=

# LiteLLM и провайдеры моделей — только российские
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-raditi-dev
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
CLOUDRU_API_KEY=
GIGACHAT_AUTH_KEY=

# Песочница агента: на Linux с gVisor — runsc, на macOS — runc
SANDBOX_RUNTIME=runc
SANDBOX_IMAGE_PREFIX=raditi/agent

# Вход
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Telegram (через egress-прокси)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PROXY_URL=

# ЮKassa — тестовый магазин
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Почта (SendSay) и распознавание голоса
SENDSAY_API_KEY=
SPEECHKIT_API_KEY=
