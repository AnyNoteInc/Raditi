    "YOOKASSA_SECRET_KEY",
    "YOOKASSA_SHOP_ID",
    "YOOKASSA_WEBHOOK_ALLOWLIST",
    "ZAI_API_KEY"
  ],
  "tasks": {
    "db:generate": {
      "dependsOn": ["^db:generate"],
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate", "transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate", "transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/apps/web/content/legal/public-offer.md",
        "$TURBO_ROOT$/infra/sandbox/gateway.mjs",
        "$TURBO_ROOT$/infra/sandbox/client-egress.mjs",
        "$TURBO_ROOT$/infra/wordpress/raditi-content.php",
        "$TURBO_ROOT$/infra/wordpress/raditi-preview.php",
        "$TURBO_ROOT$/infra/wordpress/preview-wp-config.php",
        "$TURBO_ROOT$/infra/wordpress/preview-apache.conf",
        "$TURBO_ROOT$/packages/site-connections/src/database-copy/wordpress-policy.fixture.json",
        "$TURBO_ROOT$/apps/runner/scripts/runner-token.mjs",
        "$TURBO_ROOT$/apps/runner/src/core-api/core-client.ts",
        "$TURBO_ROOT$/apps/runner/src/sandbox-runner/sandbox-runner.ts",
        "$TURBO_ROOT$/apps/runner/src/reconciler/runner-reconciler.ts",
        "$TURBO_ROOT$/infra/app/docker-compose.yml"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["NODE_EXTRA_CA_CERTS"]
    }
  },
  "globalPassThroughEnv": ["PATH"]
}
