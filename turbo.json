{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": [
    "APP_ENV",
    "APP_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BILLING_PAST_DUE_DAYS",
    "BILLING_RENEWAL_NOTICE_DAYS",
    "BILLING_TICK_SECONDS",
    "CI",
    "DATABASE_URL",
    "GITEA_PROVISIONER_TOKEN",
    "GITEA_RUNNER_TOKEN",
    "GITEA_TOKEN",
    "GITEA_URL",
    "GITEA_WEBHOOK_SECRET",
    "GIT_CA_FILE",
    "GRAFANA_ADMIN_PASSWORD",
    "LLM_BACKEND_URL_ZAI_CODING",
    "LLM_CONTROL_URL",
    "LLM_EGRESS_CA_FILE",
    "LLM_EGRESS_CLIENT_CERT_FILE",
    "LLM_EGRESS_CLIENT_KEY_FILE",
    "LLM_EGRESS_PROXY_URL",
    "LLM_GATEWAY_CLIENTS",
    "LLM_GATEWAY_HOSTS",
    "LLM_GATEWAY_LISTEN_HOST",
    "LLM_GATEWAY_PORT",
    "LLM_MAX_CALLS_PER_KEY",
    "LLM_MAX_CALLS_PER_KEY_30S",
    "LLM_MAX_REQUESTS_PER_KEY",
    "LLM_POOL_MIN_TURN_HEADROOM_PCT",
    "LLM_UPSTREAM_CA_FILE",
    "MCP_ALLOWED_HOSTS",
    "MCP_CONTENT_PROFILE",
    "MCP_PORT",
    "METRICS_TOKEN",
    "NODE_ENV",
    "ORCHESTRATOR_PORT",
    "ORCHESTRATOR_ROLES",
    "P2_GITLEAKS_BINARY",
    "P2_RUNNER_DOCKER_SOCKET",
    "P2_RUNNER_HOST",
    "P2_RUNNER_NODE_IMAGE",
    "P2_SANDBOX_IMAGE",
    "PUBLIC_DOMAIN",
    "RADITI_DOCKER_TEST_IMAGE",
    "RADITI_DOCKER_TEST_UPSTREAM_HOST",
    "RADITI_GATEWAY_DB_TESTS",
    "REDIS_URL",
    "RUNNER_API_PORT",
    "RUNNER_CORE_CA_FILE",
    "RUNNER_CORE_URL",
    "RUNNER_IMAGE",
    "RUNNER_MAX_TURNS",
    "RUNNER_S3_ORIGIN",
    "RUNNER_TOKENS",
    "RUNNER_TOKEN_FILE",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET_ARTIFACTS",
    "S3_BUCKET_BACKUPS",
    "S3_BUCKET_INBOX",
    "S3_BUCKET_LOGS",
    "S3_BUCKET_PLATFORM",
    "S3_BUCKET_SESSIONS",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "S3_REGION",
    "S3_RUNNER_ENDPOINT",
    "S3_SECRET_ACCESS_KEY",
    "SANDBOX_DOCKER_SOCKET",
    "SANDBOX_GATEWAY_IMAGE",
    "SANDBOX_IMAGE",
    "SANDBOX_LLM_UPSTREAM",
    "SANDBOX_MCP_UPSTREAM",
    "SANDBOX_NETWORK_GUARD_IMAGE",
    "SANDBOX_RUNTIME",
    "SANDBOX_WATCHDOG_IMAGE",
    "SENDSAY_API_KEY",
    "SITE_PORT",
    "SMARTCAPTCHA_CLIENT_KEY",
    "SMARTCAPTCHA_SERVER_KEY",
    "SPEECHKIT_API_KEY",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_PROXY_URL",
    "TELEGRAM_WEBHOOK_SECRET",
    "TURN_EXECUTOR",
    "VAULT_ADDR",
    "VAULT_DEV_ROOT_TOKEN",
    "VAULT_ROLE_ID",
    "VAULT_SECRET_ID",
    "YOOKASSA_API_URL",
    "YOOKASSA_AUTOPAYMENTS",
    "YOOKASSA_SECRET_KEY",
    "YOOKASSA_SHOP_ID",
    "YOOKASSA_WEBHOOK_ALLOWLIST",
    "ZAI_API_KEY"
  ],
  "tasks": {
    "db:generate": {
      "dependsOn": ["^db:generate"],
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate", "transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate", "transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/apps/web/content/legal/public-offer.md",
        "$TURBO_ROOT$/infra/sandbox/gateway.mjs"
      ]
    },
    "dev": {
      "dependsOn": ["^db:generate", "db:generate"],
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": ["PATH"]
}
