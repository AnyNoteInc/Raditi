{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": [
    "APP_ENV",
    "APP_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CI",
    "CLOUDRU_API_KEY",
    "DATABASE_URL",
    "GIGACHAT_AUTH_KEY",
    "GITEA_RUNNER_TOKEN",
    "GITEA_TOKEN",
    "GITEA_URL",
    "GITEA_WEBHOOK_SECRET",
    "GRAFANA_ADMIN_PASSWORD",
    "LITELLM_MASTER_KEY",
    "LITELLM_URL",
    "MCP_PORT",
    "METRICS_TOKEN",
    "NODE_ENV",
    "ORCHESTRATOR_PORT",
    "ORCHESTRATOR_ROLES",
    "P2_GITLEAKS_BINARY",
    "P2_SANDBOX_IMAGE",
    "PUBLIC_DOMAIN",
    "RADITI_DOCKER_TEST_IMAGE",
    "RADITI_DOCKER_TEST_UPSTREAM_HOST",
    "REDIS_URL",
    "RUNNER_API_PORT",
    "RUNNER_TOKENS",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET_ARTIFACTS",
    "S3_BUCKET_BACKUPS",
    "S3_BUCKET_INBOX",
    "S3_BUCKET_LOGS",
    "S3_BUCKET_PLATFORM",
    "S3_BUCKET_SESSIONS",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "S3_REGION",
    "S3_RUNNER_ENDPOINT",
    "S3_SECRET_ACCESS_KEY",
    "SANDBOX_DOCKER_SOCKET",
    "SANDBOX_GATEWAY_IMAGE",
    "SANDBOX_IMAGE_PREFIX",
    "SANDBOX_LLM_UPSTREAM",
    "SANDBOX_MCP_UPSTREAM",
    "SANDBOX_NETWORK_GUARD_IMAGE",
    "SANDBOX_RUNTIME",
    "SANDBOX_WATCHDOG_IMAGE",
    "SENDSAY_API_KEY",
    "SITE_PORT",
    "SMARTCAPTCHA_CLIENT_KEY",
    "SMARTCAPTCHA_SERVER_KEY",
    "SPEECHKIT_API_KEY",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_PROXY_URL",
    "TELEGRAM_WEBHOOK_SECRET",
    "TURN_EXECUTOR",
    "VAULT_ADDR",
    "VAULT_DEV_ROOT_TOKEN",
    "VAULT_ROLE_ID",
    "VAULT_SECRET_ID",
    "YANDEX_API_KEY",
    "YANDEX_FOLDER_ID",
    "YOOKASSA_SECRET_KEY",
    "YOOKASSA_SHOP_ID"
  ],
  "tasks": {
    "db:generate": {
      "dependsOn": ["^db:generate"],
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "dev": {
      "dependsOn": ["^db:generate", "db:generate"],
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": ["PATH"]
}
