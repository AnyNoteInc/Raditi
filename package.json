{
  "name": "raditi",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-architecture": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check-env": "node scripts/check-env.mjs",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:deploy": "pnpm --filter @repo/db db:deploy",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "e2e": "pnpm --filter e2e test:e2e",
    "gates": "pnpm format:check && pnpm check-env && pnpm typecheck && pnpm lint && pnpm check-architecture && pnpm test && pnpm test:sandbox-infra && pnpm build",
    "infra:up": "docker compose --env-file .env -f infra/dev/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/dev/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/dev/docker-compose.yml logs -f --tail=100",
    "prepare": "husky || true",
    "test:sandbox-infra": "node --test infra/sandbox/*.test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/git": "catalog:",
    "@semantic-release/github": "catalog:",
    "dependency-cruiser": "catalog:",
    "husky": "catalog:",
    "prettier": "catalog:",
    "semantic-release": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.10.0 <27",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.6.0",
      "onFail": "download"
    }
  }
}
