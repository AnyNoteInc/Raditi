{
  "name": "raditi",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-architecture": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check-env": "node scripts/check-env.mjs",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:deploy": "pnpm --filter @repo/db db:deploy",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "e2e": "pnpm --filter e2e test:e2e",
    "gates": "pnpm format:check && pnpm check-env && pnpm typecheck && pnpm lint && pnpm check-architecture && pnpm test && pnpm test:infra && pnpm build",
    "infra:up": "sh -c 'docker compose --env-file .env -f infra/dev/docker-compose.yml up -d \"$@\" && pnpm vault:bootstrap' --",
    "infra:down": "docker compose --env-file .env -f infra/dev/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/dev/docker-compose.yml logs -f --tail=100",
    "prepare": "husky || true",
    "test:infra": "node --test infra/*/*.test.mjs infra/dev/*/*.test.mjs",
    "vault:bootstrap": "docker compose --env-file .env -f infra/dev/docker-compose.yml exec -T vault printenv BAO_DEV_ROOT_TOKEN_ID | node infra/vault/bootstrap.mjs --address http://127.0.0.1:8200 --wait",
    "verify:vault": "node infra/vault/verify-local.mjs",
    "verify:site": "node infra/dev/site-verify/verify-site.mjs",
    "verify:site-connect": "pnpm --filter orchestrator build && exec node infra/dev/site-verify/verify-site-connect.mjs",
    "verify:mcp-content": "pnpm --filter orchestrator build && exec node infra/dev/site-verify/verify-content.mjs",
    "verify:agent-content": "exec node apps/orchestrator/scripts/verify-agent-content.mjs",
    "verify:billing": "exec node infra/dev/billing-verify/verify-billing.mjs",
    "verify:db": "node infra/dev/db-verify/verify-db.mjs",
    "verify:gitea": "pnpm --filter orchestrator build && exec node infra/dev/gitea-verify/verify-gitea.mjs",
    "verify:pipeline": "exec node infra/dev/pipeline-verify/verify-pipeline.mjs",
    "verify:preview-network": "exec node infra/dev/preview-verify/verify-preview-network.mjs",
    "verify:release": "exec node infra/dev/release-verify/verify-release.mjs",
    "verify:llm-gateway": "pnpm --filter orchestrator verify:llm-gateway",
    "verify:llm-app": "node infra/app/verify-llm-app.mjs",
    "verify:llm-firewall": "node infra/app/verify-llm-firewall.mjs",
    "verify:opencode": "exec node packages/agent-drivers/scripts/verify-opencode.mjs",
    "verify:opencode-supervisor": "pnpm --filter orchestrator build && exec node apps/orchestrator/scripts/verify-opencode-supervisor.mjs",
    "verify:edge": "node infra/app/verify-edge.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@semantic-release/github": "catalog:",
    "dependency-cruiser": "catalog:",
    "husky": "catalog:",
    "prettier": "catalog:",
    "semantic-release": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.10.0 <27",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.6.0",
      "onFail": "download"
    }
  }
}
