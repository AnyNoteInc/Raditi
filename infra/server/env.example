# /opt/raditi/app/.env of the single server (README.md; root:docker, 0640). Only non-secret values:
# secrets are files in /run/raditi/<service>/ rendered from the host's OpenBao. deploy.sh rewrites
# APP_REVISION and every *_IMAGE line of images.env on each release; the rest is set once here.
# No quotes and no trailing comments (preflight).
COMPOSE_FILE=docker-compose.yml:server/docker-compose.server.yml
COMPOSE_PROFILES=llm
APP_DOMAIN=raditi.ru
DASHBOARD_HOST=traefik.raditi.ru
EDGE_DASHBOARD=true
# The apex of the preview domain: a certificate and a redirect to the cabinet (no wildcard yet)
PREVIEW_APEX_HOST=raditi-preview.ru
PREVIEW_BASE_DOMAIN=raditi-preview.ru
BROWSER_PLATFORM_HOSTS=raditi.ru,raditi-preview.ru
# The private address of this server (raditi-net.service): Vault, S3, runner API, llm, mcp, browser
APP_PRIVATE_IP=10.10.0.10
VAULT_PRIVATE_IP=10.10.0.10
VAULT_ADDR=https://vault.raditi.internal:8200
RUNNER_API_PUBLISH=8083
LLM_GATEWAY_PUBLISH=8084
# Every client of llm reaches it through the hairpin of 10.10.0.10 and shows the llm-out gateway
LLM_GATEWAY_CLIENTS=172.29.84.1/32
LLM_OUT_SUBNET=172.29.84.0/24
LLM_OUT_GATEWAY=172.29.84.1
# The public address and the private network: client egress (agent, browser) never tunnels there
SANDBOX_EGRESS_REFUSED_SUBNETS=45.8.250.117/32,10.10.0.0/24
# The group of /var/run/docker.sock (getent group docker): the browser process drives sessions
DOCKER_GID=999
ACME_EMAIL=ops@raditi.ru
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
ACME_STORAGE_FILE=acme.json
ACME_CERT_HOURS=2160
EDGE_HTTP=80
EDGE_HTTPS=443
SECRETS_DIR=/run/raditi
VOLUME_PREFIX=raditi-app
BRIDGE_PREFIX=rd
# S3 settings of infra/app/docker-compose.yml; docker-compose.server.yml gives the services the
# internal SeaweedFS (https://s3.raditi.internal:8333, path-style)
S3_ENDPOINT=https://s3.raditi.internal:8333
S3_REGION=ru-msk
S3_FORCE_PATH_STYLE=true
S3_RUNNER_ENDPOINT=
# id:sha256@ip of the runner of this server (/etc/raditi/runner/runner-token, README.md): the address
# is the gateway of core-egress, which core sees for a connection from the host (docker-compose.server.yml)
RUNNER_TOKENS=
LEADS_TELEGRAM_CHAT_ID=
TELEGRAM_PROXY_URL=
EGRESS_PROXY_IP=
APP_REVISION=
# Upstream images by digest (Docker Hub and ghcr.io answer from this server)
TRAEFIK_IMAGE=ghcr.io/traefik/traefik:v3.7.13@sha256:f86a2cab1b5c649070c49f883c743dd32d8485a56e3368c5f93b9e91f1e91259
POSTGRES_IMAGE=docker.io/library/postgres:17.11-alpine3.24@sha256:3540c0362c809df084ffac0ae69fe794515f9de92692f02178bcdce0ef0302ac
REDIS_IMAGE=docker.io/library/redis:8.10.2-alpine@sha256:9f8d2d789b9a1d1e3f283f979aa9cbf393373806472e1ccd460e2f9c869b833b
SEAWEEDFS_IMAGE=docker.io/chrislusf/seaweedfs:4.47@sha256:ce9e796f1fe6f06968f4c04bdaf8f678dad9c8acdfef3d244133d71bfa6bf882
GITEA_IMAGE=docker.io/gitea/gitea:1.27.3-rootless@sha256:1c17ecaead42eb3b5391553d8708103a4beb0e86edf5b9ebc1eb269c318845f2
GITEA_RUNNER_IMAGE=docker.io/gitea/runner:4.0.0@sha256:7b5aa1137a262c2ca452a420c645629c95c5277920d2bdeb90757cb5ea24689f
# The platform's images: deploy.sh writes them from the release's images.env
WEB_IMAGE=
CORE_IMAGE=
MIGRATE_IMAGE=
LLM_IMAGE=
MCP_IMAGE=
PREVIEW_GATEWAY_IMAGE=
RUNNER_IMAGE=
BROWSER_WORKER_IMAGE=
SANDBOX_IMAGE=
SANDBOX_GATEWAY_IMAGE=
SANDBOX_NETWORK_GUARD_IMAGE=
SANDBOX_WATCHDOG_IMAGE=
BROWSER_EGRESS_IMAGE=
BROWSER_FORWARDER_IMAGE=
BROWSER_IMAGE=
