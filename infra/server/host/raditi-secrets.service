# /etc/systemd/system/raditi-secrets.service (infra/server/README.md): renders /run/raditi/<service>/
# from Vault before docker.service, so dockerd restarts the containers with their files present.
# A failed render does not stop Docker: preflight of raditi-app.service then fails and retries.
[Unit]
Description=Render the platform secrets from the host's OpenBao into /run/raditi
After=openbao-unseal.service raditi-net.service
Requires=openbao-unseal.service
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/node /usr/local/lib/raditi/platform-secrets.mjs render
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
