# /etc/systemd/system/raditi-egress.service: the model egress proxy on egress-1 (README.md).
# No Docker on the node: one Node process under its own system user that may bind 443 and
# nothing else. Only that user's group reads the TLS files (root:raditi-egress 0640).
[Unit]
Description=Raditi model egress proxy (infra/egress)
After=network-online.target nftables.service time-sync.target
Wants=network-online.target
Requires=nftables.service

[Service]
Type=simple
ExecStart=/opt/node/bin/node /opt/raditi/egress/llm-egress.mjs
EnvironmentFile=/etc/raditi/egress.env
Environment=EGRESS_TLS_DIR=/etc/raditi/egress
Restart=always
RestartSec=5s

User=raditi-egress
Group=raditi-egress
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
MemoryMax=512M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
