# /etc/raditi/egress.env on egress-1 (README.md, «Установка»). Nothing secret here: the TLS
# files live in /etc/raditi/egress, readable by the service's group only.

# Exact host:port pairs a CONNECT may reach. auth.kimi.ai:443 only if Kimi OAuth is ever used.
LLM_EGRESS_ALLOW=chatgpt.com:443,auth.openai.com:443,api.kimi.ai:443

# CNs of client certificates of the client CA: app-1 for the app VM, op-1 for the owner's P3
# check only (remove it after P3).
EGRESS_CLIENT_CN_ALLOW=app-1,op-1

# The largest /probe answer in bytes; 1 MiB at most.
EGRESS_PROBE_MAX_BYTES=1048576

# Where the proxy listens; the defaults are 0.0.0.0 and 443.
# EGRESS_LISTEN_HOST=0.0.0.0
# EGRESS_LISTEN_PORT=443
