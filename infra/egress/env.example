# /etc/raditi/egress.env on egress-1 (README.md, «Установка»). Nothing secret here: the TLS
# files live in /etc/raditi/egress, readable by the service's group only.

# Exact host:port pairs a CONNECT may reach: the hosts of the adapters the platform has, and a
# new host only together with the code that needs it.
# api.z.ai: the llm role reaches Z.ai without this node (owner's decision of 05.10.2026), but a
# role with a proxy configured sends every provider through it, so the host is let through.
LLM_EGRESS_ALLOW=api.z.ai:443

# CNs of client certificates of the client CA: app-1 for the app VM, op-1 for the owner's manual
# channel check only (README, section 5; remove it after the check).
EGRESS_CLIENT_CN_ALLOW=app-1,op-1

# SHA-256 pins of the admitted client certificates, as make-ca.sh prints them (sha256=...). A
# certificate passes only with its CN above and its pin here; removing a pin revokes that
# certificate at once (renewal, a stolen key). The proxy does not start with these placeholders.
EGRESS_CLIENT_SHA256=<APP_1_SHA256>,<OP_1_SHA256>

# The largest /probe answer in bytes; 1 MiB at most.
EGRESS_PROBE_MAX_BYTES=1048576

# Where the proxy listens; the defaults are 0.0.0.0 and 443.
# EGRESS_LISTEN_HOST=0.0.0.0
# EGRESS_LISTEN_PORT=443
