# /run/raditi/core/app.env (uid 10002, 0400): core reads it with node --env-file. Values come from
# Vault kv/platform/app/core; the non-secret settings are in docker-compose.yml.
# Values in double quotes: unquoted, node --env-file cuts a value at `#`. Role passwords only
# [A-Za-z0-9_-]: they go into the URLs unencoded.
# With the llm profile METRICS_TOKEN equals llm's and differs from web's (preflight).
# Next to this file: vault-ca.pem (uid 10002, 0400), the public CA of vault.raditi.internal.
DATABASE_URL="postgresql://raditi:<из Vault: общий пароль PostgreSQL raditi>@postgres:5432/raditi"
REDIS_URL="redis://:<общий пароль Redis из Vault>@redis:6379"
S3_ACCESS_KEY_ID="<из Vault: сервисный аккаунт core>"
S3_SECRET_ACCESS_KEY="<из Vault>"
VAULT_ROLE_ID="<из Vault: AppRole core>"
VAULT_SECRET_ID="<выпускает vault-agent>"
METRICS_TOKEN="<из Vault: общий с llm, не равен токену web>"
SENDSAY_API_KEY="<из Vault>"
# The bot of the leads of the landing (docs/plan/65-landing-platforms-leads.md); empty — leads wait.
LEADS_TELEGRAM_BOT_TOKEN="<из Vault>"
# The private VAPID key of Web Push (docs/plan/75-chat-input-output.md, ВВ8); the public one is in
# the .env of the VM. Empty with an empty public key — no notifications in browsers.
WEB_PUSH_PRIVATE_KEY="<из Vault>"
# The secret of the intake of web for the runs of scheduled tasks (docs/plan/82-scheduled-tasks.md,
# Зп19): the same value as in web/app.env; the route is SCHEDULE_INTAKE_URL in docker-compose.yml.
SCHEDULE_INTAKE_SECRET="<из Vault: общий с web>"
# The repositories of projects (docs/plan/84-projects.md, §4.2): the OAuth app of Радити on
# gitlab.com — both or neither, renews the tokens — and the HMAC of the cards, the same as in
# web/app.env. The GitHub App (Э10) — both or neither, the PEM by its path.
GITLAB_OAUTH_CLIENT_ID="<из Vault: kv/platform/app/core>"
GITLAB_OAUTH_CLIENT_SECRET="<из Vault: kv/platform/app/core>"
REPO_CONFIRM_SECRET="<из Vault: общий с web, от 32 знаков>"
# GITHUB_APP_ID="<из Vault>"
# GITHUB_APP_PRIVATE_KEY_FILE="/run/raditi/github-app.pem"
