# /run/raditi/core/app.env (uid 10002, 0400): core reads it with node --env-file. Values come from
# Vault kv/platform/app/core; the non-secret settings are in docker-compose.yml.
# Values in double quotes: unquoted, node --env-file cuts a value at `#`. Role passwords only
# [A-Za-z0-9_-]: they go into the URLs unencoded.
# With the llm profile METRICS_TOKEN equals llm's and differs from web's (preflight).
# Next to this file: vault-ca.pem (uid 10002, 0400), the public CA of vault.raditi.internal.
DATABASE_URL="postgresql://raditi:<из Vault: общий пароль PostgreSQL raditi>@postgres:5432/raditi"
REDIS_URL="redis://:<общий пароль Redis из Vault>@redis:6379"
S3_ACCESS_KEY_ID="<из Vault: сервисный аккаунт core>"
S3_SECRET_ACCESS_KEY="<из Vault>"
VAULT_ROLE_ID="<из Vault: AppRole core>"
VAULT_SECRET_ID="<выпускает vault-agent>"
METRICS_TOKEN="<из Vault: общий с llm, не равен токену web>"
SENDSAY_API_KEY="<из Vault>"
