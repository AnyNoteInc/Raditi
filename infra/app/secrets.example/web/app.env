# /run/raditi/web/app.env (uid 10001, 0400): web reads it with node --env-file. Values come from
# Vault kv/platform/app/web; the non-secret settings are in docker-compose.yml.
# Values in double quotes: unquoted, node --env-file cuts a value at `#`. Role passwords only
# [A-Za-z0-9_-]: they go into the URLs unencoded.
# METRICS_TOKEN is web's own: preflight refuses the token core and llm share (it opens the
# private control endpoint of the subscription gateway).
# Next to this file: vault-ca.pem (uid 10001, 0400), the public CA of vault.raditi.internal.
DATABASE_URL="postgresql://raditi:<из Vault: общий пароль PostgreSQL raditi>@postgres:5432/raditi"
REDIS_URL="redis://:<общий пароль Redis из Vault>@redis:6379"
BETTER_AUTH_SECRET="<из Vault>"
SMARTCAPTCHA_CLIENT_KEY="<из Vault>"
SMARTCAPTCHA_SERVER_KEY="<из Vault>"
# Sign-in with Yandex ID: the app of oauth.yandex.ru, both or neither; empty — no such button.
YANDEX_CLIENT_ID="<из Vault>"
YANDEX_CLIENT_SECRET="<из Vault>"
# Dictation in the field of a chat (docs/plan/75-chat-input-output.md, ВВ18): the API key of a
# service account with the role ai.speechkit-stt.user. Empty — no microphone in the field.
YANDEX_SPEECHKIT_API_KEY="<из Vault>"
S3_ACCESS_KEY_ID="<из Vault: сервисный аккаунт web>"
S3_SECRET_ACCESS_KEY="<из Vault>"
VAULT_ROLE_ID="<из Vault: AppRole web>"
VAULT_SECRET_ID="<выпускает vault-agent>"
METRICS_TOKEN="<из Vault: собственный токен web>"
# The secret core posts the runs of scheduled tasks with (docs/plan/82-scheduled-tasks.md, Зп19):
# the same value as in core/app.env.
SCHEDULE_INTAKE_SECRET="<из Vault: общий с core>"
# The repositories of projects (docs/plan/84-projects.md, §4.2): the OAuth app of Радити on
# gitlab.com — both or neither, the sign-in — and the HMAC of the cards, the same as in
# core/app.env. The GitHub App (Э10) — all four or none.
GITLAB_OAUTH_CLIENT_ID="<из Vault: kv/platform/app/web>"
GITLAB_OAUTH_CLIENT_SECRET="<из Vault: kv/platform/app/web>"
REPO_CONFIRM_SECRET="<из Vault: общий с core, от 32 знаков>"
# GITHUB_APP_SLUG="<из Vault>"
# GITHUB_APP_CLIENT_ID="<из Vault>"
# GITHUB_APP_CLIENT_SECRET="<из Vault>"
# GITHUB_APP_WEBHOOK_SECRET="<из Vault>"
