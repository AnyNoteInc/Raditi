# /run/raditi/web/app.env (uid 10001, 0400): web reads it with node --env-file. Values come from
# Vault kv/platform/app/web; the non-secret settings are in docker-compose.yml.
# Values in double quotes: unquoted, node --env-file cuts a value at `#`. Role passwords only
# [A-Za-z0-9_-]: they go into the URLs unencoded.
# METRICS_TOKEN is web's own: preflight refuses the token core and llm share (it opens the
# private control endpoint of the subscription gateway).
# Next to this file: vault-ca.pem (uid 10001, 0400), the public CA of vault.raditi.internal.
DATABASE_URL="postgresql://raditi:<из Vault: общий пароль PostgreSQL raditi>@postgres:5432/raditi"
REDIS_URL="redis://:<общий пароль Redis из Vault>@redis:6379"
BETTER_AUTH_SECRET="<из Vault>"
SMARTCAPTCHA_CLIENT_KEY="<из Vault>"
SMARTCAPTCHA_SERVER_KEY="<из Vault>"
S3_ACCESS_KEY_ID="<из Vault: сервисный аккаунт web>"
S3_SECRET_ACCESS_KEY="<из Vault>"
VAULT_ROLE_ID="<из Vault: AppRole web>"
VAULT_SECRET_ID="<выпускает vault-agent>"
METRICS_TOKEN="<из Vault: собственный токен web>"
