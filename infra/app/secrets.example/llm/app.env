# /run/raditi/llm/app.env (uid 10008, 0400): node --env-file reads only these four values.
# The dedicated llm AppRole uses llm-subscriptions; never reuse core's AppRole or SecretID.
# METRICS_TOKEN matches core's token for the private pool-control endpoint.
# Passwords use [A-Za-z0-9_-] so the shared PostgreSQL password needs no URL encoding.
DATABASE_URL="postgresql://raditi:<из Vault: общий пароль PostgreSQL raditi>@postgres:5432/raditi"
VAULT_ROLE_ID="<из Vault: AppRole llm>"
VAULT_SECRET_ID="<выпускает vault-agent для llm>"
METRICS_TOKEN="<общий с core токен из Vault>"
