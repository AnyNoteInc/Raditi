# /run/raditi/preview/app.env (uid 10009, 0400): the gateway of previews reads it with node --env-file.
# Values come from Vault kv/platform/app/preview; the non-secret settings are in
# docker-compose.preview.yml. Values in double quotes; the role password only [A-Za-z0-9_-].
DATABASE_URL="postgresql://raditi:<из Vault: общий пароль PostgreSQL raditi>@postgres:5432/raditi"
PREVIEW_SESSION_SECRET="<из Vault: подпись cookie шлюза, не короче 32 байт (openssl rand -base64 48)>"
