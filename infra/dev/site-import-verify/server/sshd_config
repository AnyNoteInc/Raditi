# sshd of the stand's hosting: SFTP only, for `site`, `siteb` and `sitec`, chrooted to their home.
Port 22
ListenAddress 0.0.0.0
# The stand copies the chosen host key here; use-host-key.sh swaps it and restarts sshd.
HostKey /stand/run/ssh_host_key
PidFile /stand/run/sshd.pid
LogLevel VERBOSE
UseDNS no
# Every client arrives from the Docker gateway: OpenSSH 10's penalties for connections that only
# exchange keys (the wizard's first check does exactly that) would lock every one of them out.
PerSourcePenalties no
PermitRootLogin no
AllowUsers site siteb sitec
PasswordAuthentication yes
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no
# Root-owned, outside the chroot, readable by sshd only through StrictModes' checks.
AuthorizedKeysFile /stand/run/authorized_keys/%u
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PermitTTY no
Subsystem sftp internal-sftp
ChrootDirectory /home/site
ForceCommand internal-sftp
