{
  "uid": "raditi-overview",
  "title": "Радити — обзор",
  "tags": ["raditi"],
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Обязательные сервисы",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "up{compose_profile=\"\"}", "legendFormat": "{{job}}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "НЕТ", "color": "red", "index": 0 },
                "1": { "text": "ОК", "color": "green", "index": 1 }
              }
            }
          ]
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Обязательные проверки доступности",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "probe_success{compose_profile=\"\"}", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "НЕТ", "color": "red", "index": 0 },
                "1": { "text": "ОК", "color": "green", "index": 1 }
              }
            }
          ]
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Задачи по статусам",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (raditi_tasks)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PostgreSQL: соединения",
      "gridPos": { "x": 0, "y": 14, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (datname) (pg_stat_activity_count)", "legendFormat": "{{datname}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Redis: память",
      "gridPos": { "x": 6, "y": 14, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "refId": "A", "expr": "redis_memory_used_bytes", "legendFormat": "used" }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "S3: запросы в секунду",
      "gridPos": { "x": 12, "y": 14, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (type) (rate(SeaweedFS_s3_request_total[5m]))", "legendFormat": "{{type}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Node.js: задержка event loop p99, с",
      "gridPos": { "x": 18, "y": 14, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "nodejs_eventloop_lag_p99_seconds", "legendFormat": "{{app}}" }]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Шлюз подписок: запросы в секунду",
      "description": "Все запросы, отказы шлюза и завершённые вызовы. Рядов нет — роль llm не запущена или цель llm недоступна.",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(raditi_llm_requests_total[5m]))", "legendFormat": "запросы" },
        { "refId": "B", "expr": "sum(rate(raditi_llm_refusals_total[5m]))", "legendFormat": "отказы" },
        { "refId": "C", "expr": "sum(rate(raditi_llm_completed_total[5m]))", "legendFormat": "завершено" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Шлюз подписок: активные запросы и учёт расхода",
      "description": "Оценочный расход, повторы и ошибки записи, usage после закрытия потока — приросты за 5 минут.",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(raditi_llm_active_requests)", "legendFormat": "активные" },
        { "refId": "B", "expr": "sum(increase(raditi_llm_estimated_total[5m]))", "legendFormat": "оценочный расход" },
        { "refId": "C", "expr": "sum(increase(raditi_llm_persistence_retries_total[5m]))", "legendFormat": "повторы записи" },
        { "refId": "D", "expr": "sum(increase(raditi_llm_persistence_failed_total[5m]))", "legendFormat": "ошибки записи" },
        { "refId": "E", "expr": "sum(increase(raditi_llm_usage_late_total[5m]))", "legendFormat": "поздний usage" }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Дополнительные профили: метрики",
      "description": "Выключенные профили имеют значение НЕТ. При включении профиля проверьте значение ОК. Алерты доступности для этих целей выключены.",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "up{compose_profile!=\"\",job!=\"blackbox-http\"}",
          "legendFormat": "{{job}} ({{compose_profile}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "НЕТ", "color": "gray", "index": 0 },
                "1": { "text": "ОК", "color": "green", "index": 1 }
              }
            }
          ]
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Дополнительные профили: доступность",
      "description": "Выключенные профили имеют значение НЕТ. При включении профиля проверьте значение ОК. Алерты доступности для этих целей выключены.",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{compose_profile!=\"\"}",
          "legendFormat": "{{instance}} ({{compose_profile}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "НЕТ", "color": "gray", "index": 0 },
                "1": { "text": "ОК", "color": "green", "index": 1 }
              }
            }
          ]
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
