{
  "engine": "mysql",
  "copyUnlistedRows": true,
  "tables": [
    {
      "table": "options",
      "where": [
        {
          "op": "notLike",
          "column": "option_name",
          "patterns": ["raditi\\_content\\_call\\_%"]
        }
      ]
    }
  ],
  "overrides": [
    {
      "table": "options",
      "match": {
        "column": "option_name",
        "value": "raditi_content_site_id"
      },
      "set": {
        "option_value": "0196abcd-0000-7000-8000-00000000000a"
      }
    },
    {
      "table": "options",
      "match": {
        "column": "option_name",
        "value": "raditi_content_epoch"
      },
      "set": {
        "option_value": "0"
      }
    },
    {
      "table": "options",
      "match": {
        "column": "option_name",
        "value": "blog_public"
      },
      "set": {
        "option_value": "0"
      }
    },
    {
      "table": "options",
      "match": {
        "column": "option_name",
        "value": "admin_email"
      },
      "set": {
        "option_value": "admin@preview.invalid"
      }
    }
  ]
}
