}

/// The working copy of one dialog (Р2): the full tree of its candidate, its own database copy and
/// PHP. Never a deploy target. The gateway of the `preview` role finds the upstream by the exact
/// `hostname`; nothing a client or the agent sends names an upstream.
model PreviewEnvironment {
  id                String        @id @default(uuid(7)) @db.Uuid
  siteId            String        @map("site_id") @db.Uuid
  taskId            String        @unique @map("task_id") @db.Uuid
  status            PreviewStatus @default(pending)
  dbMode            PreviewDbMode @default(none) @map("db_mode")
  /// Set exactly while `unavailable` (no_database, no_core, …).
  unavailableReason String?       @map("unavailable_reason") @db.VarChar(32)
  /// previewHostname() in @repo/domain.
  hostname          String        @unique @db.VarChar(253)
  /// The candidate the preview was built to; NULL — the base of the dialog.
  candidateId       String?       @map("candidate_id") @db.Uuid
  filesSha          String?       @map("files_sha") @db.Char(40)
  revision          Int           @default(0)
  /// A browser action that may write happened since the build (Р22).
  dirty             Boolean       @default(false)
  /// Handles of containers and networks of the runtime; never a secret.
  runtime           Json?
  upstreamHost      String?       @map("upstream_host") @db.VarChar(253)
  upstreamPort      Int?          @map("upstream_port")
  /// Bumped to end every session (a revoked membership, a reset).
  accessEpoch       Int           @default(0) @map("access_epoch")
  /// Fence of content writes into the preview (Р24): a reset or a rebuild bumps it.
  writeEpoch        Int           @default(0) @map("write_epoch")
  /// raditi-artifacts previews/<siteId>/<previewId>/seed.sql.zst.enc and its SHA-256.
  seedObjectKey     String?       @map("seed_object_key") @db.VarChar(1024)
  seedSha256        String?       @map("seed_sha256") @db.Char(64)
  /// sites.installed_release_id when the seed was taken: a release ending later makes it stale.
  seedReleaseId     String?       @map("seed_release_id") @db.Uuid
  leaseEpoch        Int           @default(0) @map("lease_epoch")
  heartbeatAt       DateTime?     @map("heartbeat_at") @db.Timestamptz(6)
  attempt           Int           @default(1)
  enqueues          Int           @default(1)
  /// Set exactly while `failed`.
  errorCode         String?       @map("error_code") @db.VarChar(48)
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(6)
  lastViewedAt      DateTime?     @map("last_viewed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  site            Site                    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  task            Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  candidate       TaskCandidate?          @relation("PreviewCandidate", fields: [candidateId], references: [id], onDelete: SetNull)
  seedRelease     SiteRelease?            @relation("PreviewSeedRelease", fields: [seedReleaseId], references: [id], onDelete: SetNull)
  tickets         PreviewTicket[]
  sessions        PreviewSession[]
  syncRequests    PreviewSyncRequest[]
  browserRequests PreviewBrowserRequest[]
  dbOperations    PreviewDbOperation[]
  mcpCalls        McpCall[]
  snapshots       Snapshot[]
  seedMismatches  PreviewSeedMismatch[]

  @@index([siteId])
  @@index([candidateId])
  @@index([seedReleaseId])
  @@index([status, expiresAt])
  @@map("preview_environments")
}

/// An object whose state in the preview after the seed differs from production (Р15, Р24):
/// core writes it with the seed, the mcp role refuses to change it.
model PreviewSeedMismatch {
  previewId String   @map("preview_id") @db.Uuid
  /// <type>:<id>, the notation of preview_db_operations.object_ref.
  objectRef String   @map("object_ref") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  preview PreviewEnvironment @relation(fields: [previewId], references: [id], onDelete: Cascade)

  @@id([previewId, objectRef])
  @@map("preview_seed_mismatches")
}

/// A one-time way in (Р19): 60 seconds, one session. Only the SHA-256 of the token is kept.
model PreviewTicket {
  id        String    @id @default(uuid(7)) @db.Uuid
  previewId String    @map("preview_id") @db.Uuid
  /// NULL — the service ticket of the agent's browser (kind browser).
  userId    String?   @map("user_id") @db.Uuid
  /// user | browser (previewSessionKinds).
  kind      String    @db.VarChar(16)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  preview PreviewEnvironment @relation(fields: [previewId], references: [id], onDelete: Cascade)
  user    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([previewId])
  @@index([userId])
  @@index([expiresAt])
  @@map("preview_tickets")
}

/// A session of the gateway cookie; ends with the access epoch of its preview.
model PreviewSession {
  id          String    @id @default(uuid(7)) @db.Uuid
  previewId   String    @map("preview_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  kind        String    @db.VarChar(16)
  accessEpoch Int       @map("access_epoch")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Membership and the site status were checked again (at least every 60 s).
  checkedAt   DateTime? @map("checked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  preview PreviewEnvironment @relation(fields: [previewId], references: [id], onDelete: Cascade)
  user    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([previewId])
  @@index([userId])
  @@index([expiresAt])
  @@map("preview_sessions")
}

/// The agent's tools ask core to lay the sandbox tree onto the preview (Р23).
model PreviewSyncRequest {
  id           String    @id @default(uuid(7)) @db.Uuid
  previewId    String    @map("preview_id") @db.Uuid
  assignmentId String?   @map("assignment_id") @db.Uuid
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  filesDigest  String?   @map("files_digest") @db.Char(64)
  errorCode    String?   @map("error_code") @db.VarChar(48)

  preview    PreviewEnvironment @relation(fields: [previewId], references: [id], onDelete: Cascade)
  assignment TurnAssignment?    @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([previewId])
  @@index([assignmentId])
  @@map("preview_sync_requests")
}

/// The agent's tools ask core for a browser on the preview (Р21).
model PreviewBrowserRequest {
  id           String    @id @default(uuid(7)) @db.Uuid
  previewId    String    @map("preview_id") @db.Uuid
  assignmentId String?   @map("assignment_id") @db.Uuid
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  readyAt      DateTime? @map("ready_at") @db.Timestamptz(6)
  stoppedAt    DateTime? @map("stopped_at") @db.Timestamptz(6)
  errorCode    String?   @map("error_code") @db.VarChar(48)

  preview    PreviewEnvironment @relation(fields: [previewId], references: [id], onDelete: Cascade)
  assignment TurnAssignment?    @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([previewId])
  @@index([assignmentId])
  @@map("preview_browser_requests")
}

/// A content write into a preview as an operation of the candidate's plan (Р3); the values are
/// encrypted objects in raditi-artifacts. `excluded` — written by a turn that did not complete.
/// A row is a whole operation: `dbPlanEntryFromJournal` (@repo/domain) reads it back.
model PreviewDbOperation {
  id              BigInt          @id @default(autoincrement())
  taskId          String          @map("task_id") @db.Uuid
  previewId       String          @map("preview_id") @db.Uuid
  turnNo          Int             @map("turn_no")
  mcpCallId       String          @map("mcp_call_id") @db.Uuid
  kind            DbOperationKind
  objectRef       String          @map("object_ref") @db.VarChar(128)
  /// The fields written, each once, in the order of orderDbContentFields (CHECK
  /// preview_db_operations_fields_check).
  fields          String[]
  beforeHash      String          @map("before_hash") @db.Char(64)
  afterHash       String          @map("after_hash") @db.Char(64)
  /// Each side: the key, the SHA-256 and the size of the encrypted object (dbValueRefSchema).
  afterObjectKey  String          @map("after_object_key") @db.VarChar(1024)
  afterSha256     String          @map("after_sha256") @db.Char(64)
  afterBytes      Int             @map("after_bytes")
  beforeObjectKey String          @map("before_object_key") @db.VarChar(1024)
  beforeSha256    String          @map("before_sha256") @db.Char(64)
  beforeBytes     Int             @map("before_bytes")
  excluded        Boolean         @default(false)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  task    Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  preview PreviewEnvironment @relation(fields: [previewId], references: [id], onDelete: Cascade)
  mcpCall McpCall            @relation(fields: [mcpCallId], references: [id], onDelete: Restrict)

  @@unique([taskId, mcpCallId])
  @@index([previewId, id])
  @@index([mcpCallId])
  @@map("preview_db_operations")
}

/// What a pass that changed something left (Р5): the base, the commit of its files, media, the
/// compacted database plan, the proposed version. One `current` per dialog.
model TaskCandidate {
  id              String          @id @default(uuid(7)) @db.Uuid
  taskId          String          @map("task_id") @db.Uuid
  revision        Int
  turnNo          Int             @map("turn_no")
  status          CandidateStatus @default(current)
  /// The commit of `main` the candidate stands on, its tree and its version.
  baseSha         String          @map("base_sha") @db.Char(40)
  baseTree        String          @map("base_tree") @db.Char(40)
  baseVersion     String?         @map("base_version") @db.VarChar(32)
  /// The commit of the files on agent/<taskId>.
  headSha         String          @map("head_sha") @db.Char(40)
  /// candidateFilesSchema, candidateMediaSchema, dbPlanSchema, candidateFactsSchema.
  files           Json            @default("[]")
  media           Json            @default("[]")
  dbPlan          Json            @default("[]") @map("db_plan")
  dbPlanSha256    String          @map("db_plan_sha256") @db.Char(64)
  proposedBump    VersionBump     @map("proposed_bump")
  proposedVersion String          @map("proposed_version") @db.VarChar(32)
  facts           Json
  previewRevision Int?            @map("preview_revision")
  /// dbPlanViewSchema: the plan with its values for the client; null — empty plan, or recorded
  /// before descriptions, or superseded (CHECK task_candidates_db_view_check).
  dbView          Json?           @map("db_view")
  dbViewSha256    String?         @map("db_view_sha256") @db.Char(64)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  supersededAt    DateTime?       @map("superseded_at") @db.Timestamptz(6)

  task     Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checks   CandidateCheck[]
  previews PreviewEnvironment[] @relation("PreviewCandidate")
  releases SiteRelease[]        @relation("ReleaseCandidate")

  @@unique([taskId, revision])
  @@unique([taskId], map: "task_candidates_current_key", where: raw("status = 'current'::\"CandidateStatus\""))
  @@map("task_candidates")
}

/// A check of a candidate at a revision of its preview.
model CandidateCheck {
  id          String               @id @default(uuid(7)) @db.Uuid
  candidateId String               @map("candidate_id") @db.Uuid
  revision    Int
  /// php_lint | preview_smoke | agent_browser (candidateCheckKinds).
  kind        String               @db.VarChar(32)
  status      CandidateCheckStatus @default(pending)
  /// Counts and codes only.
  summary     Json?
  artifactKey String?              @map("artifact_key") @db.VarChar(1024)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt  DateTime?            @map("finished_at") @db.Timestamptz(6)

  candidate TaskCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, kind])
  @@map("candidate_checks")
}

/// A release of a candidate (Р25–Р33): the deterministic commit on `main`, its tag and the one
/// deploy of it. `release_key` makes a repeated confirmation land on the same row.
model SiteRelease {
  id                   String        @id @default(uuid(7)) @db.Uuid
  siteId               String        @map("site_id") @db.Uuid
  taskId               String        @map("task_id") @db.Uuid
  /// `release` — of a candidate; `undo` — «Отменить выпуск» of the release `undoesReleaseId`, in
  /// its dialog, with the plan the client confirmed (CHECK site_releases_kind_check).
  kind                 ReleaseKind   @default(release)
  /// NULL only for an undo.
  candidateId          String?       @map("candidate_id") @db.Uuid
  candidateRevision    Int?          @map("candidate_revision")
  undoesReleaseId      String?       @map("undoes_release_id") @db.Uuid
  undoPlanId           String?       @map("undo_plan_id") @db.Uuid
  undoPlanSha256       String?       @map("undo_plan_sha256") @db.Char(64)
  /// The n-th release of this candidate.
  attempt              Int
  releaseKey           String        @unique @map("release_key") @db.Char(64)
  /// Burnt when the release fails: never reused, the tag stays.
  version              String        @db.VarChar(32)
  tag                  String        @db.VarChar(32)
  bump                 VersionBump
  mainBeforeSha        String        @map("main_before_sha") @db.Char(40)
  installedBeforeSha   String?       @map("installed_before_sha") @db.Char(40)
  /// The release commit; known from `published` on.
  approvedSha          String?       @map("approved_sha") @db.Char(40)
  /// Trusted time of the release commit: a retry builds the same SHA.
  committedAt          DateTime      @map("committed_at") @db.Timestamptz(6)
  status               ReleaseStatus @default(approved)
  /// The step of the deploy job's last report (releaseSteps, `reverify` the check after a rollback).
  step                 String?       @db.VarChar(32)
  approvedBy           String?       @map("approved_by") @db.Uuid
  approvedAt           DateTime      @map("approved_at") @db.Timestamptz(6)
  deploymentId         String?       @unique @map("deployment_id") @db.Uuid
  deployAttempt        Int           @default(0) @map("deploy_attempt")
  /// SHA-256 of the release API token of the current deploy attempt.
  deployTokenHash      String?       @map("deploy_token_hash") @db.Char(64)
  deployTokenExpiresAt DateTime?     @map("deploy_token_expires_at") @db.Timestamptz(6)
  /// Accessor of the wrapping token in the repository secret: revoked when the job is silent.
  wrapAccessor         String?       @map("wrap_accessor") @db.VarChar(128)
  accessIssuedAt       DateTime?     @map("access_issued_at") @db.Timestamptz(6)
  backupObjectKey      String?       @map("backup_object_key") @db.VarChar(1024)
  backupSha256         String?       @map("backup_sha256") @db.Char(64)
  backupBytes          BigInt?       @map("backup_bytes")
  backupVerifiedAt     DateTime?     @map("backup_verified_at") @db.Timestamptz(6)
  /// The release commit reached `main` (the CAS push answered, or ls-remote after a lost
  /// answer): a `failed` release without it is `refused` (releaseOutcomeOf) and gets no revert.
  /// Set from `published` on (CHECK site_releases_main_pushed_check).
  mainPushedAt         DateTime?     @map("main_pushed_at") @db.Timestamptz(6)
  /// The revert commit that put `main` back to the installed tree (Р27).
  revertSha            String?       @map("revert_sha") @db.Char(40)
  leaseEpoch           Int           @default(0) @map("lease_epoch")
  /// Raised with every enqueue of `release.advance`, in its transaction: the `seq` of the job.
  enqueues             Int           @default(1)
  errorCode            String?       @map("error_code") @db.VarChar(48)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  site           Site                 @relation("SiteReleases", fields: [siteId], references: [id], onDelete: Restrict)
  task           Task                 @relation(fields: [taskId], references: [id], onDelete: Restrict)
  candidate      TaskCandidate?       @relation("ReleaseCandidate", fields: [candidateId], references: [id], onDelete: Restrict)
  undoes         SiteRelease?         @relation("ReleaseUndoes", fields: [undoesReleaseId], references: [id], onDelete: Restrict)
  undoneBy       SiteRelease[]        @relation("ReleaseUndoes")
  undoPlan       ReleaseUndoPlan?     @relation("ReleaseUndoPlan", fields: [undoPlanId], references: [id], onDelete: Restrict)
  undoPlans      ReleaseUndoPlan[]    @relation("UndoPlanRelease")
  approver       User?                @relation(fields: [approvedBy], references: [id], onDelete: SetNull)
  deployment     Deployment?          @relation("ReleaseCurrentDeployment", fields: [deploymentId], references: [id], onDelete: SetNull)
  deploymentOf   Deployment?          @relation("DeploymentRelease")
  installedOn    Site[]               @relation("SiteInstalledRelease")
  leaseBarrier   SiteLease?           @relation("ReleaseLeaseBarrier")
  seededPreviews PreviewEnvironment[] @relation("PreviewSeedRelease")
  steps          ReleaseStep[]

  @@unique([siteId, version])
  @@unique([candidateId, attempt])
  @@unique([candidateId], map: "site_releases_candidate_open_key", where: raw("status <> ALL (ARRAY['failed'::\"ReleaseStatus\", 'rolled_back'::\"ReleaseStatus\", 'installed'::\"ReleaseStatus\"])"))
  @@unique([undoesReleaseId, attempt])
  @@unique([undoesReleaseId], map: "site_releases_undo_open_key", where: raw("kind = 'undo' AND status <> ALL (ARRAY['failed'::\"ReleaseStatus\", 'rolled_back'::\"ReleaseStatus\", 'installed'::\"ReleaseStatus\"])"))
  @@index([undoPlanId])
  @@index([siteId, createdAt(sort: Desc)])
  @@index([taskId])
  @@index([approvedBy])
  @@index([status, updatedAt])
  @@map("site_releases")
}

/// What «Отменить выпуск» of a release would do (plan 53, «Отмена выпуска»), as core read it from
/// git and production: the files, the verdict of each object of the release's plan, and the
/// writes of the undo. References, hashes and fields only; values never are here.
model ReleaseUndoPlan {
  id            String         @id @default(uuid(7)) @db.Uuid
  siteId        String         @map("site_id") @db.Uuid
  /// The release the plan would undo.
  releaseId     String         @map("release_id") @db.Uuid
  requestedBy   String?        @map("requested_by") @db.Uuid
  status        UndoPlanStatus @default(pending)
  /// `sites.installed_sha` the plan was made against: the commit of the release.
  installedSha  String         @map("installed_sha") @db.Char(40)
  /// The tree of the undo commit: the version before the release and the media it added.
  targetTree    String?        @map("target_tree") @db.Char(40)
  /// undoFilesSummarySchema.
  files         Json           @default("{}")
  /// undoPlanItemSchema[].
  items         Json           @default("[]")
  /// dbUndoPlanSchema: the writes of the undo.
  dbPlan        Json           @default("[]") @map("db_plan")
  nothingToUndo Boolean        @default(false) @map("nothing_to_undo")
  planSha256    String?        @map("plan_sha256") @db.Char(64)
  errorCode     String?        @map("error_code") @db.VarChar(48)
  /// Raised with every enqueue of `release.undoPlan`, in its transaction: the `seq` of the job.
  enqueues      Int            @default(1)
  computedAt    DateTime?      @map("computed_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  site      Site          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  release   SiteRelease   @relation("UndoPlanRelease", fields: [releaseId], references: [id], onDelete: Cascade)
  requester User?         @relation(fields: [requestedBy], references: [id], onDelete: SetNull)
  undoes    SiteRelease[] @relation("ReleaseUndoPlan")

  @@index([releaseId, createdAt(sort: Desc)])
  @@index([siteId])
  @@index([requestedBy])
  @@index([status, updatedAt])
  @@map("release_undo_plans")
}

/// A report of a step of the deploy job; a repeated report is the same row (report_key).
model ReleaseStep {
  id            BigInt   @id @default(autoincrement())
  releaseId     String   @map("release_id") @db.Uuid
  deployAttempt Int      @map("deploy_attempt")
  step          String   @db.VarChar(32)
  /// started | succeeded | failed | unknown (releaseStepStates).
  state         String   @db.VarChar(16)
  reportKey     String   @map("report_key") @db.VarChar(128)
  detail        Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  release SiteRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, reportKey])
  @@map("release_steps")
}

/// A variable of the client's site (Р13): the name and the hosts it may reach. The value is in
/// Vault kv/sites/<siteId>/env/<NAME> only.
model SiteEnvVar {
  id             String    @id @default(uuid(7)) @db.Uuid
  siteId         String    @map("site_id") @db.Uuid
  name           String    @db.VarChar(64)
  /// `host:port` strings, at most sixteen (egressHostListSchema).
  hosts          Json      @default("[]")
  /// Off by default; on only with a recorded consent (CHECK site_env_vars_agent_check).
  toAgent        Boolean   @default(false) @map("to_agent")
  toPreview      Boolean   @default(true) @map("to_preview")
  agentConsentAt DateTime? @map("agent_consent_at") @db.Timestamptz(6)
  agentConsentBy String?   @map("agent_consent_by") @db.Uuid
  /// KV v2 version the platform last wrote.
  keyVersion     Int       @default(1) @map("key_version")
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  site           Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  agentConsenter User? @relation("SiteEnvVarConsent", fields: [agentConsentBy], references: [id], onDelete: SetNull)
  creator        User? @relation("SiteEnvVarCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([siteId, name])
  @@index([agentConsentBy])
  @@index([createdBy])
  @@map("site_env_vars")
}

/// The skills of the site's agent (owner's request of 26.10.2026): MCP servers its CLI connects to
/// besides the platform's own, over the open internet of a turn. The platform's own skills
/// (`builtinAgentSkillNames` of @repo/domain) are on without a row; a row of one of them turns it
/// on or off and has no address. A row of any other name is a skill the owner added: an https
/// address of a remote MCP server (`parseAgentSkillUrl`), nothing secret. CHECKs:
/// site_agent_skills_name_check, site_agent_skills_url_check.
model SiteAgentSkill {
  siteId    String   @map("site_id") @db.Uuid
  name      String   @db.VarChar(32)
  url       String?  @db.VarChar(512)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, name])
  @@map("site_agent_skills")
}

// ─── The cloud browser of a task (docs/plan/57-browser-tasks.md) ──────────────────────────────

/// Must equal browserSessionStatuses in @repo/domain (checked by a test).
enum BrowserSessionStatus {
  starting
  ready
  closed
  failed
  lost
}

/// Must equal browserControllers in @repo/domain (checked by a test).
enum BrowserController {
  agent
  user
}

/// Must equal browserCheckpointStates in @repo/domain (checked by a test).
enum BrowserCheckpointState {
  seen
  unverified
  verified
  missing
}

/// The cloud browser of a task as its worker holds it (Б10–Б18): one per task while it holds a
/// browser (`starting`, `ready`), across the turns of the task and its waits for the client. The
/// sign-in lives only in the browser (Б19): nothing here is a secret.
model BrowserSession {
  id              String               @id @default(uuid(7)) @db.Uuid
  taskId          String               @map("task_id") @db.Uuid
  siteId          String               @map("site_id") @db.Uuid
  workspaceId     String               @map("workspace_id") @db.Uuid
  status          BrowserSessionStatus @default(starting)
  /// Who drives it now; every hand-over moves control_epoch on (Б15).
  controller      BrowserController    @default(agent)
  controlEpoch    Int                  @default(0) @map("control_epoch")
  viewportVersion Int                  @default(1) @map("viewport_version")
  /// What the agent asked the client to do (`web_help`): one of browserHelpReasons and its words,
  /// together or neither (CHECK browser_sessions_help_check).
  helpReason      String?              @map("help_reason") @db.VarChar(16)
  helpMessage     String?              @map("help_message") @db.VarChar(500)
  /// The first click, input or upload in it, the agent's or the client's (Б28): the site may
  /// have changed.
  wroteAt         DateTime?            @map("wrote_at") @db.Timestamptz(6)
  lastActivityAt  DateTime             @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  /// Its hard deadline, whatever happens in it (BROWSER_SESSION_MAX_HOURS).
  expiresAt       DateTime             @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  readyAt         DateTime?            @map("ready_at") @db.Timestamptz(6)
  /// Set exactly when it holds no browser any more, with one of browserCloseReasons.
  closedAt        DateTime?            @map("closed_at") @db.Timestamptz(6)
  closeReason     String?              @map("close_reason") @db.VarChar(32)
  errorCode       String?              @map("error_code") @db.VarChar(48)

  task        Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  site        Site                  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  tickets     BrowserStreamTicket[]
  checkpoints BrowserCheckpoint[]

  @@unique([taskId], map: "browser_sessions_open_task_key", where: raw("status = ANY (ARRAY['starting'::\"BrowserSessionStatus\", 'ready'::\"BrowserSessionStatus\"])"))
  @@index([taskId])
  @@index([siteId])
  @@index([workspaceId])
  @@index([status, expiresAt])
  @@map("browser_sessions")
}

/// A one-time way into the stream of a session (Б12): 60 seconds, one connection, sent as the
/// first message. Only the SHA-256 of the ticket is kept.
model BrowserStreamTicket {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session BrowserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([expiresAt])
  @@map("browser_stream_tickets")
}

/// An object the task opened in the editor of the site (Б22): seen, saved and not yet confirmed
/// (`unverified`), confirmed by a trusted read (`verified`, with what it found) or not found.
model BrowserCheckpoint {
  id        String                 @id @default(uuid(7)) @db.Uuid
  taskId    String                 @map("task_id") @db.Uuid
  /// The session that last saw it.
  sessionId String                 @map("session_id") @db.Uuid
  /// browserCheckpointKinds and browserObjectIdSchema (CHECK browser_checkpoints_object_check).
  kind      String                 @db.VarChar(16)
  objectId  String                 @map("object_id") @db.VarChar(64)
  editUrl   String                 @map("edit_url") @db.VarChar(2048)
  state     BrowserCheckpointState @default(seen)
  /// browserVerifiedObjectSchema; set exactly while `verified`.
  verified  Json?
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  task    Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  session BrowserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([taskId, kind, objectId])
  @@index([sessionId])
  @@map("browser_checkpoints")
}
