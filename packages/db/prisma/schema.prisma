// Радити — data model v1 (spec §16).
// Conventions: uuid v7 ids, snake_case tables and columns via @@map/@map, timestamptz(6),
// enum values in lowercase snake_case, money as Decimal with an explicit precision (spec §16:
// never float, never integer kopecks). CHECK constraints Prisma cannot express are appended to
// the migration that creates their table; Prisma ignores them when diffing, so later migrations
// keep them.
// onDelete: Restrict for money, usage and history rows; Cascade only for rows that live and die
// with their parent (membership, channel identities, a task's turns, events and files);
// SetNull for "who did it" and "latest" pointers.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  // Unfinished turn assignments and active gateway rows use partial indexes.
  previewFeatures     = ["partialIndexes"]
  // .ts imports inside the generated client: plain Node loads it with type stripping
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (better-auth 1.7.6 core tables) ─────────────────────────────────────
// Field names are what better-auth writes; its schema check compares them with this model.

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String   @db.VarChar(255)
  lastName      String?  @map("last_name") @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?  @db.VarChar(1024)
  /// «Агент запоминает важное» (docs/plan/84-projects.md, ПР18): off — no tools and no section.
  agentMemory   Boolean  @default(true) @map("agent_memory")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions                Session[]
  accounts                Account[]
  consents                UserConsent[]
  memberships             Member[]
  channelIdentities       ChannelIdentity[]
  telegramLinkCodes       TelegramLinkCode[]
  workspacesCreated       Workspace[]
  tasksCreated            Task[]
  attachments             Attachment[]
  orders                  Order[]
  browserTickets          BrowserStreamTicket[]
  workspaceEnvVarsCreated WorkspaceEnvVar[]     @relation("WorkspaceEnvVarCreator")
  notificationSetting     NotificationSetting?
  pushSubscriptions       PushSubscription[]
  taskPresence            TaskPresence[]
  chatNotifications       ChatNotification[]
  speechCalls             SpeechCall[]
  agentInstructions       AgentInstructions?
  projectsCreated         Project[]             @relation("ProjectCreator")
  projectFilesUploaded    ProjectFile[]         @relation("ProjectFileUploader")
  gitConnections          GitConnection[]       @relation("GitConnectionCreator")
  repoActions             RepoAction[]          @relation("RepoActionCreator")
  memoryEntries           MemoryEntry[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(1024)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  /// "credential" for email and password, otherwise the OAuth provider id.
  providerId            String    @map("provider_id") @db.VarChar(255)
  accountId             String    @map("account_id") @db.VarChar(255)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?   @db.Text
  /// Password hash; set only for providerId = "credential".
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

/// better-auth rate limiter with rateLimit.storage = "database" (no Redis for auth).
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique @db.VarChar(255)
  count       Int
  /// Unix time in milliseconds.
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// ─── Consents (152-FZ) ────────────────────────────────────────────────────────

/// Immutable append-only log: every consent action inserts a row, nothing is updated.
/// Current state per (userId, documentType) is the row with the latest createdAt.
model UserConsent {
  id              String              @id @default(uuid(7)) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  documentType    ConsentDocumentType @map("document_type")
  granted         Boolean
  documentVersion String              @map("document_version") @db.VarChar(80)
  source          ConsentSource
  ipAddress       String?             @map("ip_address") @db.VarChar(45)
  userAgent       String?             @map("user_agent") @db.VarChar(1024)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, documentType, createdAt(sort: Desc)])
  @@map("user_consents")
}

/// Must equal consentDocumentTypes in @repo/domain (checked by a test).
enum ConsentDocumentType {
  user_agreement
  privacy_policy
  pii_processing
  public_offer
  marketing
}

enum ConsentSource {
  sign_up
  onboarding
  settings
}

// ─── Workspaces and people ────────────────────────────────────────────────────

/// The client is a company, not a single person: sites, tasks and money belong to a workspace.
model Workspace {
  id          String             @id @default(uuid(7)) @db.Uuid
  name        String             @db.VarChar(255)
  /// Synthetic workspaces are explicit; real data requires a provider clearance.
  dataClass   WorkspaceDataClass @default(client) @map("data_class")
  createdById String?            @map("created_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy          User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members            Member[]
  credentialRefs     CredentialRef[]
  chatSessions       ChatSession[]
  tasks              Task[]
  subscriptions      Subscription[]
  billingAccounts    BillingAccount[]
  orders             Order[]
  attachments        Attachment[]
  browserSessions    BrowserSession[]
  webSearchCalls     WebSearchCall[]
  pages              Page[]
  pageTrees          PageTree[]
  chatDocuments      ChatDocument[]
  usageWindows       WorkspaceUsageWindow[]
  envVars            WorkspaceEnvVar[]
  agentSkills        WorkspaceAgentSkill[]
  projects           Project[]
  projectFiles       ProjectFile[]
  memoryEntries      MemoryEntry[]
  memoryReservations MemoryReservation[]
  gitConnections     GitConnection[]
  projectRepos       ProjectRepository[]
  repoReservations   RepoReservation[]

  @@index([createdById])
  @@map("workspaces")
}

enum WorkspaceDataClass {
  synthetic
  client
}

/// Workspace membership. One owner per workspace is kept by the service layer.
model Member {
  id          String     @id @default(uuid(7)) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  role        MemberRole @default(member)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("members")
}

enum MemberRole {
  owner
  admin
  member
}

/// A user's account in a chat channel; Telegram is linked by signing in to the cabinet (spec §18).
model ChannelIdentity {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  channel       Channel
  /// User id in the channel (Telegram or MAX user id as a string).
  externalId    String   @map("external_id") @db.VarChar(64)
  /// Display handle, e.g. the Telegram @username; informational only.
  username      String?  @db.VarChar(255)
  /// The chat words without a topic go to (docs/plan/80-telegram.md, Т4); NULL — a new one.
  currentTaskId String?  @map("current_task_id") @db.Uuid
  /// `/new` was pressed: the next words start a new chat.
  newChat       Boolean  @default(false) @map("new_chat")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentTask Task? @relation("ChannelCurrentTask", fields: [currentTaskId], references: [id], onDelete: SetNull)

  @@unique([channel, externalId])
  /// One account of a channel per user.
  @@unique([userId, channel])
  @@index([userId])
  @@index([currentTaskId])
  @@map("channel_identities")
}

/// A one-time code of the link `t.me/<bot>?start=<code>` (docs/plan/80-telegram.md, Т3): made in
/// the cabinet, taken by `/start <code>` within 15 minutes. Only the sha256 of the code is kept.
model TelegramLinkCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("telegram_link_codes")
}

/// An update of the bot of the chat taken by web (docs/plan/80-telegram.md, §7): a repeat of the
/// same `update_id` does nothing twice, and core reads the next offset from the largest one. Ids
/// and the time only, nothing of what the update says.
model TelegramUpdate {
  updateId   BigInt   @id @map("update_id")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([receivedAt])
  @@map("telegram_updates")
}

enum Channel {
  web
  telegram
  max
}

// ─── Leases (spec §7) ─────────────────────────────────────────────────────────

/// The lease of a chat (spec §7): at most one turn of a chat at a time. One row per chat for its
/// whole life; the name of the table and of its key stays from the leases of sites, which went
/// with projects (docs/plan/83-remove-projects.md, БП6): site_id is the id of the chat
/// (`leaseScopeOf`). Acquire is a conditional UPDATE that sets the holder and bumps epoch when the
/// lease is free or expired; every write by a holder checks its epoch, which fences a stale owner.
/// held_for_operator: the outcome of a turn's command is unknown.
model SiteLease {
  siteId          String          @id @map("site_id") @db.Uuid
  operation       LeaseOperation?
  holderTaskId    String?         @map("holder_task_id") @db.Uuid
  epoch           Int             @default(0)
  acquiredAt      DateTime?       @map("acquired_at") @db.Timestamptz(6)
  expiresAt       DateTime?       @map("expires_at") @db.Timestamptz(6)
  /// The outcome of a turn's command is not known: an expired lease is not taken over until an
  /// operator decides.
  heldForOperator Boolean         @default(false) @map("held_for_operator")
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  holderTask Task? @relation(fields: [holderTaskId], references: [id], onDelete: Restrict)

  @@index([holderTaskId])
  @@map("site_leases")
}

enum LeaseOperation {
  turn
}

/// A pointer to a secret in Vault, never the secret itself (CLAUDE.md, rule 2; spec §15).
/// Provider keys: kv/llm/<provider>; subscriptions: kv/subscriptions/<accountId>. Platform-wide
/// refs have no workspace. The kinds of site access went with projects (plan 83).
model CredentialRef {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String?        @map("workspace_id") @db.Uuid
  kind        CredentialKind
  vaultPath   String         @unique @map("vault_path") @db.VarChar(512)
  /// KV v2 version the platform last wrote; bumps on rotation.
  keyVersion  Int            @default(1) @map("key_version")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace           Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  llmProviders        LlmProvider[]
  subscriptionAccount SubscriptionAccount?
  gitConnection       GitConnection?

  @@index([workspaceId])
  @@map("credential_refs")
}

enum CredentialKind {
  llm_provider
  subscription
  mcp_server
  /// The tokens of a git connection, kv/workspaces/<ws>/git/<connectionId> (plan 84, §4.2).
  git_connection
}

/// Must equal agentSkillAuthKinds in @repo/domain.
enum AgentSkillAuthKind {
  none
  header
  oauth
}

/// Must equal agentSkillAuthStates in @repo/domain.
enum AgentSkillAuthState {
  ok
  needs_login
  failed
}

// ─── Chat and tasks (spec §7, §8, §11) ────────────────────────────────────────

/// A conversation thread in one channel: the web chat, a Telegram chat or topic, a MAX
/// chat. Holds the agent driver choice and a pointer to the latest turn for resuming.
model ChatSession {
  id                    String   @id @default(uuid(7)) @db.Uuid
  workspaceId           String   @map("workspace_id") @db.Uuid
  channel               Channel
  /// Chat id in the channel (Telegram or MAX chat id as a string); NULL for the web chat.
  externalChatId        String?  @map("external_chat_id") @db.VarChar(64)
  /// Telegram forum topic (message_thread_id).
  telegramTopicId       Int?     @map("telegram_topic_id")
  /// The message of the work of the agent in Telegram while a pass goes on (docs/plan/80-telegram.md);
  /// `telegramProgressChain` — the run that edits it: a newer run takes over, an older one stops.
  telegramProgressId    Int?     @map("telegram_progress_id")
  telegramProgressChain String?  @map("telegram_progress_chain") @db.Uuid
  agentDriverId         String?  @map("agent_driver_id") @db.VarChar(32)
  lastTurnId            String?  @map("last_turn_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  agentDriver AgentDriver? @relation(fields: [agentDriverId], references: [id], onDelete: Restrict)
  lastTurn    TaskTurn?    @relation(fields: [lastTurnId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([workspaceId])
  @@index([channel, externalChatId, telegramTopicId])
  @@index([agentDriverId])
  @@index([lastTurnId])
  @@map("chat_sessions")
}

/// One client request: one logical agent session and one task branch (spec §7). The status
/// changes only by a conditional UPDATE in the same transaction as its credit_ledger entry.
/// A project of a workspace (docs/plan/84-projects.md, ПР1): its chats, instructions and, in later
/// slices, its context, memory and repository. Its id is a UUID of version 7 from the browser
/// (CHECK projects_id_check); only its author sees and changes it. «Удалить» puts it into the trash
/// for 30 days (ПР20): `deleted_at` and `purge_after` go together (CHECK projects_trash_check).
model Project {
  id               String    @id @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  createdById      String    @map("created_by_id") @db.Uuid
  /// One line, 1–80 characters after trimming (CHECK projects_name_check).
  name             String    @db.VarChar(80)
  goal             String?   @db.VarChar(500)
  /// Up to 8000 characters (CHECK projects_instructions_check), from slice 84.7.
  instructions     String?
  useAccountMemory Boolean   @default(true) @map("use_account_memory")
  starredAt        DateTime? @map("starred_at") @db.Timestamptz(6)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  purgeAfter       DateTime? @map("purge_after") @db.Timestamptz(6)
  /// «Недавние»: a new chat, the end of a pass, a change of the project.
  activityAt       DateTime  @default(now()) @map("activity_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy  User               @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks      Task[]
  files      ProjectFile[]
  memory     MemoryEntry[]
  repository ProjectRepository?

  @@index([workspaceId, createdById, activityAt(sort: Desc)], map: "projects_owner_activity_idx", where: raw("deleted_at IS NULL"))
  @@index([purgeAfter], map: "projects_purge_idx", where: raw("deleted_at IS NOT NULL"))
  @@map("projects")
}

/// A file or a text of the context of a project (docs/plan/84-projects.md, ПР8), in raditi-inbox
/// under projects/<workspaceId>/<id> (projectFileKey in @repo/domain; CHECK project_files_key_check).
/// Announced without a project and with a day to be taken (`expires_at`), `ready` once web checked
/// the stored object, then bound to a project (CHECK project_files_bound_ready_check), which keeps
/// it while it lives; core collects a file nobody took.
model ProjectFile {
  id           String    @id @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  projectId    String?   @map("project_id") @db.Uuid
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  /// `file` — uploaded; `text` — «Добавить текстовое содержимое», kept as `.md` (CHECK).
  kind         String    @db.VarChar(8)
  /// The path in /workspace/project (projectFilePath; CHECK project_files_name_check).
  name         String    @db.VarChar(255)
  mediaType    String    @map("media_type") @db.VarChar(127)
  /// 1 byte to 20 MiB (CHECK project_files_size_check).
  sizeBytes    Int       @map("size_bytes")
  /// Of the stored bytes, once web checked them.
  sha256       String?   @db.Char(64)
  /// `uploading` or `ready` (projectFileStatuses; CHECK project_files_status_check).
  status       String    @default("uploading") @db.VarChar(10)
  s3Key        String    @map("s3_key") @db.VarChar(200)
  /// A file without a project: until when it may be taken (now() + 24 h).
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation("ProjectFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([projectId, name])
  @@index([workspaceId])
  @@index([expiresAt], map: "project_files_unbound_idx", where: raw("project_id IS NULL"))
  @@map("project_files")
}

/// A note of memory (docs/plan/84-projects.md, ПР18, §4.1): of a project, or — project_id NULL —
/// of the account of its user in the workspace. Only `active` goes to the agent; `proposed` waits
/// for «Сохранить». A proposal of the agent over an active entry is `pending_action` with, for an
/// update, its `pending_text`: the entry keeps its text until the client saves the new one.
model MemoryEntry {
  id            String    @id @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  /// Whose note it is: the author of the chat it came from, or the client who wrote it.
  userId        String    @map("user_id") @db.Uuid
  projectId     String?   @map("project_id") @db.Uuid
  /// preference, fact, decision, reference (memoryKinds; CHECK memory_entries_kind_check).
  kind          String    @db.VarChar(12)
  /// 1 to 400 characters after trimming (CHECK memory_entries_text_check).
  text          String    @db.VarChar(400)
  /// active or proposed (CHECK memory_entries_status_check).
  status        String    @db.VarChar(10)
  /// agent or client (CHECK memory_entries_author_check).
  author        String    @db.VarChar(8)
  sourceTaskId  String?   @map("source_task_id") @db.Uuid
  sourceTurn    Int?      @map("source_turn")
  /// Grows with every change: a change at another version is refused (MEMORY_VERSION_CHANGED).
  version       Int       @default(1)
  /// When the client saved it: the agent changes such an entry only by a proposal.
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(6)
  /// update or forget — a proposal of the agent over an active entry (CHECK).
  pendingAction String?   @map("pending_action") @db.VarChar(8)
  pendingText   String?   @map("pending_text") @db.VarChar(400)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTask   Task?               @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)
  reservations MemoryReservation[]

  @@index([userId, projectId, status])
  @@index([workspaceId])
  @@index([projectId])
  @@index([sourceTaskId])
  @@map("memory_entries")
}

/// A change of memory the agent reserved in a turn (as page_reservations): `core` applies it when
/// the pass completed, or closes it refused or failed (docs/plan/84-projects.md, §4.3).
model MemoryReservation {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  turnNo      Int       @map("turn_no")
  /// save, update or forget (CHECK memory_reservations_kind_check).
  kind        String    @db.VarChar(8)
  entryId     String?   @map("entry_id") @db.Uuid
  /// memoryReservationPayloadSchema: the arguments and the memory they were asked in.
  payload     Json
  /// done, refused or failed (CHECK); NULL — open.
  outcome     String?   @db.VarChar(8)
  reason      String?   @db.VarChar(24)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  entry     MemoryEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([taskId, turnNo], map: "memory_reservations_open_idx", where: raw("outcome IS NULL"))
  @@index([createdAt], map: "memory_reservations_stale_idx", where: raw("outcome IS NULL"))
  @@index([workspaceId])
  @@index([entryId])
  @@map("memory_reservations")
}

/// A GitHub or GitLab connection of a user in a workspace (docs/plan/84-projects.md, ПР10): it acts
/// in the name of the one who connected it, so only `created_by_id` sees, binds and uses it, while
/// a member of the workspace. Kinds and states — gitConnectionKinds and gitConnectionStates of
/// @repo/domain (CHECKs git_connections_kind_check, git_connections_state_check). A GitHub App
/// connection holds no token (its installation token is issued per operation); the others name
/// their `credential_refs` row of kind `git_connection` (CHECK git_connections_credential_check).
/// At most 10 per workspace — kept by the service layer.
model GitConnection {
  id              String    @id @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  createdById     String    @map("created_by_id") @db.Uuid
  kind            String    @db.VarChar(16)
  /// `github.com`, `gitlab.com` or the name of the client's GitLab server; https on 443.
  host            String    @db.VarChar(253)
  accountLogin    String    @map("account_login") @db.VarChar(100)
  /// The owner of the GitHub installation or the GitLab user.
  accountId       String    @map("account_id") @db.VarChar(40)
  installationId  BigInt?   @map("installation_id")
  /// github_app: who connected it; their rights are checked before every action (ПР10).
  githubUserId    String?   @map("github_user_id") @db.VarChar(40)
  credentialRefId String?   @unique @map("credential_ref_id") @db.Uuid
  state           String    @default("checking") @db.VarChar(16)
  stateReason     String?   @map("state_reason") @db.VarChar(40)
  checkedAt       DateTime? @map("checked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy           User                      @relation("GitConnectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  credentialRef       CredentialRef?            @relation(fields: [credentialRefId], references: [id], onDelete: Restrict)
  repositories        GitConnectionRepository[]
  projectRepositories ProjectRepository[]

  @@unique([workspaceId, createdById, kind, host, accountId])
  @@index([createdById])
  @@map("git_connections")
}

/// The repositories of a connection core sees, for the choice (P-git-repo-pick); of a github_app
/// connection only those where the user who connected it has `permissions.push` (ПР10).
model GitConnectionRepository {
  connectionId   String    @map("connection_id") @db.Uuid
  providerRepoId String    @map("provider_repo_id") @db.VarChar(40)
  path           String    @db.VarChar(300)
  name           String    @db.VarChar(200)
  /// public, internal or private (CHECK git_connection_repositories_visibility_check).
  visibility     String    @db.VarChar(10)
  defaultBranch  String    @map("default_branch") @db.VarChar(255)
  /// Up to 100 names of branches, by git.repo.inspect (CHECK).
  branches       Json?
  canPush        Boolean   @map("can_push")
  canHook        Boolean   @map("can_hook")
  pushedAt       DateTime? @map("pushed_at") @db.Timestamptz(6)
  syncedAt       DateTime  @map("synced_at") @db.Timestamptz(6)

  connection GitConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([connectionId, providerRepoId])
  @@map("git_connection_repositories")
}

/// The repository of a project (ПР9), one: by a public link (no connection, read only) or by a
/// connection (read and write). Provider, mode and mirror state — repoProviderKinds, repoModes and
/// repoMirrorStates of @repo/domain (CHECKs).
model ProjectRepository {
  id             String    @id @db.Uuid
  projectId      String    @unique @map("project_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  /// NULL — a public link (CHECK project_repositories_connection_mode_check: then `read`).
  connectionId   String?   @map("connection_id") @db.Uuid
  provider       String    @db.VarChar(8)
  host           String    @db.VarChar(253)
  providerRepoId String?   @map("provider_repo_id") @db.VarChar(40)
  path           String    @db.VarChar(300)
  /// Only `https://<host>/…` (CHECK project_repositories_web_url_check).
  webUrl         String    @map("web_url") @db.VarChar(500)
  defaultBranch  String    @map("default_branch") @db.VarChar(255)
  mode           String    @db.VarChar(5)
  mirrorState    String    @default("syncing") @map("mirror_state") @db.VarChar(12)
  lastFetchedSha String?   @map("last_fetched_sha") @db.Char(40)
  fetchedAt      DateTime? @map("fetched_at") @db.Timestamptz(6)
  /// [{ path, rule }] without values (ПР12); these files never go into a bundle (ПР35).
  secretsFound   Json?     @map("secrets_found")
  /// ci_config_path and the files of `include: local` of the default branch (ПР16).
  ciPaths        Json?     @map("ci_paths")
  /// When `git.poll` last read its builds and merge requests (claimed by CAS, slice 84.21).
  ciPolledAt     DateTime? @map("ci_polled_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection GitConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  branches      ProjectRepoBranch[]
  mergeRequests ProjectMergeRequest[]
  actions       RepoAction[]
  ciRuns        ProjectCiRun[]
  ciLogs        ProjectCiLog[]
  deployActions ProjectDeployAction[]

  @@index([workspaceId])
  @@index([connectionId])
  @@map("project_repositories")
}

/// The branch of the agent of one chat in the repository of its project (docs/plan/84-projects.md,
/// ПР13): written by the first card «Изменения в ветке», sent to the client only by a button. A
/// chat's own branch is found by `task_id`, never by the name. State — repoBranchStates (CHECK).
model ProjectRepoBranch {
  taskId              String   @id @map("task_id") @db.Uuid
  projectRepositoryId String   @map("project_repository_id") @db.Uuid
  /// raditi/<word>-<last 8 of the chat id>[-n] (CHECK project_repo_branches_branch_check).
  branch              String   @db.VarChar(255)
  /// The head of the main branch the chat's first change was based on.
  baseSha             String   @map("base_sha") @db.Char(40)
  /// The head of the chat in the mirror whose changes the branch at the client holds; NULL — not sent.
  mirrorSha           String?  @map("mirror_sha") @db.Char(40)
  /// The head of the branch at the client after the last push; NULL — not sent.
  remoteSha           String?  @map("remote_sha") @db.Char(40)
  /// { files, additions, deletions, list ≤ 50 } of the last card.
  diffstat            Json?
  ciDiffSha256        String?  @map("ci_diff_sha256") @db.Char(64)
  ciConfirmedSha256   String?  @map("ci_confirmed_sha256") @db.Char(64)
  ciLint              Json?    @map("ci_lint")
  state               String   @default("local") @db.VarChar(8)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  task       Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repository ProjectRepository @relation(fields: [projectRepositoryId], references: [id], onDelete: Cascade)

  @@unique([projectRepositoryId, branch])
  @@map("project_repo_branches")
}

/// The merge requests of a repository the platform opened or reads (ПР14): a cache — core reads
/// the truth at the provider. State and checks — pullRequestStates and checksStates (CHECKs).
model ProjectMergeRequest {
  id                  String   @id @db.Uuid
  projectRepositoryId String   @map("project_repository_id") @db.Uuid
  taskId              String?  @map("task_id") @db.Uuid
  /// The number of a pull request or the iid of a merge request.
  number              Int
  sourceBranch        String   @map("source_branch") @db.VarChar(255)
  targetBranch        String   @map("target_branch") @db.VarChar(255)
  title               String   @db.VarChar(255)
  state               String   @db.VarChar(8)
  headSha             String   @map("head_sha") @db.Char(40)
  mergeSha            String?  @map("merge_sha") @db.Char(40)
  checks              String   @default("none") @db.VarChar(8)
  autoMerge           Boolean  @default(false) @map("auto_merge")
  webUrl              String   @map("web_url") @db.VarChar(500)
  syncedAt            DateTime @map("synced_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  repository ProjectRepository @relation(fields: [projectRepositoryId], references: [id], onDelete: Cascade)
  task       Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([projectRepositoryId, number])
  @@index([taskId])
  @@map("project_merge_requests")
}

/// What the agent proposes of the repository in a turn (ПР14): `repo_request_merge` reserves, core
/// shows it at the end of the pass as `feed.repo_proposal`. Kind — request_merge (CHECK).
model RepoReservation {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  turnNo      Int       @map("turn_no")
  kind        String    @db.VarChar(16)
  /// repoProposalPayloadSchema: { title, description, draft }.
  payload     Json
  /// done, refused or failed (CHECK); NULL — open.
  outcome     String?   @db.VarChar(8)
  reason      String?   @db.VarChar(24)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, turnNo], map: "repo_reservations_open_idx", where: raw("outcome IS NULL"))
  @@index([workspaceId])
  @@map("repo_reservations")
}

/// What the client pressed, and only that (ПР13, ПР15): every row holds the token of its card, and
/// core checks its HMAC again before it calls the provider — a row inserted without a press does not
/// run. Kind — repoActionKinds, state — repoActionStates (CHECKs).
model RepoAction {
  id                  String    @id @db.Uuid
  projectRepositoryId String    @map("project_repository_id") @db.Uuid
  taskId              String?   @map("task_id") @db.Uuid
  /// The one who pressed.
  createdById         String    @map("created_by_id") @db.Uuid
  kind                String    @db.VarChar(10)
  /// repoActionArgsSchema: the token of the card and what the client wrote on it.
  args                Json
  /// One press, one row (ПР13, ПР15).
  tokenSha256         String    @unique @map("token_sha256") @db.Char(64)
  state               String    @default("queued") @db.VarChar(8)
  error               String?   @db.VarChar(40)
  result              Json?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt          DateTime? @map("finished_at") @db.Timestamptz(6)

  repository ProjectRepository @relation(fields: [projectRepositoryId], references: [id], onDelete: Cascade)
  task       Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy  User              @relation("RepoActionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectRepositoryId, createdAt])
  @@index([taskId])
  @@map("repo_actions")
}

/// The builds of a project repository as `git.poll` of core read them (docs/plan/84-projects.md,
/// ПР17, §4.1; slice 84.21): a cache of the newest REPO_CI_RUNS_KEPT, the truth is the provider's.
model ProjectCiRun {
  projectRepositoryId String    @map("project_repository_id") @db.Uuid
  providerRunId       String    @map("provider_run_id") @db.VarChar(40)
  ref                 String    @db.VarChar(255)
  sha                 String    @db.Char(40)
  name                String    @db.VarChar(200)
  event               String?   @db.VarChar(40)
  /// ciStatuses of @repo/domain (CHECK).
  status              String    @db.VarChar(8)
  /// ciRefusals: `account_unverified` — gitlab.com did not start it (ПР17).
  refusal             String?   @db.VarChar(24)
  webUrl              String    @map("web_url") @db.VarChar(500)
  /// repoCiJobsSchema: up to 100 jobs; null — not read yet.
  jobs                Json?
  createdAt           DateTime  @map("created_at") @db.Timestamptz(6)
  startedAt           DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt          DateTime? @map("finished_at") @db.Timestamptz(6)
  syncedAt            DateTime  @map("synced_at") @db.Timestamptz(6)

  repository ProjectRepository @relation(fields: [projectRepositoryId], references: [id], onDelete: Cascade)

  @@id([projectRepositoryId, providerRunId])
  @@index([projectRepositoryId, createdAt(sort: Desc)], map: "project_ci_runs_newest_idx")
  @@map("project_ci_runs")
}

/// The tail of the log of a job for 24 hours (ПР17): ANSI taken out, values and keys masked.
model ProjectCiLog {
  projectRepositoryId String    @map("project_repository_id") @db.Uuid
  providerJobId       String    @map("provider_job_id") @db.VarChar(40)
  /// repoCiLogStates (CHECK): `loading` until core has fetched it.
  state               String    @db.VarChar(8)
  text                String?
  truncated           Boolean   @default(false)
  requestedAt         DateTime  @map("requested_at") @db.Timestamptz(6)
  fetchedAt           DateTime? @map("fetched_at") @db.Timestamptz(6)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)

  repository ProjectRepository @relation(fields: [projectRepositoryId], references: [id], onDelete: Cascade)

  @@id([projectRepositoryId, providerJobId])
  @@index([expiresAt])
  @@map("project_ci_logs")
}

/// The manual jobs (and, with Э10, `workflow_dispatch`) of the head of the default branch (ПР15, ПР17).
model ProjectDeployAction {
  projectRepositoryId String   @map("project_repository_id") @db.Uuid
  ref                 String   @db.VarChar(255)
  sha                 String   @db.Char(40)
  kind                String   @db.VarChar(16)
  providerActionId    String   @map("provider_action_id") @db.VarChar(200)
  name                String   @db.VarChar(200)
  syncedAt            DateTime @map("synced_at") @db.Timestamptz(6)

  repository ProjectRepository @relation(fields: [projectRepositoryId], references: [id], onDelete: Cascade)

  @@id([projectRepositoryId, kind, providerActionId])
  @@map("project_deploy_actions")
}

model Task {
  id            String          @id @default(uuid(7)) @db.Uuid
  workspaceId   String          @map("workspace_id") @db.Uuid
  chatSessionId String?         @map("chat_session_id") @db.Uuid
  createdById   String?         @map("created_by_id") @db.Uuid
  /// «Отменить» of a done task: this task reverts that one and is never billed.
  revertsTaskId String?         @map("reverts_task_id") @db.Uuid
  status        TaskStatus      @default(queued)
  /// From the turn result (turnResultSchema.change_type); NULL until the first turn ends.
  changeType    ChangeType?     @map("change_type")
  /// Class profile selected before queueing; selects the pricing rule.
  modelClass    ModelClass?     @map("model_class")
  /// Summary of the latest turn result.
  summary       String?         @db.VarChar(500)
  /// Number of the latest turn; 0 before the first one.
  turnNo        Int             @default(0) @map("turn_no")
  /// «Попробовать ещё» (failed → queued) starts a new attempt with a new hold.
  attempt       Int             @default(1)
  /// Pinned when queued on the pay-per-action plan (spec §17).
  pricingRuleId String?         @map("pricing_rule_id") @db.Uuid
  /// Σ token_usage.cost_rub plus sandbox cost, full precision, never rounded.
  costRub       Decimal         @default(0) @map("cost_rub") @db.Decimal(18, 10)
  /// Charged to the wallet on done, rounded HALF_UP once; NULL on quota plans or until charged.
  billedRub     Decimal?        @map("billed_rub") @db.Decimal(12, 2)
  /// false for «Отменить» and operator retries: no hold, no charge.
  billable      Boolean         @default(true)
  /// Set from the first request (feed design, «Ограничения в базе»); the client may rename the
  /// dialog (`task.rename`, owner's request of 26.10.2026).
  title         String?         @db.VarChar(120)
  /// Who named the dialog: its first request, the agent on its first pass (owner's request of
  /// 15.11.2026, paid with the pass) or the client. The agent renames only a `request` title, so
  /// a name the client chose stays.
  titleSource   TaskTitleSource @default(request) @map("title_source")
  /// Why a queued task waits; cleared when it leaves `queued` (CHECK tasks_waiting_check).
  waiting       TaskWaiting?
  /// Whether the chat has the cloud browser (docs/plan/57-browser-tasks.md, Б2); a chat never has
  /// a repository since projects went (docs/plan/83-remove-projects.md). Fixed when the task is
  /// created (trigger tasks_requirements_fixed).
  needsBrowser  Boolean         @default(false) @map("needs_browser")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  finishedAt    DateTime?       @map("finished_at") @db.Timestamptz(6)
  /// «Удалить диалог» (`task.remove`, owner's request of 26.10.2026): the cabinet no longer finds
  /// the dialog; the row and everything that points at it stay.
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(6)
  /// «Закрепить» (docs/plan/75-chat-input-output.md, ВВ21): the chat stands at the head of the list.
  pinnedAt      DateTime?       @map("pinned_at") @db.Timestamptz(6)
  /// «В архив»: the chat leaves the list for «Архив»; a new message brings it back.
  archivedAt    DateTime?       @map("archived_at") @db.Timestamptz(6)
  /// The project the chat is in (docs/plan/84-projects.md, ПР2); NULL — a chat without one. A
  /// project of the chat's own workspace, not deleted (trigger tasks_project_workspace).
  projectId     String?         @map("project_id") @db.Uuid

  /// First bounded content access, including GET-only privacy maps.
  contentAccessedAt    DateTime? @map("content_accessed_at") @db.Timestamptz(6)
  /// Irreversible content retention barrier, set before deleting the expired privacy map.
  contentRetiredAt     DateTime? @map("content_retired_at") @db.Timestamptz(6)
  contentMasksPurgedAt DateTime? @map("content_masks_purged_at") @db.Timestamptz(6)
  /// When the contact map the `web_*` tools wrote for this task was removed (К38).
  webMasksPurgedAt     DateTime? @map("web_masks_purged_at") @db.Timestamptz(6)

  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  chatSession        ChatSession?          @relation(fields: [chatSessionId], references: [id], onDelete: Restrict)
  createdBy          User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  revertsTask        Task?                 @relation("TaskReverts", fields: [revertsTaskId], references: [id], onDelete: Restrict)
  project            Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  revertedBy         Task[]                @relation("TaskReverts")
  telegramCurrentOf  ChannelIdentity[]     @relation("ChannelCurrentTask")
  pricingRule        PricingRule?          @relation(fields: [pricingRuleId], references: [id], onDelete: Restrict)
  turns              TaskTurn[]
  events             TaskEvent[]
  queuedMessages     TaskQueuedMessage[]
  presence           TaskPresence[]
  notifications      ChatNotification[]
  attachments        Attachment[]
  tokenUsage         TokenUsage[]
  creditHolds        CreditHold[]
  ledgerEntries      CreditLedger[]
  leases             SiteLease[]
  turnAssignments    TurnAssignment[]
  llmKeys            LlmKey[]
  accountBinding     TaskAccountBinding?
  browserSessions    BrowserSession[]
  browserCheckpoints BrowserCheckpoint[]
  pages              Page[]
  pageTrees          PageTree[]
  pageFiles          PageFile[]
  chatDocuments      ChatDocument[]
  memorySources      MemoryEntry[]
  memoryReservations MemoryReservation[]
  repoBranch         ProjectRepoBranch?
  mergeRequests      ProjectMergeRequest[]
  repoReservations   RepoReservation[]
  repoActions        RepoAction[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, updatedAt(sort: Desc), id(sort: Desc)], map: "tasks_workspace_updated_idx")
  @@index([workspaceId, pinnedAt(sort: Desc)], map: "tasks_workspace_pinned_idx", where: raw("pinned_at IS NOT NULL"))
  @@index([status, updatedAt])
  @@index([chatSessionId])
  @@index([createdById])
  @@index([revertsTaskId])
  @@index([pricingRuleId])
  @@index([projectId, updatedAt(sort: Desc), id(sort: Desc)], map: "tasks_project_updated_idx", where: raw("project_id IS NOT NULL AND deleted_at IS NULL"))
  @@map("tasks")
}

/// Must equal taskStatuses in @repo/domain (checked by a test).
enum TaskStatus {
  queued
  preparing
  running
  awaiting_user
  awaiting_approval
  deploying
  verifying
  done
  failed
  rolled_back
  cancelled
}

/// Must equal turnResultSchema.change_type in @repo/domain (checked by a test).
enum ChangeType {
  code
  content
  mixed
  none
}

/// Subscription profile classes (spec §9). The unused legacy service value remains until P4.
enum ModelClass {
  light
  standard
  heavy
  service
}

/// One container run of a task (spec §8). The snapshot under snapshot_prefix restores the next turn.
model TaskTurn {
  id              String     @id @default(uuid(7)) @db.Uuid
  taskId          String     @map("task_id") @db.Uuid
  turnNo          Int        @map("turn_no")
  status          TurnStatus @default(pending)
  driverId        String     @map("driver_id") @db.VarChar(32)
  driverVersion   String?    @map("driver_version") @db.VarChar(64)
  /// Sandbox image, pinned by digest.
  image           String     @db.VarChar(512)
  /// Model selected by the class profile for the turn.
  modelId         String?    @map("model_id") @db.Uuid
  /// Native session id of the CLI.
  nativeSessionId String?    @map("native_session_id") @db.VarChar(200)
  /// raditi-sessions prefix: sessions/<sessionId>/turns/<NNNN>/.
  snapshotPrefix  String?    @map("snapshot_prefix") @db.VarChar(512)
  /// Unused legacy per-turn key hash; retained until the P4 contract migration.
  /// The key itself is never stored.
  litellmKeyHash  String?    @unique @map("litellm_key_hash") @db.VarChar(64)
  baseSha         String?    @map("base_sha") @db.VarChar(64)
  headSha         String?    @map("head_sha") @db.VarChar(64)
  failureReason   String?    @map("failure_reason") @db.VarChar(2000)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt       DateTime?  @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?  @map("finished_at") @db.Timestamptz(6)
  /// The pass of this turn ended in a `feed.failure`: the platform refused its result. Replaced,
  /// never continued; its model calls are not charged to the client (docs/plan/53, «Попробовать ещё»).
  rejectedAt      DateTime?  @map("rejected_at") @db.Timestamptz(6)
  undoneAt        DateTime?  @map("undone_at") @db.Timestamptz(6)

  task         Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  driver       AgentDriver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  model        LlmModel?     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  events       TaskEvent[]
  chatSessions ChatSession[]
  tokenUsages  TokenUsage[]

  @@unique([taskId, turnNo])
  @@index([driverId])
  @@index([modelId])
  @@map("task_turns")
}

enum TurnStatus {
  pending
  running
  completed
  failed
  cancelled
  timed_out
  /// The runner or container vanished; never billed to the client (spec §17).
  lost
}

/// One turn's hold on an executor (spec §8 «Раннер на песочной ВМ»): core's own Docker or a runner
/// session, the lease epochs of its journal and the absolute deadline of its container. Recovery
/// reads the unfinished ones; a turn has at most one.
model TurnAssignment {
  id               String                 @id @default(uuid(7)) @db.Uuid
  taskId           String                 @map("task_id") @db.Uuid
  /// The scope of the lease (`leaseScopeOf`): the site of the task, or the task without one.
  siteId           String                 @map("site_id") @db.Uuid
  /// Sandbox label of the session: sessions/<sessionId>/turns/<NNNN>/ in raditi-sessions.
  sessionId        String                 @map("session_id") @db.VarChar(64)
  turnNo           Int                    @map("turn_no")
  executor         TurnExecutorKind
  /// The turn request without its LLM key and MCP token (turnPlanSchema in @repo/domain).
  plan             Json
  /// The turn lease epoch it started under; recovery moves lease_epoch forward.
  firstEpoch       Int                    @map("first_epoch")
  leaseEpoch       Int                    @map("lease_epoch")
  /// Database time by which the container is gone; recovery never extends it.
  deadlineAt       DateTime               @map("deadline_at") @db.Timestamptz(6)
  runnerId         String?                @map("runner_id") @db.VarChar(63)
  /// A uuid per runner process start: a restarted runner is a new session.
  runnerSession    String?                @map("runner_session") @db.Uuid
  claimedAt        DateTime?              @map("claimed_at") @db.Timestamptz(6)
  containerId      String?                @map("container_id") @db.VarChar(200)
  recoveryAttempts Int                    @default(0) @map("recovery_attempts")
  outcome          TurnAssignmentOutcome?
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  finishedAt       DateTime?              @map("finished_at") @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, turnNo], map: "turn_assignments_active_turn_key", where: raw("finished_at IS NULL"))
  @@index([siteId])
  @@index([runnerId, runnerSession])
  @@map("turn_assignments")
}

/// Must equal turnExecutorKinds in @repo/domain (checked by a test).
enum TurnExecutorKind {
  local
  runner
}

/// Must equal turnAssignmentOutcomes in @repo/domain (checked by a test).
enum TurnAssignmentOutcome {
  completed
  failed
  lost
}

/// Task history for the chat and SSE (spec §7). The bigint id orders events and is the
/// Last-Event-ID a browser resumes from. Large bodies live in S3 under s3_key.
model TaskEvent {
  id            BigInt   @id @default(autoincrement())
  taskId        String   @map("task_id") @db.Uuid
  turnId        String?  @map("turn_id") @db.Uuid
  /// A common agent event (started, message, command, …, failed) or a platform event.
  type          String   @db.VarChar(64)
  payload       Json
  /// Shown to the client in the chat; the rest is for operators.
  clientVisible Boolean  @default(false) @map("client_visible")
  /// Key in raditi-logs or raditi-artifacts when the body is too large for payload.
  s3Key         String?  @map("s3_key") @db.VarChar(1024)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  turn TaskTurn? @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([taskId, id])
  @@index([turnId])
  // The gateway and the key issuer check this flag on every lookup, admission and key issue.
  // The casts are what PostgreSQL stores for a varchar column: without them migrate diff reports
  // the index as changed.
  @@index([taskId], map: "task_events_llm_policy_flagged_idx", where: raw("type::text = 'llm.policy_flagged'::text"))
  // What a reader of the feed reads (CHECK task_events_feed_visible_check: visible = `feed.*`).
  @@index([taskId, id], map: "task_events_feed_idx", where: raw("client_visible"))
  @@map("task_events")
}

/// The queue of a chat (docs/plan/75-chat-input-output.md, ВВ1–ВВ5): what the client wrote while the
/// agent worked. core takes it into the feed as `feed.request` of the kind `queued` when the pass
/// ended and starts the next one; until then the client may change or remove it.
model TaskQueuedMessage {
  id          String   @id @default(uuid(7)) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  /// The user who wrote the words; they become the author of the `feed.request`.
  authorId    String   @map("author_id") @db.Uuid
  /// Invented by the browser: a repeat of the same words finds the same row.
  requestId   String   @map("request_id") @db.Uuid
  /// 1–4000 characters (CHECK task_queued_messages_text_check).
  text        String
  /// Files of the words, bound to the task when they were queued; at most ten (CHECK).
  attachments String[] @default([]) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, requestId])
  @@index([taskId, createdAt])
  @@map("task_queued_messages")
}

/// «Уведомления» of the settings (docs/plan/75-chat-input-output.md, ВВ10); no row — the defaults.
model NotificationSetting {
  userId    String   @id @map("user_id") @db.Uuid
  /// Web Push to the browsers the client turned it on in.
  push      Boolean  @default(false)
  /// Letters about the work of the agent.
  email     Boolean  @default(true)
  /// Messages of the bot in Telegram, when Telegram is linked (docs/plan/80-telegram.md, Т8).
  telegram  Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

/// A browser that takes Web Push (ВВ8): `https://` endpoint, the keys of RFC 8291 (CHECK).
model PushSubscription {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// The client looks at the chat (ВВ7): marked by the feed as it reads, at most every 30 seconds.
model TaskPresence {
  userId String   @map("user_id") @db.Uuid
  taskId String   @map("task_id") @db.Uuid
  seenAt DateTime @map("seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
  @@map("task_presence")
}

/// A notification of a chat that waits (ВВ8, ВВ9); `kind` — answered, question, ready, failed or
/// limit (CHECK chat_notifications_kind_check).
model ChatNotification {
  id        String   @id @default(uuid(7)) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  kind      String
  emailed   Boolean  @default(false)
  pushed    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, userId, createdAt])
  @@map("chat_notifications")
}

/// A recognition of dictation (docs/plan/75-chat-input-output.md, ВВ17, ВВ19): its length and
/// outcome, for the limit per user and hour. The sound is never kept.
model SpeechCall {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// 0–30 (CHECK speech_calls_seconds_check).
  seconds   Int
  /// recognized, empty or failed (CHECK speech_calls_outcome_check).
  outcome   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("speech_calls")
}

/// The client's own instructions to the agent in every chat (docs/plan/76-agent-instructions.md,
/// И1): 1–2000 characters (CHECK agent_instructions_text_check); no row — none.
model AgentInstructions {
  userId    String   @id @map("user_id") @db.Uuid
  text      String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_instructions")
}

/// A file the client attached to a message (docs/plan/57-browser-tasks.md, Б26), in raditi-inbox
/// under inbox/<workspaceId>/<id> (attachmentKey in @repo/domain; CHECK attachments_key_check).
/// Announced `uploading`, `ready` once web checked the stored object, `bound` with the message of
/// the task that sent it, `deleted` when removed before that (CHECK attachments_bound_check). The
/// model never gets its key or a link to it; the browser worker reads it for a page it uploads to.
model Attachment {
  id           String           @id @default(uuid(7)) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  /// The task that sent it: set exactly while `bound`, together with bound_at.
  taskId       String?          @map("task_id") @db.Uuid
  uploadedById String?          @map("uploaded_by_id") @db.Uuid
  source       Channel
  /// Must equal attachmentStatuses in @repo/domain (checked by a test).
  status       AttachmentStatus @default(uploading)
  s3Key        String           @unique @map("s3_key") @db.VarChar(1024)
  fileName     String           @map("file_name") @db.VarChar(255)
  contentType  String           @map("content_type") @db.VarChar(255)
  sizeBytes    Int              @map("size_bytes")
  /// Until when a file nobody sent is kept; nothing reads it once the file is bound.
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  boundAt      DateTime?        @map("bound_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([uploadedById, status])
  @@index([status, expiresAt])
  @@index([workspaceId])
  @@map("attachments")
}

/// Must equal attachmentStatuses in @repo/domain (checked by a test).
enum AttachmentStatus {
  uploading
  ready
  bound
  deleted
}

// ─── Agents and models (spec §8, §9) ──────────────────────────────────────────

/// Registry of agent drivers; id is AgentDriver.id (agentDriverIds in @repo/domain, the seed test
/// checks it). A string, not an enum: adding a driver needs no migration.
model AgentDriver {
  id           String   @id @db.VarChar(32)
  /// Unread: every driver runs the shared SANDBOX_IMAGE pinned by digest (spec §8). The seed
  /// writes a placeholder until the B16 contract migration drops the column.
  image        String   @db.VarChar(512)
  /// AgentCapabilities: resume, jsonEvents, outputSchema, mcp, images, reasoningEvents, compaction.
  capabilities Json
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  turns                TaskTurn[]
  chatSessions         ChatSession[]
  tokenUsage           TokenUsage[]
  subscriptionAccounts SubscriptionAccount[]
  llmKeys              LlmKey[]
  taskAccountBindings  TaskAccountBinding[]

  @@map("agent_drivers")
}

model LlmProvider {
  id              String          @id @default(uuid(7)) @db.Uuid
  /// Stable backend slug; legacy API providers remain disabled for price history.
  slug            String          @unique @db.VarChar(64)
  name            String          @db.VarChar(255)
  /// Subscription backend; the API kind is retained for historical rows (spec §9).
  kind            LlmProviderKind @default(api)
  credentialRefId String?         @map("credential_ref_id") @db.Uuid
  enabled         Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  credentialRef         CredentialRef?         @relation(fields: [credentialRefId], references: [id], onDelete: Restrict)
  models                LlmModel[]
  subscriptionAccounts  SubscriptionAccount[]
  planRates             LlmPlanRate[]
  crossBorderClearances CrossBorderClearance[]

  @@index([credentialRefId])
  @@map("llm_providers")
}

enum LlmProviderKind {
  api
  subscription
}

model LlmModel {
  id                  String     @id @default(uuid(7)) @db.Uuid
  providerId          String     @map("provider_id") @db.Uuid
  /// Stable model slug used in gateway requests.
  slug                String     @db.VarChar(128)
  /// Display name of the profile's model.
  name                String     @db.VarChar(255)
  /// Model id in the provider API; NULL until confirmed in the PoC.
  providerModelId     String?    @map("provider_model_id") @db.VarChar(255)
  modelClass          ModelClass @map("model_class")
  /// Output tokens reserved before a call, not the provider's output cap (spec §17).
  reserveOutputTokens Int        @default(32000) @map("reserve_output_tokens")
  enabled             Boolean    @default(true)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider   LlmProvider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  prices     LlmModelPrice[]
  turns      TaskTurn[]
  tokenUsage TokenUsage[]
  turnCost   LlmTurnCost?
  llmKeys    LlmKey[]
  llmCalls   LlmCall[]

  @@unique([providerId, slug])
  @@map("llm_models")
}

/// Accounting rate history in RUB per 1M tokens including VAT (spec §16, §17). Append-only: a new
/// price is a new row with a later effective_from; token_usage keeps the price_id it was costed
/// with. NULL cache prices are charged as input.
model LlmModelPrice {
  id              String   @id @default(uuid(7)) @db.Uuid
  modelId         String   @map("model_id") @db.Uuid
  effectiveFrom   DateTime @map("effective_from") @db.Timestamptz(6)
  inputPer1m      Decimal  @map("input_per_1m") @db.Decimal(14, 6)
  cacheReadPer1m  Decimal? @map("cache_read_per_1m") @db.Decimal(14, 6)
  cacheWritePer1m Decimal? @map("cache_write_per_1m") @db.Decimal(14, 6)
  /// Reasoning tokens are part of the output.
  outputPer1m     Decimal  @map("output_per_1m") @db.Decimal(14, 6)
  /// 0.2200 for 22%.
  vatRate         Decimal  @map("vat_rate") @db.Decimal(5, 4)
  sourceUrl       String   @map("source_url") @db.VarChar(1024)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  model      LlmModel     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  tokenUsage TokenUsage[]

  @@unique([modelId, effectiveFrom])
  @@unique([id, modelId])
  @@map("llm_model_prices")
}

/// One LLM call, ingested idempotently by gateway_call_id (spec §9,
/// §17). The only source for billing: agent usage events are for the UI. Token categories match
/// tokenUsageSchema in @repo/domain; cost uses the price row in price_id.
model TokenUsage {
  id                    String   @id @default(uuid(7)) @db.Uuid
  gatewayCallId         String   @unique @map("gateway_call_id") @db.Uuid
  keyId                 String   @map("key_id") @db.Uuid
  subscriptionAccountId String   @map("subscription_account_id") @db.Uuid
  taskId                String   @map("task_id") @db.Uuid
  taskAttempt           Int      @map("task_attempt")
  /// P12 creates the turn row before issue; earlier gateway calls have no turn row.
  turnId                String?  @map("turn_id") @db.Uuid
  driverId              String   @map("driver_id") @db.VarChar(32)
  modelId               String   @map("model_id") @db.Uuid
  priceId               String   @map("price_id") @db.Uuid
  /// Input without cache reads and cache writes.
  inputUncachedTokens   Int      @map("input_uncached_tokens")
  cacheReadTokens       Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens      Int      @default(0) @map("cache_write_tokens")
  /// Includes reasoning.
  outputTokens          Int      @map("output_tokens")
  /// Informational: already inside output_tokens, never added again.
  reasoningTokens       Int      @default(0) @map("reasoning_tokens")
  costRub               Decimal  @map("cost_rub") @db.Decimal(18, 10)
  estimated             Boolean  @default(false)
  estimateReason        String?  @map("estimate_reason") @db.VarChar(16)
  /// Platform-caused estimates still consume budget but are not charged to the client.
  billable              Boolean  @default(true)
  /// Credits of the provider's plan the call took (llm_plan_rates at occurred_at; an estimate
  /// for an estimated call). NULL: the provider has no plan rates (zai-api) or the row is older.
  planCredits           Decimal? @map("plan_credits") @db.Decimal(14, 4)
  occurredAt            DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task                Task                @relation(fields: [taskId], references: [id], onDelete: Restrict)
  turn                TaskTurn?           @relation(fields: [turnId], references: [id], onDelete: Restrict)
  driver              AgentDriver         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  model               LlmModel            @relation(fields: [modelId], references: [id], onDelete: Restrict)
  price               LlmModelPrice       @relation(fields: [priceId, modelId], references: [id, modelId], onDelete: Restrict, onUpdate: Restrict)
  call                LlmCall             @relation(fields: [gatewayCallId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  key                 LlmKey              @relation(fields: [keyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptionAccount SubscriptionAccount @relation(fields: [subscriptionAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "token_usage_account_fkey")

  @@index([taskId, turnId])
  @@index([turnId])
  @@index([modelId, occurredAt])
  @@index([occurredAt])
  @@index([keyId])
  @@index([taskId, taskAttempt], map: "token_usage_task_attempt_idx")
  @@index([subscriptionAccountId, occurredAt], map: "token_usage_account_occurred_idx")
  @@map("token_usage")
}

/// Pool subscription account (spec §9). Only the llm role reads its token from Vault.
/// Operator status and gateway health are independent; no token value is stored here.
model SubscriptionAccount {
  id                    String                    @id @default(uuid(7)) @db.Uuid
  providerId            String                    @map("provider_id") @db.Uuid
  /// Driver the subscription serves.
  driverId              String                    @map("driver_id") @db.VarChar(32)
  /// Unique among accounts that are not retired, as the provider account id below. Look an
  /// account up by either with findFirst and `status: { not: 'retired' }`: findUnique returns
  /// whichever row it meets first, a retired predecessor included.
  label                 String                    @db.VarChar(255)
  credentialRefId       String                    @unique @map("credential_ref_id") @db.Uuid
  /// Unused legacy limits; dropped by the P4 contract migration.
  limits                Json                      @default("{}")
  plan                  String                    @db.VarChar(32)
  /// Provider account id, not a secret. Relogin must retain this identity.
  externalAccountId     String?                   @map("external_account_id") @db.VarChar(128)
  paidUntil             DateTime?                 @map("paid_until") @db.Date
  status                SubscriptionAccountStatus @default(active)
  statusReason          String?                   @map("status_reason") @db.VarChar(64)
  health                SubscriptionAccountHealth @default(ok)
  healthReason          String?                   @map("health_reason") @db.VarChar(64)
  healthChangedAt       DateTime?                 @map("health_changed_at") @db.Timestamptz(6)
  coolingUntil          DateTime?                 @map("cooling_until") @db.Timestamptz(6)
  breakerOpenUntil      DateTime?                 @map("breaker_open_until") @db.Timestamptz(6)
  usageMissingStreak    Int                       @default(0) @map("usage_missing_streak") @db.SmallInt
  maxConcurrentTurns    Int                       @map("max_concurrent_turns") @db.SmallInt
  maxConcurrentRequests Int                       @map("max_concurrent_requests") @db.SmallInt
  limitWindows          Json                      @default("[]") @map("limit_windows")
  headroomPct           Decimal?                  @map("headroom_pct") @db.Decimal(5, 2)
  limitsSeenAt          DateTime?                 @map("limits_seen_at") @db.Timestamptz(6)
  /// No reader and no writer since the removal of OAuth; dropped by a contract migration.
  creditsSeen           Json?                     @map("credits_seen")
  credentialVersion     Int                       @default(0) @map("credential_version")
  credentialExpiresAt   DateTime?                 @map("credential_expires_at") @db.Timestamptz(6)
  credentialRefreshedAt DateTime?                 @map("credential_refreshed_at") @db.Timestamptz(6)
  /// The three refresh columns: no reader and no writer since the removal of OAuth; dropped
  /// by a contract migration.
  refreshStartedAt      DateTime?                 @map("refresh_started_at") @db.Timestamptz(6)
  refreshFinishedAt     DateTime?                 @map("refresh_finished_at") @db.Timestamptz(6)
  refreshFailures       Int                       @default(0) @map("refresh_failures")
  retireRequestedAt     DateTime?                 @map("retire_requested_at") @db.Timestamptz(6)
  credentialsRevokedAt  DateTime?                 @map("credentials_revoked_at") @db.Timestamptz(6)
  /// Device and installation identifiers, not authentication secrets. No reader and no writer
  /// since the removal of OAuth; dropped by a contract migration.
  clientIdentity        Json                      @default("{}") @map("client_identity")
  lastUsedAt            DateTime?                 @map("last_used_at") @db.Timestamptz(6)
  enabled               Boolean                   @default(false)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider      LlmProvider          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  driver        AgentDriver          @relation(fields: [driverId], references: [id], onDelete: Restrict)
  credentialRef CredentialRef        @relation(fields: [credentialRefId], references: [id], onDelete: Restrict)
  taskBindings  TaskAccountBinding[]
  llmKeys       LlmKey[]
  fallbackKeys  LlmKey[]             @relation("LlmKeyFallback")
  llmCalls      LlmCall[]
  tokenUsage    TokenUsage[]

  // A retired row stays for its history and releases its identity for a new import.
  @@unique([label], map: "subscription_accounts_label_key", where: raw("status <> 'retired'"))
  @@unique([providerId, externalAccountId], map: "subscription_accounts_external_key", where: raw("status <> 'retired'"))
  @@index([providerId])
  @@index([driverId])
  @@index([providerId, status, health], map: "subscription_accounts_pick_idx", where: raw("enabled"))
  @@map("subscription_accounts")
}

enum SubscriptionAccountStatus {
  active
  banned
  retired
}

enum SubscriptionAccountHealth {
  ok
  needs_relogin
  suspended
}

/// One pool binding per task, retained across turns and attempts.
model TaskAccountBinding {
  taskId                String   @id @map("task_id") @db.Uuid
  driverId              String   @map("driver_id") @db.VarChar(32)
  subscriptionAccountId String   @map("subscription_account_id") @db.Uuid
  boundAt               DateTime @default(now()) @map("bound_at") @db.Timestamptz(6)
  rebinds               Int      @default(0)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  task                Task                @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  driver              AgentDriver         @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptionAccount SubscriptionAccount @relation(fields: [subscriptionAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([subscriptionAccountId], map: "task_account_bindings_account_idx")
  @@map("task_account_bindings")
}

/// Turn key hash and admission budget. The actual key lives only in Vault turns/.
model LlmKey {
  id                    String    @id @default(uuid(7)) @db.Uuid
  keyHash               String    @unique @map("key_hash") @db.VarChar(64)
  /// Hash of the paired per-turn MCP token; legacy keys without it cannot reach MCP.
  mcpTokenHash          String?   @unique @map("mcp_token_hash") @db.VarChar(64)
  taskId                String    @map("task_id") @db.Uuid
  taskAttempt           Int       @map("task_attempt")
  sessionId             String    @map("session_id") @db.VarChar(64)
  turnNo                Int       @map("turn_no")
  firstEpoch            Int       @map("first_epoch")
  driverId              String    @map("driver_id") @db.VarChar(32)
  modelId               String    @map("model_id") @db.Uuid
  subscriptionAccountId String    @map("subscription_account_id") @db.Uuid
  /// An account of the API the gateway carries the key's calls to once the plan's window is out
  /// (docs/plan/70-turn-without-time-limit.md, ВР25); NULL — none.
  fallbackAccountId     String?   @map("fallback_account_id") @db.Uuid
  reasoningEffort       String?   @map("reasoning_effort") @db.VarChar(16)
  /// Positive budget: what the customer can pay (spec §20, «Только кредиты», КР6); fractional-ruble remainder budgets are valid.
  budgetRub             Decimal   @map("budget_rub") @db.Decimal(18, 10)
  /// Runner address; NULL for the local executor.
  boundSource           String?   @map("bound_source") @db.Inet
  issuedAt              DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  validUntil            DateTime  @map("valid_until") @db.Timestamptz(6)
  revokeRequestedAt     DateTime? @map("revoke_requested_at") @db.Timestamptz(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  usageClosedAt         DateTime? @map("usage_closed_at") @db.Timestamptz(6)
  lastCallAt            DateTime? @map("last_call_at") @db.Timestamptz(6)
  lastRefusal           String?   @map("last_refusal") @db.VarChar(32)
  lastRefusalAt         DateTime? @map("last_refusal_at") @db.Timestamptz(6)
  /// With `workspace_limit`: the window of the workspace that refused (`5h`, `week`) and its reset.
  lastRefusalWindow     String?   @map("last_refusal_window") @db.VarChar(8)
  lastRefusalResetsAt   DateTime? @map("last_refusal_resets_at") @db.Timestamptz(6)

  task                Task                 @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  driver              AgentDriver          @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model               LlmModel             @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptionAccount SubscriptionAccount  @relation(fields: [subscriptionAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fallbackAccount     SubscriptionAccount? @relation("LlmKeyFallback", fields: [fallbackAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  calls               LlmCall[]
  tokenUsage          TokenUsage[]

  @@unique([taskId, turnNo, firstEpoch])
  @@index([subscriptionAccountId, expiresAt], map: "llm_keys_account_active_idx", where: raw("revoked_at IS NULL"))
  @@index([taskId, taskAttempt], map: "llm_keys_task_attempt_idx")
  @@index([revokeRequestedAt], map: "llm_keys_revoke_retry_idx", where: raw("revoke_requested_at IS NOT NULL AND revoked_at IS NULL"))
  @@index([revokedAt], map: "llm_keys_usage_open_idx", where: raw("usage_closed_at IS NULL"))
  @@map("llm_keys")
}

/// One provider request, opened before send and closed atomically with its usage row.
model LlmCall {
  id                    String       @id @default(uuid(7)) @db.Uuid
  keyId                 String       @map("key_id") @db.Uuid
  subscriptionAccountId String       @map("subscription_account_id") @db.Uuid
  modelId               String       @map("model_id") @db.Uuid
  route                 String       @db.VarChar(64)
  state                 LlmCallState @default(open)
  reservedRub           Decimal      @map("reserved_rub") @db.Decimal(18, 10)
  /// The reserve in credits of the provider's plan, counted by the forecast of the account's
  /// windows while the call is open. NULL: no plan rates.
  reservedPlanCredits   Decimal?     @map("reserved_plan_credits") @db.Decimal(14, 4)
  requestBytes          Int          @map("request_bytes")
  /// est_in the reserve was priced with; a lost call is estimated from it. NULL: opened before it was kept.
  estimatedInputTokens  Int?         @map("estimated_input_tokens")
  responseBytes         BigInt       @default(0) @map("response_bytes")
  upstreamStatus        Int?         @map("upstream_status")
  upstreamResponseId    String?      @map("upstream_response_id") @db.VarChar(256)
  signal                String?      @db.VarChar(32)
  startedAt             DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt            DateTime?    @map("finished_at") @db.Timestamptz(6)

  key                 LlmKey              @relation(fields: [keyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptionAccount SubscriptionAccount @relation(fields: [subscriptionAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model               LlmModel            @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenUsage          TokenUsage?

  @@index([startedAt], map: "llm_calls_open_idx", where: raw("state = 'open'"))
  @@index([keyId], map: "llm_calls_key_idx")
  @@index([subscriptionAccountId, startedAt], map: "llm_calls_account_started_idx")
  @@index([signal, startedAt], map: "llm_calls_signal_idx", where: raw("signal IS NOT NULL"))
  @@map("llm_calls")
}

enum LlmCallState {
  open
  completed
  failed
  aborted
  lost
}

/// Operator-maintained clearance for sending real workspace data to a provider.
model CrossBorderClearance {
  id                   String    @id @default(uuid(7)) @db.Uuid
  providerId           String    @map("provider_id") @db.Uuid
  countries            String    @db.VarChar(64)
  notice22Ref          String    @map("notice22_ref") @db.VarChar(128)
  notice22Date         DateTime  @map("notice22_date") @db.Date
  recipientsAssessedOn DateTime  @map("recipients_assessed_on") @db.Date
  notice12Ref          String    @map("notice12_ref") @db.VarChar(128)
  notice12ReceivedOn   DateTime  @map("notice12_received_on") @db.Date
  transferAllowedFrom  DateTime  @map("transfer_allowed_from") @db.Date
  documents            String    @db.VarChar(1024)
  recordedBy           String    @map("recorded_by") @db.VarChar(255)
  recordedAt           DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)

  provider LlmProvider @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([providerId], map: "cross_border_clearances_active_idx", where: raw("revoked_at IS NULL"))
  @@map("cross_border_clearances")
}

// ─── Plans and billing (spec §17) ─────────────────────────────────────────────

/// Tariffs (docs/business.md §6). Prices in RUB without VAT: the seller is self-employed.
model Plan {
  id              String   @id @default(uuid(7)) @db.Uuid
  slug            String   @unique @db.VarChar(50)
  name            String   @db.VarChar(100)
  kind            PlanKind
  /// Monthly price (quota), one-off price (pack), 0 for pay-per-action.
  price           Decimal  @db.Decimal(12, 2)
  creditsPerMonth Int?     @map("credits_per_month")
  /// Unused since 17.10.2026 (the daily limit is in credits, `creditsPerDay`); dropped in M5.18.
  tasksPerDay     Int?     @map("tasks_per_day")
  /// Tariff credits a quota plan gives a Moscow day, never more than its month; NULL: no daily
  /// cap. Gift and pack credits are outside it.
  creditsPerDay   Int?     @map("credits_per_day")
  /// Credits a pack adds to the account of purchased credits (unit = credit_pack).
  packCredits     Int?     @map("pack_credits")
  /// Credits the work of a workspace may take in its window of 5 hours and of the week (plan 71);
  /// NULL: no limit. Without a paid tariff the constants of @repo/domain apply.
  creditsPer5h    Int?     @map("credits_per_5h")
  creditsPerWeek  Int?     @map("credits_per_week")
  /// Sites of pages a workspace on this tariff may have (docs/plan/73-pages-sites.md, Дер36);
  /// NULL for packs and pay-per-action — without a tariff `sitesWithoutTariff` of @repo/domain.
  pageSites       Int?     @map("page_sites")
  /// The own name of a site, <name>.pages.raditi.ru, on this tariff (Дер32).
  pageCustomNames Boolean  @default(false) @map("page_custom_names")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  pricingRules         PricingRule[]
  subscriptions        Subscription[]
  /// Subscriptions that switch to this plan at their next renewal.
  plannedSubscriptions Subscription[] @relation("SubscriptionNextPlan")
  orders               Order[]

  @@map("plans")
}

enum PlanKind {
  quota
  payg
  pack
}

/// Pay-per-action price (spec §17): clamp(fee_per_action + Σ cost × markup, min_charge,
/// hold_amount), rounded HALF_UP to kopecks once per task. Versioned by effective_from and never
/// edited: a task pins its rule when queued.
model PricingRule {
  id            String     @id @default(uuid(7)) @db.Uuid
  planId        String     @map("plan_id") @db.Uuid
  modelClass    ModelClass @map("model_class")
  effectiveFrom DateTime   @map("effective_from") @db.Timestamptz(6)
  markup        Decimal    @db.Decimal(8, 4)
  feePerAction  Decimal    @map("fee_per_action") @db.Decimal(12, 2)
  minCharge     Decimal    @map("min_charge") @db.Decimal(12, 2)
  /// Reserved from the wallet when the task is queued; also the price ceiling.
  holdAmount    Decimal    @map("hold_amount") @db.Decimal(12, 2)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  plan  Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  tasks Task[]

  @@unique([planId, modelClass, effectiveFrom])
  @@map("pricing_rules")
}

/// The credit rate K (spec §17): RUB of accounting cost in one credit. Append-only and never
/// seeded: a new rate is a new row, written by the operator command `billing:rates` together
/// with the price rows of the models and with the same effective_from. A model call is turned
/// into credits at the rate in force when it started (token_usage.occurred_at); nothing is
/// pinned on a task or on a hold. effective_from holds whole milliseconds and rub_per_credit is
/// above zero (CHECKs in the credit_rates migration).
model CreditRate {
  id            String   @id @default(uuid(7)) @db.Uuid
  effectiveFrom DateTime @unique @map("effective_from") @db.Timestamptz(6)
  rubPerCredit  Decimal  @map("rub_per_credit") @db.Decimal(14, 6)
  /// How the row was derived: basket, model, rates, date, who approved.
  basis         String   @db.VarChar(1024)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("credit_rates")
}

/// A workspace's subscription to a quota plan; renewed by cron with the saved payment method.
/// A workspace has at most one live subscription (trial, active or past_due); cancelled and
/// expired ones stay as history, and a later purchase is a new row. The period ends after it
/// starts (CHECK in the billing_subscriptions migration).
model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  workspaceId            String             @map("workspace_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  /// A scheduled plan change: the plan of the next period, applied at renewal. NULL when no
  /// change is scheduled.
  nextPlanId             String?            @map("next_plan_id") @db.Uuid
  status                 SubscriptionStatus @default(active)
  currentPeriodStart     DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime           @map("current_period_end") @db.Timestamptz(6)
  /// The moment of the payment the monthly periods are counted from. Every period starts on its
  /// day of month and time of day by the Moscow calendar; a shorter month takes its last day and
  /// the day comes back afterwards (31.01 → 28.02 → 31.03), which the period dates alone cannot
  /// tell.
  periodAnchor           DateTime           @map("period_anchor") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  /// When auto-renewal was switched off; cleared when it is switched on again.
  cancelledAt            DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  /// Since when the subscription is past_due: the renewal charge did not go through. Without a
  /// payment it expires a set number of days later.
  pastDueSince           DateTime?          @map("past_due_since") @db.Timestamptz(6)
  /// current_period_end of the period whose renewal notice is already in the outbox: the saved
  /// payment method is charged only after the customer was told. NULL when no notice stands.
  renewalNoticePeriodEnd DateTime?          @map("renewal_notice_period_end") @db.Timestamptz(6)
  /// ЮKassa saved payment method id for renewals.
  paymentMethodId        String?            @map("payment_method_id") @db.VarChar(64)
  /// ЮKassa payment_method.title, e.g. "Bank card *4444".
  paymentMethodTitle     String?            @map("payment_method_title") @db.VarChar(128)
  /// ЮKassa payment_method.type ("bank_card", "sbp", …), card.card_type ("Mir", "Visa", …) and
  /// card.last4 of the saved method: the customer's label «Карта «Мир» •• 4444» is built from
  /// them in Russian, not from the title.
  paymentMethodType      String?            @map("payment_method_type") @db.VarChar(32)
  paymentMethodCardType  String?            @map("payment_method_card_type") @db.VarChar(32)
  paymentMethodLast4     String?            @map("payment_method_last4") @db.VarChar(4)
  /// ЮKassa payment method that is being bound to replace the saved one; NULL when no
  /// replacement is under way.
  pendingPaymentMethodId String?            @map("pending_payment_method_id") @db.VarChar(64)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  nextPlan  Plan?     @relation("SubscriptionNextPlan", fields: [nextPlanId], references: [id], onDelete: Restrict)
  orders    Order[]

  // One live subscription per workspace. The client offers workspaceId as a unique key, but the
  // index covers live rows only: every findUnique, update and upsert by workspaceId must add
  // status: { in: liveSubscriptionStatuses }. Without it findUnique returns an arbitrary row, an
  // ended one included; update writes every subscription of the workspace and then throws, and
  // outside a transaction those writes stay; upsert fails with 42P10.
  // The predicate is spelled as PostgreSQL stores status IN ('trial', 'active', 'past_due'):
  // any other spelling makes migrate diff report the index as changed.
  @@unique([workspaceId], map: "subscriptions_workspace_live_key", where: raw("status = ANY (ARRAY['trial'::\"SubscriptionStatus\", 'active'::\"SubscriptionStatus\", 'past_due'::\"SubscriptionStatus\"])"))
  @@index([workspaceId])
  @@index([planId])
  @@index([nextPlanId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Must equal subscriptionStatuses in @repo/domain (checked by a test). trial is not used yet.
enum SubscriptionStatus {
  trial
  active
  past_due
  cancelled
  expired
}

/// An account of a workspace (spec §17), one per unit: the credits of the tariff
/// (unit = credit_tariff), the credits given at registration (unit = credit_gift), purchased
/// credits (unit = credit_pack) or the RUB wallet (unit = rub).
/// balance and held change only in SQL, in the transaction that writes credit_ledger or
/// credit_holds. held = Σ active holds; available = balance − held. The three credit accounts
/// hold whole numbers (CHECK re-created by the billing_credit_gift_checks migration).
model BillingAccount {
  id          String      @id @default(uuid(7)) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  unit        BillingUnit
  balance     Decimal     @default(0) @db.Decimal(14, 2)
  held        Decimal     @default(0) @db.Decimal(14, 2)
  /// What the workspace owes: what passes were charged above the credits it had. Only on the
  /// pack account (billing_accounts_debt_check); the next grant pays it first (spec §20,
  /// «Только кредиты», КР7).
  debt        Decimal     @default(0) @db.Decimal(14, 2)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  holds     CreditHold[]
  entries   CreditLedger[]

  @@unique([workspaceId, unit])
  // Target of the (account_id, unit) foreign keys: a ledger entry's or hold's unit always matches
  // its account.
  @@unique([id, unit])
  @@map("billing_accounts")
}

/// A workspace has three credit accounts; their units must equal creditAccountUnits in
/// @repo/domain (checked by a test). The values keep the order of the database type, which is
/// the order the labels were added in, not the order credits are spent in; the first two credit
/// labels were 'edit' and 'edit_pack' before the billing_credit_units migration renamed them.
enum BillingUnit {
  /// Credits of the tariff: the quota is granted anew every period and what is left of the
  /// previous one expires.
  credit_tariff
  /// Roubles of the pay-per-action wallet.
  rub
  /// Purchased credits (a pack): they never expire and outlive the tariff.
  credit_pack
  /// Gift credits: granted once per user at registration, they never expire and are spent
  /// after the credits of the tariff and before purchased ones.
  credit_gift
}

/// A task's reserve (spec §17). In credits: what an attempt sets aside when it is queued, one row
/// per credit account it touches — the tariff, the gift, the pack —, the amount written once.
/// «Продолжить» and «Попробовать ещё» are new attempts with rows of their own; the active rows of
/// a task are one pool, charged, returned and expired together. In RUB: the class hold amount of
/// the pay-per-action wallet.
/// unit copies the account's unit (composite foreign key, as in credit_ledger) so a CHECK keeps
/// credit holds whole; it also tells on which of the credit accounts the credits are reserved.
model CreditHold {
  id        String      @id @default(uuid(7)) @db.Uuid
  accountId String      @map("account_id") @db.Uuid
  unit      BillingUnit
  taskId    String      @map("task_id") @db.Uuid
  attempt   Int         @default(1)
  amount    Decimal     @db.Decimal(14, 2)
  status    HoldStatus  @default(active)
  /// Cron expires the reserve of a task stuck past this moment (e.g. in awaiting_user): one
  /// value on all active rows of a task.
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(6)
  /// On a tariff row the stamp of the period its credits are of: a reserve placed after a period
  /// ended and before its renewal is settled is stamped with the last millisecond of that
  /// period. On a gift or a pack row the moment of placing.
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// The moment the reserve was placed, the same on every row of a placement: the day whose
  /// tariff credits the row takes.
  placedAt  DateTime    @default(now()) @map("placed_at") @db.Timestamptz(6)
  settledAt DateTime?   @map("settled_at") @db.Timestamptz(6)
  /// What the row paid; written once when captured, NULL on every other status (CHECK
  /// credit_holds_charged_check). A row of the rouble wallet has none.
  charged   Decimal?    @db.Decimal(14, 2)

  account BillingAccount @relation(fields: [accountId, unit], references: [id, unit], onDelete: Restrict, onUpdate: Restrict)
  task    Task           @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([taskId, attempt, accountId])
  @@index([accountId, status])
  @@index([accountId, placedAt])
  @@index([accountId, settledAt])
  @@index([status, expiresAt])
  @@map("credit_holds")
}

enum HoldStatus {
  active
  captured
  released
  expired
}

/// The single journal of credits and roubles (spec §17). Every balance change is one row, written
/// in the transaction that updates the balance; idempotency_key turns retries into no-ops
/// (e.g. "task:<taskId>:charge:<accountId>"). amount is signed: grants and top-ups are positive,
/// charges and expiries negative. unit copies the account's unit (composite foreign key) so a
/// CHECK keeps the amounts of the three credit accounts whole.
model CreditLedger {
  id             String      @id @default(uuid(7)) @db.Uuid
  accountId      String      @map("account_id") @db.Uuid
  unit           BillingUnit
  kind           LedgerKind
  amount         Decimal     @db.Decimal(14, 2)
  balanceAfter   Decimal     @map("balance_after") @db.Decimal(14, 2)
  taskId         String?     @map("task_id") @db.Uuid
  orderId        String?     @map("order_id") @db.Uuid
  idempotencyKey String      @unique @map("idempotency_key") @db.VarChar(255)
  /// Reason of an adjust entry by an operator.
  note           String?     @db.VarChar(500)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  account BillingAccount @relation(fields: [accountId, unit], references: [id, unit], onDelete: Restrict, onUpdate: Restrict)
  task    Task?          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([taskId])
  @@index([orderId])
  @@map("credit_ledger")
}

enum LedgerKind {
  grant
  topup
  charge
  refund
  expire
  adjust
}

/// A ЮKassa payment: a subscription period, a credit pack or a wallet top-up (spec §17). The
/// seller is self-employed: the amount carries no VAT and no 54-FZ receipt goes with the
/// payment. A workspace has at most one pending subscription order.
model Order {
  id                String        @id @default(uuid(7)) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  /// Who paid; kept as NULL if the user is deleted.
  userId            String?       @map("user_id") @db.Uuid
  kind              OrderKind
  /// Plan for subscription and pack orders; NULL for top-ups (CHECK in the init migration).
  planId            String?       @map("plan_id") @db.Uuid
  subscriptionId    String?       @map("subscription_id") @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  status            OrderStatus   @default(pending)
  yookassaPaymentId String?       @unique @map("yookassa_payment_id") @db.VarChar(64)
  /// Idempotence-Key of the create-payment request.
  idempotenceKey    String        @unique @map("idempotence_key") @db.VarChar(64)
  /// No longer used: nothing reads or writes it, a new row keeps the default. There are no
  /// 54-FZ receipts; a later contract migration drops the column and the ReceiptStatus type.
  receiptStatus     ReceiptStatus @default(pending) @map("receipt_status")
  /// The customer's consent to auto-renewal, given at checkout (off by default). The payment
  /// asks ЮKassa to save the method only when it is true, and only then is the saved method
  /// written to the subscription.
  savePaymentMethod Boolean       @default(false) @map("save_payment_method")
  /// The subscription period the order pays for. Both are set or both are NULL, and the end is
  /// after the start (CHECK in the billing_subscriptions migration).
  periodStart       DateTime?     @map("period_start") @db.Timestamptz(6)
  periodEnd         DateTime?     @map("period_end") @db.Timestamptz(6)
  /// Why the payment did not go through, as a short code; the payment history turns it into
  /// text for the customer.
  failureReason     String?       @map("failure_reason") @db.VarChar(64)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  /// ЮKassa refund id: a repeated refund finds it here and sends no second request.
  yookassaRefundId  String?       @unique @map("yookassa_refund_id") @db.VarChar(64)
  /// RUB returned to the customer: positive and not above amount (CHECK in the
  /// billing_subscriptions migration).
  refundedAmount    Decimal?      @map("refunded_amount") @db.Decimal(12, 2)
  refundedAt        DateTime?     @map("refunded_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan          Plan?          @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  ledgerEntries CreditLedger[]

  // One unfinished subscription order per workspace. As in subscriptions, workspaceId alone is
  // not a key for the client: add kind = subscription and status = pending.
  @@unique([workspaceId], map: "orders_workspace_pending_subscription_key", where: raw("kind = 'subscription' AND status = 'pending'"))
  @@index([workspaceId, createdAt])
  @@index([userId])
  @@index([planId])
  @@index([subscriptionId])
  @@index([status])
  @@map("orders")
}

/// Must equal orderKinds in @repo/domain (checked by a test).
enum OrderKind {
  subscription
  pack
  topup
}

/// Must equal orderStatuses in @repo/domain (checked by a test).
enum OrderStatus {
  pending
  paid
  failed
  refunded
  cancelled
}

/// No longer used, like orders.receipt_status; dropped together with it.
enum ReceiptStatus {
  pending
  succeeded
  cancelled
}

// ─── Outbox (reliable publishing to BullMQ) ───────────────────────────────────

/// Written in the same transaction as the business change; the relay in the orchestrator
/// moves pending rows to BullMQ (queue = topic, job name = type), marks them published and
/// clears their payload.
model OutboxEvent {
  id          String            @id @default(uuid(7)) @db.Uuid
  /// BullMQ queue name, one of queueNames in @repo/domain (checked by enqueueOutbox).
  topic       String            @db.VarChar(64)
  /// Job name inside the queue, e.g. "auth.verify_email".
  type        String            @db.VarChar(128)
  /// Job data; holds addresses and one-time links, so the relay sets it to NULL once the
  /// row is published. Always set on insert (enqueueOutbox); NULL only after publishing.
  payload     Json?
  /// Idempotency key: a second row with the same key is silently skipped.
  dedupeKey   String?           @unique @map("dedupe_key") @db.VarChar(255)
  status      OutboxEventStatus @default(pending)
  attempts    Int               @default(0)
  availableAt DateTime          @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt    DateTime?         @map("locked_at") @db.Timestamptz(6)
  lockedBy    String?           @map("locked_by") @db.VarChar(64)
  publishedAt DateTime?         @map("published_at") @db.Timestamptz(6)
  lastError   String?           @map("last_error") @db.Text
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_events")
}

/// A lead of the landing: «оставьте заявку на подключение» (docs/plan/65-landing-platforms-leads.md).
/// web writes it with an outbox row `leads`/`lead.send`; core posts it to the Telegram group of
/// leads and deletes the message there once someone presses «Обработано». The row stays here.
model Lead {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// «Заявка №N» in the group.
  number            Int       @unique @default(autoincrement())
  /// The form asked for the name, the mail and the description until 13.11.2026
  /// (20261113100000_leads_two_fields): only the leads before it have them.
  name              String?   @db.VarChar(100)
  /// How to reach the visitor: a phone number as `+<digits>` or a Telegram username as `@name`,
  /// normalised by leadInputSchema of @repo/domain. The column keeps its first name.
  phone             String    @db.VarChar(34)
  email             String?   @db.VarChar(254)
  /// The host of the site, lower-cased.
  site              String    @db.VarChar(253)
  about             String?   @db.Text
  /// The edition of «Согласие на обработку персональных данных» the visitor agreed to.
  consentVersion    String    @map("consent_version") @db.VarChar(32)
  /// Where the form stood: `landing`.
  source            String    @db.VarChar(32)
  /// HMAC-SHA256 of the client address (key BETTER_AUTH_SECRET), hex: the limit of leads per
  /// address counts by it; the address itself is not kept.
  ipHash            String    @map("ip_hash") @db.Char(64)
  /// The message in the Telegram group; set once it is sent.
  telegramMessageId BigInt?   @map("telegram_message_id")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  /// Someone pressed «Обработано»: the message in Telegram is deleted or emptied.
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ipHash, createdAt])
  @@map("leads")
}

enum OutboxEventStatus {
  pending
  published
  failed
}

// ─── Audit ────────────────────────────────────────────────────────────────────

/// Who did what, when (spec §16, §18): people, the agent, the platform and operators.
/// Append-only and without foreign keys, so the log outlives what it describes.
model AuditLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  actorType   AuditActorType @map("actor_type")
  /// User id, agent driver id or service name, depending on actor_type.
  actorId     String?        @map("actor_id") @db.VarChar(128)
  workspaceId String?        @map("workspace_id") @db.Uuid
  /// Dotted verb, e.g. "site.credentials.write" or "task.approve".
  action      String         @db.VarChar(128)
  /// Target object: type ("site", "task", …) and id.
  targetType  String?        @map("target_type") @db.VarChar(64)
  targetId    String?        @map("target_id") @db.VarChar(128)
  meta        Json?
  ip          String?        @db.VarChar(45)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorType, actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("audit_log")
}

enum AuditActorType {
  user
  agent
  system
  operator
}

// ─── The queue of a chat ──────────────────────────────────────────────────────

/// Must equal taskWaitingReasons in @repo/domain (checked by a test).
enum TaskWaiting {
  agents
  site
}

// ─── The cloud browser of a task (docs/plan/57-browser-tasks.md) ──────────────────────────────

/// Must equal browserSessionStatuses in @repo/domain (checked by a test).
enum BrowserSessionStatus {
  starting
  ready
  closed
  failed
  lost
}

/// Must equal browserControllers in @repo/domain (checked by a test).
enum BrowserController {
  agent
  user
}

/// Must equal browserCheckpointStates in @repo/domain (checked by a test).
enum BrowserCheckpointState {
  seen
  unverified
  verified
  missing
}

/// The cloud browser of a task as its worker holds it (Б10–Б18): one per task while it holds a
/// browser (`starting`, `ready`), across the turns of the task and its waits for the client. The
/// sign-in lives only in the browser (Б19): nothing here is a secret.
model BrowserSession {
  id              String               @id @default(uuid(7)) @db.Uuid
  taskId          String               @map("task_id") @db.Uuid
  workspaceId     String               @map("workspace_id") @db.Uuid
  status          BrowserSessionStatus @default(starting)
  /// Who drives it now; every hand-over moves control_epoch on (Б15).
  controller      BrowserController    @default(agent)
  controlEpoch    Int                  @default(0) @map("control_epoch")
  viewportVersion Int                  @default(1) @map("viewport_version")
  /// What the agent asked the client to do (`web_help`): one of browserHelpReasons and its words,
  /// together or neither (CHECK browser_sessions_help_check).
  helpReason      String?              @map("help_reason") @db.VarChar(16)
  helpMessage     String?              @map("help_message") @db.VarChar(500)
  /// The first click, input or upload in it, the agent's or the client's (Б28): the site may
  /// have changed.
  wroteAt         DateTime?            @map("wrote_at") @db.Timestamptz(6)
  /// The first of those of the latest pass (docs/plan/61-chats-first.md, §5.5).
  lastWroteAt     DateTime?            @map("last_wrote_at") @db.Timestamptz(6)
  lastActivityAt  DateTime             @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  /// Its hard deadline, whatever happens in it (BROWSER_SESSION_MAX_HOURS).
  expiresAt       DateTime             @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  readyAt         DateTime?            @map("ready_at") @db.Timestamptz(6)
  /// Set exactly when it holds no browser any more, with one of browserCloseReasons.
  closedAt        DateTime?            @map("closed_at") @db.Timestamptz(6)
  closeReason     String?              @map("close_reason") @db.VarChar(32)
  errorCode       String?              @map("error_code") @db.VarChar(48)

  task        Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  tickets     BrowserStreamTicket[]
  checkpoints BrowserCheckpoint[]

  @@unique([taskId], map: "browser_sessions_open_task_key", where: raw("status = ANY (ARRAY['starting'::\"BrowserSessionStatus\", 'ready'::\"BrowserSessionStatus\"])"))
  @@index([taskId])
  @@index([workspaceId])
  @@index([status, expiresAt])
  @@map("browser_sessions")
}

/// A one-time way into the stream of a session (Б12): 60 seconds, one connection, sent as the
/// first message. Only the SHA-256 of the ticket is kept.
model BrowserStreamTicket {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session BrowserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([expiresAt])
  @@map("browser_stream_tickets")
}

/// An object the task opened in the editor of the site (Б22): seen, saved and not yet confirmed
/// (`unverified`), confirmed by a trusted read (`verified`, with what it found) or not found.
model BrowserCheckpoint {
  id        String                 @id @default(uuid(7)) @db.Uuid
  taskId    String                 @map("task_id") @db.Uuid
  /// The session that last saw it.
  sessionId String                 @map("session_id") @db.Uuid
  /// browserCheckpointKinds and browserObjectIdSchema (CHECK browser_checkpoints_object_check).
  kind      String                 @db.VarChar(16)
  objectId  String                 @map("object_id") @db.VarChar(64)
  editUrl   String                 @map("edit_url") @db.VarChar(2048)
  state     BrowserCheckpointState @default(seen)
  /// browserVerifiedObjectSchema; set exactly while `verified`.
  verified  Json?
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  task    Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  session BrowserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([taskId, kind, objectId])
  @@index([sessionId])
  @@map("browser_checkpoints")
}

/// One call of the agent's web search (`raditi_search_web`, spec §20, «Веб-поиск агента —
/// 08.11.2026»): a row is written, under one lock, before the request leaves for the search
/// service, so the limits of a turn and of the whole service hold for parallel calls; the calls
/// of a workspace are counted, not limited (its credits are). Neither the query nor what came
/// back is kept: only who asked, when, how it ended and how long.
model WebSearchCall {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  /// The turn of the call, as its key names it; no foreign keys: the counts outlive the task.
  taskId      String    @map("task_id") @db.Uuid
  sessionId   String    @map("session_id") @db.VarChar(64)
  turnNo      Int       @map("turn_no")
  firstEpoch  Int       @map("first_epoch")
  /// webSearchStatuses; NULL while the request is out.
  status      String?   @db.VarChar(24)
  latencyMs   Int?      @map("latency_ms")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([taskId, sessionId, turnNo, firstEpoch])
  @@index([workspaceId, createdAt])
  @@index([createdAt])
  @@map("web_search_calls")
}

/// A published page of a workspace (docs/plan/69-pages.md): one address `<slug>.<PAGES_BASE_DOMAIN>`,
/// whatever its version (Ст16); never deleted by the platform (Ст14). `pending` — reserved by the
/// agent, no version yet; `live` — served; `taken_down` — 410 until the client puts it back.
/// A site of pages (docs/plan/73-pages-sites.md, Дер11): a host — its slug, its password and the
/// take-down of the host. In the trash when its home page is; its row stays after a purge as the
/// tombstone of its slug (410). Called a tree in code: `site` is the CMS site of the client.
model PageTree {
  id            String    @id @default(uuid(7)) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  slug          String    @unique @db.Char(26)
  /// Its own name, <name>.pages.raditi.ru, on «Бизнес» and above (Дер32); NULL — the slug alone.
  name          String?   @unique @db.VarChar(25)
  /// scrypt of the password the client set (Ст13, Дер17): one for the whole site.
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  passwordEpoch Int       @default(0) @map("password_epoch")
  takenDownAt   DateTime? @map("taken_down_at") @db.Timestamptz(6)
  /// client or operator: 410 on every path of the site.
  takenDownBy   String?   @map("taken_down_by") @db.VarChar(16)
  /// The chat it was made in: history, no key (Дер8).
  createdTaskId String?   @map("created_task_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdTask Task?          @relation(fields: [createdTaskId], references: [id], onDelete: SetNull)
  pages       Page[]
  redirects   PageRedirect[]
  names       PageTreeName[]
  files       PageFile[]

  @@index([workspaceId, createdAt])
  @@map("page_trees")
}

/// A shared file of a site at /_files/… of its host (Дер34): what its pages load.
model PageFile {
  treeId      String   @map("tree_id") @db.Uuid
  path        String   @db.VarChar(300)
  contentType String   @map("content_type") @db.VarChar(64)
  bytes       Bytes
  sha256      String   @db.Char(64)
  /// The chat whose turn put it; none — the client's.
  taskId      String?  @map("task_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tree PageTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  task Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@id([treeId, path])
  @@map("page_files")
}

/// Every name a site was ever given (Дер32): it leads to that site for ever, no other gets it.
model PageTreeName {
  name      String   @id @db.VarChar(25)
  /// The site the name is of; null — the site is gone, the name stays taken for ever (Дер32).
  treeId    String?  @map("tree_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tree PageTree? @relation(fields: [treeId], references: [id], onDelete: SetNull)

  @@index([treeId])
  @@map("page_tree_names")
}

/// A former path of a page that sends on to where it is now (Дер19).
model PageRedirect {
  treeId    String   @map("tree_id") @db.Uuid
  fromPath  String   @map("from_path") @db.VarChar(512)
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tree PageTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  page Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([treeId, fromPath])
  @@index([pageId])
  @@map("page_redirects")
}

model Page {
  id             String    @id @default(uuid(7)) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  /// The site it is a node of (Дер12).
  treeId         String    @map("tree_id") @db.Uuid
  /// NULL — the home page of its site.
  parentId       String?   @map("parent_id") @db.Uuid
  /// Its label in the path; NULL at the home page.
  segment        String?   @db.VarChar(63)
  /// The canonical path: `/` at the home page, `/uslugi/remont` below (Дер15).
  path           String    @default("/") @db.VarChar(512)
  /// Its order among the pages of its parent.
  position       Int       @default(0)
  /// The chat it was made in; a page outlives its chat.
  taskId         String?   @map("task_id") @db.Uuid
  turnNo         Int?      @map("turn_no")
  /// pageKinds of @repo/domain: html, markdown, doc.
  kind           String    @db.VarChar(16)
  /// The host of a page before sites (plan 69); read by nothing since 73.6, dropped in 73.12.
  slug           String?   @unique @db.Char(26)
  title          String    @db.VarChar(200)
  /// pageStates: pending, live, taken_down.
  state          String    @default("pending") @db.VarChar(16)
  /// v1, v2, …: 0 while pending; only grows.
  currentVersion Int       @default(0) @map("current_version")
  /// scrypt of the password the client set (Ст13); NULL — open.
  passwordHash   String?   @map("password_hash") @db.VarChar(255)
  /// Grows with every change of the password: the cookies of the former one stop.
  passwordEpoch  Int       @default(0) @map("password_epoch")
  takenDownAt    DateTime? @map("taken_down_at") @db.Timestamptz(6)
  /// client or operator.
  takenDownBy    String?   @map("taken_down_by") @db.VarChar(16)
  /// The document the page is drawn from (Ст7), one page a document.
  documentId     String?   @unique @map("document_id") @db.Uuid
  /// The file of the chat it was published from (Ст6, Ст32).
  sourceFileName String?   @map("source_file_name") @db.VarChar(200)
  /// In the trash since (docs/plan/73-pages-sites.md, Дер2): 410 to a viewer until returned or purged.
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// client or agent.
  deletedBy      String?   @map("deleted_by") @db.VarChar(16)
  /// When the sweep of core purges it; set with deleted_at.
  purgeAfter     DateTime? @map("purge_after") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tree         PageTree          @relation(fields: [treeId], references: [id], onDelete: Cascade)
  parent       Page?             @relation("PageChildren", fields: [parentId], references: [id], onDelete: NoAction)
  children     Page[]            @relation("PageChildren")
  redirects    PageRedirect[]
  task         Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  document     ChatDocument?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  versions     PageVersion[]
  content      PageContent?
  reservations PageReservation[]

  @@unique([treeId, path], map: "pages_tree_path_key", where: raw("deleted_at IS NULL"))
  @@unique([treeId], map: "pages_tree_home_key", where: raw("(parent_id IS NULL) AND (deleted_at IS NULL)"))
  @@index([workspaceId, createdAt])
  @@index([taskId])
  @@index([purgeAfter], map: "pages_purge_idx", where: raw("purge_after IS NOT NULL"))
  @@index([treeId, parentId, position])
  @@map("pages")
}

/// The history of the versions of a page: numbers, sizes, sums. The bytes of the current one alone
/// are kept, in `page_contents` (Ст16).
model PageVersion {
  id        String   @id @default(uuid(7)) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  no        Int
  sizeBytes Int      @map("size_bytes")
  sha256    String   @db.Char(64)
  /// outbox, doc or file.
  source    String   @db.VarChar(16)
  taskId    String?  @map("task_id") @db.Uuid
  turnNo    Int?     @map("turn_no")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  page    Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content PageContent?

  @@unique([pageId, no])
  @@index([createdAt])
  @@map("page_versions")
}

/// The bytes the page server answers with: the current version only.
model PageContent {
  pageId    String   @id @map("page_id") @db.Uuid
  versionNo Int      @map("version_no")
  bytes     Bytes
  /// The Markdown a page of a `.md` was drawn from (Дер26); NULL for HTML and before 73.6.
  source    Bytes?
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  page    Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// The bytes are of a version the history names: the number cannot drift from it.
  version PageVersion @relation(fields: [pageId, versionNo], references: [pageId, no])

  @@unique([pageId, versionNo])
  @@map("page_contents")
}

/// A publication the turn asked for, done at the end of the turn (Ст6, Ст7, Ст19): a file of the
/// outbox or a finished document becomes the next version of the page.
model PageReservation {
  id         String    @id @default(uuid(7)) @db.Uuid
  pageId     String    @map("page_id") @db.Uuid
  taskId     String    @map("task_id") @db.Uuid
  turnNo     Int       @map("turn_no")
  fileName   String?   @map("file_name") @db.VarChar(200)
  documentId String?   @map("document_id") @db.Uuid
  title      String    @db.VarChar(200)
  /// version (a file or a document), edit, update, delete or restore (docs/plan/73-pages-sites.md, Дер23).
  kind       String    @default("version") @db.VarChar(16)
  /// What a change asks: the edits, the new title or address, the pages to delete.
  payload    Json?
  /// NULL while it waits for the end of the turn; then done, missing, refused or failed.
  outcome    String?   @db.VarChar(16)
  versionNo  Int?      @map("version_no")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt  DateTime? @map("settled_at") @db.Timestamptz(6)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([taskId, turnNo, fileName])
  @@unique([taskId, turnNo, documentId])
  @@index([outcome, createdAt])
  @@map("page_reservations")
}

/// A document the agent writes section by section (Ст7, Ст21). The sections' text is shown to the
/// client only once core checked it at the end of its turn (Ст19).
model ChatDocument {
  id             String   @id @default(uuid(7)) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  taskId         String?  @map("task_id") @db.Uuid
  title          String   @db.VarChar(200)
  /// docViews: `page` — a page to read (.html), `text` — plain text (.md); the agent's choice.
  view           String   @default("text") @db.VarChar(8)
  /// Grows with every change: the card reads the document again (`feed.doc_touch`).
  revision       Int      @default(1)
  /// v1, v2, …: 0 before the first `doc_finish` came true.
  currentVersion Int      @default(0) @map("current_version")
  /// The chat and turn whose `doc_finish` waits for the end of that turn: a document belongs to
  /// the workspace, any chat of it may write it.
  finishTaskId   String?  @map("finish_task_id") @db.Uuid
  finishTurnNo   Int?     @map("finish_turn_no")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?                 @relation(fields: [taskId], references: [id], onDelete: SetNull)
  sections  ChatDocumentSection[]
  versions  ChatDocumentVersion[]
  content   ChatDocumentContent?
  page      Page?

  @@index([workspaceId, createdAt])
  @@index([taskId])
  @@map("chat_documents")
}

model ChatDocumentSection {
  id            String  @id @default(uuid(7)) @db.Uuid
  documentId    String  @map("document_id") @db.Uuid
  /// The id the agent gave it.
  sectionKey    String  @map("section_key") @db.VarChar(40)
  position      Int
  heading       String? @db.VarChar(200)
  markdown      String? @db.Text
  intent        String  @db.VarChar(200)
  /// docSectionStates: pending, written.
  state         String  @default("pending") @db.VarChar(16)
  /// The chat and turn that wrote it; core checks a section while its turn runs, and at its end.
  writtenTaskId String? @map("written_task_id") @db.Uuid
  writtenTurn   Int?    @map("written_turn")
  /// Set once core found nothing in it: until then the cabinet gets no text.
  checkedTurn   Int?    @map("checked_turn")
  /// Why core sent it back to pending (pageRefusalReasons).
  refusal       String? @db.VarChar(24)

  document ChatDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, sectionKey])
  @@index([documentId, position])
  @@index([writtenTaskId, writtenTurn])
  @@map("chat_document_sections")
}

/// The history of the versions of a document; the Markdown of the current one is in `chat_document_contents`.
model ChatDocumentVersion {
  id         String   @id @default(uuid(7)) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  no         Int
  sizeBytes  Int      @map("size_bytes")
  sha256     String   @db.Char(64)
  taskId     String?  @map("task_id") @db.Uuid
  turnNo     Int?     @map("turn_no")
  /// The Markdown of this version; NULL — finished before its text was kept (14.11.2026).
  markdown   String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document ChatDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content  ChatDocumentContent?

  @@unique([documentId, no])
  @@map("chat_document_versions")
}

model ChatDocumentContent {
  documentId String   @id @map("document_id") @db.Uuid
  versionNo  Int      @map("version_no")
  markdown   String   @db.Text
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  document ChatDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version  ChatDocumentVersion @relation(fields: [documentId, versionNo], references: [documentId, no])

  @@unique([documentId, versionNo])
  @@map("chat_document_contents")
}

/// The window of 5 hours or of the week a workspace opened with its first call (plan 71): what
/// its work takes in it is counted from token_usage of its tasks. Windows of one kind never
/// overlap — a new one opens under the advisory lock of the workspace, after the last one ended.
model WorkspaceUsageWindow {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// `5h` or `week`.
  kind        String   @db.VarChar(8)
  startedAt   DateTime @map("started_at") @db.Timestamptz(6)
  endsAt      DateTime @map("ends_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "workspace_usage_windows_workspace_fkey")

  @@unique([workspaceId, kind, startedAt], map: "workspace_usage_windows_workspace_kind_started_key")
  @@index([workspaceId, kind, endsAt], map: "workspace_usage_windows_workspace_kind_ends_idx")
  @@map("workspace_usage_windows")
}

/// The plan credits of a model of a provider's subscription plan per 10 000 tokens and its peak
/// (docs/plan/71-usage-limits.md, §2.1). Rows are only added, by `llm:plan-rates`.
model LlmPlanRate {
  id                  String   @id @default(uuid(7)) @db.Uuid
  providerId          String   @map("provider_id") @db.Uuid
  /// llm_models.provider_model_id the rates are of.
  model               String   @db.VarChar(255)
  effectiveFrom       DateTime @map("effective_from") @db.Timestamptz(6)
  inputUncachedPer10k Decimal  @map("input_uncached_per_10k") @db.Decimal(12, 6)
  cacheReadPer10k     Decimal  @map("cache_read_per_10k") @db.Decimal(12, 6)
  outputPer10k        Decimal  @map("output_per_10k") @db.Decimal(12, 6)
  offPeakShare        Decimal  @map("off_peak_share") @db.Decimal(5, 4)
  /// `{ timeZone, days, fromHour, toHour }` (planPeakSchema of @repo/domain).
  peak                Json
  sourceUrl           String   @map("source_url") @db.VarChar(1024)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  provider LlmProvider @relation(fields: [providerId], references: [id], onDelete: Restrict, map: "llm_plan_rates_provider_fkey")

  @@unique([providerId, model, effectiveFrom], map: "llm_plan_rates_provider_model_effective_from_key")
  @@map("llm_plan_rates")
}

/// What a turn of a model profile takes of the windows of the plan, p50 and p95 over 14 days
/// (Л12): a snapshot core recomputes; the pool reads p95 as the cost of a turn.
model LlmTurnCost {
  modelId        String   @id @map("model_id") @db.Uuid
  turns          Int
  p50PlanCredits Decimal  @map("p50_plan_credits") @db.Decimal(14, 4)
  p95PlanCredits Decimal  @map("p95_plan_credits") @db.Decimal(14, 4)
  computedAt     DateTime @map("computed_at") @db.Timestamptz(6)

  model LlmModel @relation(fields: [modelId], references: [id], onDelete: Cascade, map: "llm_turn_costs_model_fkey")

  @@map("llm_turn_costs")
}

/// Who named a dialog (`tasks.title_source`, owner's request of 15.11.2026).
enum TaskTitleSource {
  request
  agent
  client
}

/// A variable of a workspace (docs/plan/83-remove-projects.md, БП4): its value in Vault
/// `kv/workspaces/<workspaceId>/env/<NAME>`; every chat of the workspace gets it.
model WorkspaceEnvVar {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(64)
  /// KV v2 version the platform last wrote.
  keyVersion  Int      @default(1) @map("key_version")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User?     @relation("WorkspaceEnvVarCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
  @@index([createdBy])
  @@map("workspace_env_vars")
}

/// The skills of a workspace's agent (owner's request of 26.10.2026; per workspace since plan 83,
/// БП11): MCP servers the CLI of every chat of the workspace connects to besides the platform's
/// own. A workspace without rows has the platform's two skills on.
model WorkspaceAgentSkill {
  workspaceId   String              @map("workspace_id") @db.Uuid
  name          String              @db.VarChar(32)
  url           String?             @db.VarChar(512)
  enabled       Boolean             @default(true)
  /// Authorization of an added server (docs/plan/81-mcp-server-credentials.md); the secret is in
  /// Vault at `kv/workspaces/<workspace>/mcp/<name>`, never here.
  authKind      AgentSkillAuthKind  @default(none) @map("auth_kind")
  /// The name of the owner's header, for `header`.
  headerName    String?             @map("header_name") @db.VarChar(64)
  authState     AgentSkillAuthState @default(ok) @map("auth_state")
  /// When a check or a relayed call last found the authorization working or not.
  authCheckedAt DateTime?           @map("auth_checked_at") @db.Timestamptz(6)
  /// A code of why it does not work, never the server's own text.
  authError     String?             @map("auth_error") @db.VarChar(64)
  /// What of an OAuth sign-in is not secret: issuer, client id, token endpoint, scope, expiry.
  oauth         Json?
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, name])
  @@map("workspace_agent_skills")
}
