// Радити — data model v1 (spec §16).
// Conventions: uuid v7 ids, snake_case tables and columns via @@map/@map, timestamptz(6),
// enum values in lowercase snake_case, money as Decimal with an explicit precision (spec §16:
// never float, never integer kopecks). CHECK constraints Prisma cannot express are appended to
// the migration that creates their table; Prisma ignores them when diffing, so later migrations
// keep them.
// onDelete: Restrict for money, usage and history rows; Cascade only for rows that live and die
// with their parent (membership, channel identities, a task's turns, events and files);
// SetNull for "who did it" and "latest" pointers.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  // Unfinished turn assignments and active gateway rows use partial indexes.
  previewFeatures     = ["partialIndexes"]
  // .ts imports inside the generated client: plain Node loads it with type stripping
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (better-auth 1.7.6 core tables) ─────────────────────────────────────
// Field names are what better-auth writes; its schema check compares them with this model.

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String   @db.VarChar(255)
  lastName      String?  @map("last_name") @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?  @db.VarChar(1024)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions          Session[]
  accounts          Account[]
  consents          UserConsent[]
  memberships       Member[]
  channelIdentities ChannelIdentity[]
  workspacesCreated Workspace[]
  tasksCreated      Task[]
  attachments       Attachment[]
  orders            Order[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(1024)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  /// "credential" for email and password, otherwise the OAuth provider id.
  providerId            String    @map("provider_id") @db.VarChar(255)
  accountId             String    @map("account_id") @db.VarChar(255)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?   @db.Text
  /// Password hash; set only for providerId = "credential".
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

/// better-auth rate limiter with rateLimit.storage = "database" (no Redis for auth).
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique @db.VarChar(255)
  count       Int
  /// Unix time in milliseconds.
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// ─── Consents (152-FZ) ────────────────────────────────────────────────────────

/// Immutable append-only log: every consent action inserts a row, nothing is updated.
/// Current state per (userId, documentType) is the row with the latest createdAt.
model UserConsent {
  id              String              @id @default(uuid(7)) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  documentType    ConsentDocumentType @map("document_type")
  granted         Boolean
  documentVersion String              @map("document_version") @db.VarChar(80)
  source          ConsentSource
  ipAddress       String?             @map("ip_address") @db.VarChar(45)
  userAgent       String?             @map("user_agent") @db.VarChar(1024)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, documentType, createdAt(sort: Desc)])
  @@map("user_consents")
}

/// Must equal consentDocumentTypes in @repo/domain (checked by a test).
enum ConsentDocumentType {
  user_agreement
  privacy_policy
  pii_processing
  public_offer
  marketing
}

enum ConsentSource {
  sign_up
  onboarding
  settings
}

// ─── Workspaces and people ────────────────────────────────────────────────────

/// The client is a company, not a single person: sites, tasks and money belong to a workspace.
model Workspace {
  id          String             @id @default(uuid(7)) @db.Uuid
  name        String             @db.VarChar(255)
  /// Synthetic workspaces are explicit; real data requires a provider clearance.
  dataClass   WorkspaceDataClass @default(client) @map("data_class")
  createdById String?            @map("created_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members         Member[]
  sites           Site[]
  credentialRefs  CredentialRef[]
  chatSessions    ChatSession[]
  tasks           Task[]
  subscriptions   Subscription[]
  billingAccounts BillingAccount[]
  orders          Order[]

  @@index([createdById])
  @@map("workspaces")
}

enum WorkspaceDataClass {
  synthetic
  client
}

/// Workspace membership. One owner per workspace is kept by the service layer.
model Member {
  id          String     @id @default(uuid(7)) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  role        MemberRole @default(member)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("members")
}

enum MemberRole {
  owner
  admin
  member
}

/// A user's account in a chat channel; Telegram is linked by signing in to the cabinet (spec §18).
model ChannelIdentity {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  channel    Channel
  /// User id in the channel (Telegram or MAX user id as a string).
  externalId String   @map("external_id") @db.VarChar(64)
  /// Display handle, e.g. the Telegram @username; informational only.
  username   String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([userId])
  @@map("channel_identities")
}

enum Channel {
  web
  telegram
  max
}

// ─── Sites (spec §10, §12, §13) ───────────────────────────────────────────────

model Site {
  id             String      @id @default(uuid(7)) @db.Uuid
  workspaceId    String      @map("workspace_id") @db.Uuid
  name           String      @db.VarChar(255)
  /// Public origin of the production site, e.g. https://example.ru.
  url            String      @db.VarChar(512)
  stack          SiteStack
  status         SiteStatus  @default(onboarding)
  /// sync: server-side changes are committed to main before a deploy; freeze: DISALLOW_FILE_MODS.
  driftPolicy    DriftPolicy @default(sync) @map("drift_policy")
  /// First tasks go through an operator before the client sees them (spec §12, step 8).
  operatorReview Boolean     @default(true) @map("operator_review")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  lease           SiteLease?
  gitRepositories GitRepository[]
  environments    Environment[]
  credentialRefs  CredentialRef[]
  chatSessions    ChatSession[]
  tasks           Task[]
  snapshots       Snapshot[]
  deployments     Deployment[]
  turnAssignments TurnAssignment[]

  @@unique([workspaceId, url])
  @@map("sites")
}

/// Must equal siteStacks in @repo/domain (checked by a test).
enum SiteStack {
  wordpress
  bitrix
  laravel
  static
  node
  python
}

enum SiteStatus {
  onboarding
  active
  paused
  disconnected
  archived
}

enum DriftPolicy {
  sync
  freeze
}

/// Site lease (spec §7): at most one operation — a turn, a deploy or a revert — per site.
/// One row per site for its whole life. Acquire is a conditional UPDATE that sets the holder and
/// bumps epoch when the lease is free or expired; every write by a holder checks its epoch, which
/// fences a stale owner. held_for_operator: the deploy outcome is unknown, so an expired lease
/// is not taken over until an operator decides.
model SiteLease {
  siteId            String          @id @map("site_id") @db.Uuid
  operation         LeaseOperation?
  holderTaskId      String?         @map("holder_task_id") @db.Uuid
  epoch             Int             @default(0)
  acquiredAt        DateTime?       @map("acquired_at") @db.Timestamptz(6)
  expiresAt         DateTime?       @map("expires_at") @db.Timestamptz(6)
  heldForOperator   Boolean         @default(false) @map("held_for_operator")
  /// Durable barrier: expiry or a process crash cannot free an unconfirmed content write.
  inflightMcpCallId String?         @unique @map("inflight_mcp_call_id") @db.Uuid
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  holderTask      Task?    @relation(fields: [holderTaskId], references: [id], onDelete: Restrict)
  inflightMcpCall McpCall? @relation("McpWriteLease", fields: [inflightMcpCallId], references: [id], onDelete: Restrict)

  @@index([holderTaskId])
  @@map("site_leases")
}

enum LeaseOperation {
  turn
  deploy
  revert
}

/// Where a site's code lives (spec §10): our Gitea in MVP; later the client's GitHub or GitLab,
/// with our Gitea as the internal mirror for intermediate turns.
model GitRepository {
  id              String          @id @default(uuid(7)) @db.Uuid
  siteId          String          @map("site_id") @db.Uuid
  provider        GitProviderKind
  /// Organization or user, e.g. "sites" in our Gitea.
  owner           String          @db.VarChar(255)
  name            String          @db.VarChar(255)
  defaultBranch   String          @default("main") @map("default_branch") @db.VarChar(255)
  /// Web URL of the repository.
  url             String          @db.VarChar(1024)
  /// Platform access to the client's GitHub or GitLab; NULL for our Gitea (platform bot).
  credentialRefId String?         @map("credential_ref_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  site          Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  credentialRef CredentialRef? @relation(fields: [credentialRefId], references: [id], onDelete: Restrict)

  // Webhooks find the repository by provider and full name.
  @@unique([provider, owner, name])
  @@index([siteId])
  @@index([credentialRefId])
  @@map("git_repositories")
}

/// Must equal gitProviderKinds in @repo/domain (checked by a test).
enum GitProviderKind {
  gitea
  github
  gitlab
}

/// Deployment target of a site. Only prod exists (CLAUDE.md, rule 3); kind is a hook for staging.
model Environment {
  id           String          @id @default(uuid(7)) @db.Uuid
  siteId       String          @map("site_id") @db.Uuid
  kind         EnvironmentKind @default(prod)
  /// Server host name or IP for SSH or FTP.
  host         String          @db.VarChar(255)
  port         Int?
  deployMethod DeployMethod    @map("deploy_method")
  /// Document root or deploy directory on the server.
  path         String          @db.VarChar(1024)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  deployments Deployment[]

  @@unique([siteId, kind])
  @@map("environments")
}

enum EnvironmentKind {
  prod
}

enum DeployMethod {
  rsync
  git_ftp
  docker
}

/// A pointer to a secret in Vault, never the secret itself (CLAUDE.md, rule 2; spec §15).
/// Site access: kv/sites/<siteId>/{ssh,ftp,wp,browser}; provider keys: kv/llm/<provider>;
/// subscriptions: kv/subscriptions/<accountId>. Platform-wide refs (llm_provider, subscription)
/// have no workspace; site access always has a site (CHECK in the init migration).
model CredentialRef {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String?        @map("workspace_id") @db.Uuid
  siteId      String?        @map("site_id") @db.Uuid
  kind        CredentialKind
  vaultPath   String         @unique @map("vault_path") @db.VarChar(512)
  /// KV v2 version the platform last wrote; bumps on rotation.
  keyVersion  Int            @default(1) @map("key_version")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace           Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  site                Site?                @relation(fields: [siteId], references: [id], onDelete: Restrict)
  gitRepositories     GitRepository[]
  llmProviders        LlmProvider[]
  subscriptionAccount SubscriptionAccount?

  @@index([workspaceId])
  @@index([siteId, kind])
  @@map("credential_refs")
}

enum CredentialKind {
  ssh
  ftp
  wp
  browser
  git
  llm_provider
  subscription
}

// ─── Chat and tasks (spec §7, §8, §11) ────────────────────────────────────────

/// A conversation thread in one channel: the web chat of a site, a Telegram chat or topic, a MAX
/// chat. Holds the agent driver choice and a pointer to the latest turn for resuming.
model ChatSession {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  siteId          String?  @map("site_id") @db.Uuid
  channel         Channel
  /// Chat id in the channel (Telegram or MAX chat id as a string); NULL for the web chat.
  externalChatId  String?  @map("external_chat_id") @db.VarChar(64)
  /// Telegram forum topic (message_thread_id).
  telegramTopicId Int?     @map("telegram_topic_id")
  agentDriverId   String?  @map("agent_driver_id") @db.VarChar(32)
  lastTurnId      String?  @map("last_turn_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  site        Site?        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  agentDriver AgentDriver? @relation(fields: [agentDriverId], references: [id], onDelete: Restrict)
  lastTurn    TaskTurn?    @relation(fields: [lastTurnId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([workspaceId, siteId])
  @@index([channel, externalChatId, telegramTopicId])
  @@index([agentDriverId])
  @@index([lastTurnId])
  @@map("chat_sessions")
}

/// One client request: one logical agent session and one task branch (spec §7). The status
/// changes only by a conditional UPDATE in the same transaction as its credit_ledger entry.
model Task {
  id            String      @id @default(uuid(7)) @db.Uuid
  workspaceId   String      @map("workspace_id") @db.Uuid
  siteId        String      @map("site_id") @db.Uuid
  chatSessionId String?     @map("chat_session_id") @db.Uuid
  createdById   String?     @map("created_by_id") @db.Uuid
  /// «Отменить» of a done task: this task reverts that one and is never billed.
  revertsTaskId String?     @map("reverts_task_id") @db.Uuid
  status        TaskStatus  @default(queued)
  /// From the turn result (turnResultSchema.change_type); NULL until the first turn ends.
  changeType    ChangeType? @map("change_type")
  /// Class profile selected before queueing; selects the pricing rule.
  modelClass    ModelClass? @map("model_class")
  /// Summary of the latest turn result.
  summary       String?     @db.VarChar(500)
  /// Number of the latest turn; 0 before the first one.
  turnNo        Int         @default(0) @map("turn_no")
  /// «Попробовать ещё» (failed → queued) starts a new attempt with a new hold.
  attempt       Int         @default(1)
  prNumber      Int?        @map("pr_number")
  prUrl         String?     @map("pr_url") @db.VarChar(1024)
  /// The deployment that shipped (or last tried to ship) this task.
  deploymentId  String?     @unique @map("deployment_id") @db.Uuid
  /// Pinned when queued on the pay-per-action plan (spec §17).
  pricingRuleId String?     @map("pricing_rule_id") @db.Uuid
  /// Σ token_usage.cost_rub plus sandbox cost, full precision, never rounded.
  costRub       Decimal     @default(0) @map("cost_rub") @db.Decimal(18, 10)
  /// Charged to the wallet on done, rounded HALF_UP once; NULL on quota plans or until charged.
  billedRub     Decimal?    @map("billed_rub") @db.Decimal(12, 2)
  /// false for «Отменить» and operator retries: no hold, no charge.
  billable      Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  finishedAt    DateTime?   @map("finished_at") @db.Timestamptz(6)

  /// First bounded content access, including GET-only privacy maps.
  contentAccessedAt    DateTime? @map("content_accessed_at") @db.Timestamptz(6)
  /// Irreversible content retention barrier, set before deleting the expired privacy map.
  contentRetiredAt     DateTime? @map("content_retired_at") @db.Timestamptz(6)
  contentMasksPurgedAt DateTime? @map("content_masks_purged_at") @db.Timestamptz(6)

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  site            Site                @relation(fields: [siteId], references: [id], onDelete: Restrict)
  chatSession     ChatSession?        @relation(fields: [chatSessionId], references: [id], onDelete: Restrict)
  createdBy       User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  revertsTask     Task?               @relation("TaskReverts", fields: [revertsTaskId], references: [id], onDelete: Restrict)
  revertedBy      Task[]              @relation("TaskReverts")
  deployment      Deployment?         @relation("TaskCurrentDeployment", fields: [deploymentId], references: [id], onDelete: SetNull)
  pricingRule     PricingRule?        @relation(fields: [pricingRuleId], references: [id], onDelete: Restrict)
  deployments     Deployment[]        @relation("TaskDeployments")
  turns           TaskTurn[]
  events          TaskEvent[]
  attachments     Attachment[]
  snapshots       Snapshot[]
  tokenUsage      TokenUsage[]
  creditHolds     CreditHold[]
  ledgerEntries   CreditLedger[]
  leases          SiteLease[]
  turnAssignments TurnAssignment[]
  llmKeys         LlmKey[]
  accountBinding  TaskAccountBinding?
  /// Content restores the trusted host made while this task held the site lease.
  hostMcpCalls    McpCall[]           @relation("McpHostTask")

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([siteId, status])
  @@index([status, updatedAt])
  @@index([chatSessionId])
  @@index([createdById])
  @@index([revertsTaskId])
  @@index([pricingRuleId])
  @@map("tasks")
}

/// Must equal taskStatuses in @repo/domain (checked by a test).
enum TaskStatus {
  queued
  preparing
  running
  awaiting_user
  awaiting_approval
  deploying
  verifying
  done
  failed
  rolled_back
  cancelled
}

/// Must equal turnResultSchema.change_type in @repo/domain (checked by a test).
enum ChangeType {
  code
  content
  mixed
  none
}

/// Subscription profile classes (spec §9). The unused legacy service value remains until P4.
enum ModelClass {
  light
  standard
  heavy
  service
}

/// One container run of a task (spec §8). The snapshot under snapshot_prefix restores the next turn.
model TaskTurn {
  id              String     @id @default(uuid(7)) @db.Uuid
  taskId          String     @map("task_id") @db.Uuid
  turnNo          Int        @map("turn_no")
  status          TurnStatus @default(pending)
  driverId        String     @map("driver_id") @db.VarChar(32)
  driverVersion   String?    @map("driver_version") @db.VarChar(64)
  /// Sandbox image, pinned by digest.
  image           String     @db.VarChar(512)
  /// Model selected by the class profile for the turn.
  modelId         String?    @map("model_id") @db.Uuid
  /// Native session id of the CLI.
  nativeSessionId String?    @map("native_session_id") @db.VarChar(200)
  /// raditi-sessions prefix: sessions/<sessionId>/turns/<NNNN>/.
  snapshotPrefix  String?    @map("snapshot_prefix") @db.VarChar(512)
  /// Unused legacy per-turn key hash; retained until the P4 contract migration.
  /// The key itself is never stored.
  litellmKeyHash  String?    @unique @map("litellm_key_hash") @db.VarChar(64)
  baseSha         String?    @map("base_sha") @db.VarChar(64)
  headSha         String?    @map("head_sha") @db.VarChar(64)
  failureReason   String?    @map("failure_reason") @db.VarChar(2000)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt       DateTime?  @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?  @map("finished_at") @db.Timestamptz(6)

  task         Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  driver       AgentDriver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  model        LlmModel?     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  events       TaskEvent[]
  mcpCalls     McpCall[]
  tokenUsage   TokenUsage[]
  chatSessions ChatSession[]

  @@unique([taskId, turnNo])
  @@index([driverId])
  @@index([modelId])
  @@map("task_turns")
}

enum TurnStatus {
  pending
  running
  completed
  failed
  cancelled
  timed_out
  /// The runner or container vanished; never billed to the client (spec §17).
  lost
}

/// One turn's hold on an executor (spec §8 «Раннер на песочной ВМ»): core's own Docker or a runner
/// session, the lease epochs of its journal and the absolute deadline of its container. Recovery
/// reads the unfinished ones; a turn has at most one.
model TurnAssignment {
  id               String                 @id @default(uuid(7)) @db.Uuid
  taskId           String                 @map("task_id") @db.Uuid
  siteId           String                 @map("site_id") @db.Uuid
  /// Sandbox label of the session: sessions/<sessionId>/turns/<NNNN>/ in raditi-sessions.
  sessionId        String                 @map("session_id") @db.VarChar(64)
  turnNo           Int                    @map("turn_no")
  executor         TurnExecutorKind
  /// The turn request without its LLM key and MCP token (turnPlanSchema in @repo/domain).
  plan             Json
  /// The turn lease epoch it started under; recovery moves lease_epoch forward.
  firstEpoch       Int                    @map("first_epoch")
  leaseEpoch       Int                    @map("lease_epoch")
  /// Database time by which the container is gone; recovery never extends it.
  deadlineAt       DateTime               @map("deadline_at") @db.Timestamptz(6)
  runnerId         String?                @map("runner_id") @db.VarChar(63)
  /// A uuid per runner process start: a restarted runner is a new session.
  runnerSession    String?                @map("runner_session") @db.Uuid
  claimedAt        DateTime?              @map("claimed_at") @db.Timestamptz(6)
  containerId      String?                @map("container_id") @db.VarChar(200)
  recoveryAttempts Int                    @default(0) @map("recovery_attempts")
  outcome          TurnAssignmentOutcome?
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  finishedAt       DateTime?              @map("finished_at") @db.Timestamptz(6)

  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  site     Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  mcpCalls McpCall[]

  @@unique([taskId, turnNo], map: "turn_assignments_active_turn_key", where: raw("finished_at IS NULL"))
  @@index([siteId])
  @@index([runnerId, runnerSession])
  @@map("turn_assignments")
}

/// Must equal turnExecutorKinds in @repo/domain (checked by a test).
enum TurnExecutorKind {
  local
  runner
}

/// Must equal turnAssignmentOutcomes in @repo/domain (checked by a test).
enum TurnAssignmentOutcome {
  completed
  failed
  lost
}

/// Task history for the chat and SSE (spec §7). The bigint id orders events and is the
/// Last-Event-ID a browser resumes from. Large bodies live in S3 under s3_key.
model TaskEvent {
  id            BigInt   @id @default(autoincrement())
  taskId        String   @map("task_id") @db.Uuid
  turnId        String?  @map("turn_id") @db.Uuid
  /// A common agent event (started, message, command, …, failed) or a platform event.
  type          String   @db.VarChar(64)
  payload       Json
  /// Shown to the client in the chat; the rest is for operators.
  clientVisible Boolean  @default(false) @map("client_visible")
  /// Key in raditi-logs or raditi-artifacts when the body is too large for payload.
  s3Key         String?  @map("s3_key") @db.VarChar(1024)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  turn TaskTurn? @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([taskId, id])
  @@index([turnId])
  // The gateway and the key issuer check this flag on every lookup, admission and key issue.
  // The casts are what PostgreSQL stores for a varchar column: without them migrate diff reports
  // the index as changed.
  @@index([taskId], map: "task_events_llm_policy_flagged_idx", where: raw("type::text = 'llm.policy_flagged'::text"))
  @@map("task_events")
}

/// Journal of site-changing MCP calls (spec §11): a retry with the same idempotency key is not
/// applied twice; «Изменить» restores the turn's content edits from the linked snapshots.
model McpCall {
  id                 String          @id @default(uuid(7)) @db.Uuid
  /// Admission order after the site lease lock, independent of transaction start time.
  journalNo          BigInt          @unique @default(autoincrement()) @map("journal_no")
  /// Acknowledged site-side GC; journal identity/results remain for idempotent replay.
  receiptPurgedAt    DateTime?       @map("receipt_purged_at") @db.Timestamptz(6)
  turnId             String          @map("turn_id") @db.Uuid
  tool               String          @db.VarChar(200)
  idempotencyKey     String          @unique @map("idempotency_key") @db.VarChar(255)
  /// A call of the agent is tied to its immutable assignment and input. NULL for legacy rows
  /// and for a call of the trusted host.
  assignmentId       String?         @map("assignment_id") @db.Uuid
  /// Historical key id only: gateway key cleanup must not delete the content journal.
  credentialKeyId    String?         @map("credential_key_id") @db.Uuid
  /// A restore of the trusted host (spec §11): the task that held the site lease, with no
  /// assignment and no key. The call is written under the turn of the edit it returns.
  hostTaskId         String?         @map("host_task_id") @db.Uuid
  /// The operation of that lease: turn or revert.
  hostOperation      LeaseOperation? @map("host_operation")
  requestHash        String?         @map("request_hash") @db.VarChar(64)
  leaseEpoch         Int?            @map("lease_epoch")
  /// Set atomically with SiteLease.inflightMcpCallId, before any external mutation.
  writeStartedAt     DateTime?       @map("write_started_at") @db.Timestamptz(6)
  writeDeadlineAt    DateTime?       @map("write_deadline_at") @db.Timestamptz(6)
  appliedStateHash   String?         @map("applied_state_hash") @db.VarChar(64)
  /// Source being restored; snapshotId still captures the state before this restore.
  restoresSnapshotId String?         @map("restores_snapshot_id") @db.Uuid
  /// Changed object in the site adapter's notation, e.g. "post:42" or "option:blogname".
  objectRef          String?         @map("object_ref") @db.VarChar(1024)
  snapshotId         String?         @map("snapshot_id") @db.Uuid
  /// NULL while the call is in flight.
  result             McpCallResult?
  /// Response replayed to a retry with the same key.
  response           Json?
  error              String?         @db.VarChar(2000)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt         DateTime?       @map("finished_at") @db.Timestamptz(6)
  /// Set when «Изменить» or a turn retry rolled the edit back.
  revertedAt         DateTime?       @map("reverted_at") @db.Timestamptz(6)

  turn             TaskTurn        @relation(fields: [turnId], references: [id], onDelete: Cascade)
  snapshot         Snapshot?       @relation("McpCapturedSnapshot", fields: [snapshotId], references: [id], onDelete: Restrict)
  restoresSnapshot Snapshot?       @relation("McpRestoredSnapshot", fields: [restoresSnapshotId], references: [id], onDelete: Restrict)
  assignment       TurnAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  hostTask         Task?           @relation("McpHostTask", fields: [hostTaskId], references: [id], onDelete: Restrict)
  writeLease       SiteLease?      @relation("McpWriteLease")

  @@index([turnId])
  @@index([snapshotId])
  @@index([assignmentId])
  @@index([hostTaskId])
  @@index([restoresSnapshotId])
  @@map("mcp_calls")
}

enum McpCallResult {
  ok
  error
  denied
}

/// A client file from the chat in raditi-inbox (inbox/<wsId>/<taskId>/<fileId>).
model Attachment {
  id           String   @id @default(uuid(7)) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  source       Channel
  s3Key        String   @unique @map("s3_key") @db.VarChar(1024)
  fileName     String   @map("file_name") @db.VarChar(255)
  contentType  String   @map("content_type") @db.VarChar(255)
  sizeBytes    Int      @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([uploadedById])
  @@map("attachments")
}

/// Content snapshot taken before an edit (spec §11) in raditi-artifacts (snapshots/<siteId>/…);
/// «Отменить» restores it until expires_at (7 days).
model Snapshot {
  id               String    @id @default(uuid(7)) @db.Uuid
  siteId           String    @map("site_id") @db.Uuid
  taskId           String?   @map("task_id") @db.Uuid
  /// Object in the site adapter's notation, e.g. "post:42".
  objectRef        String    @map("object_ref") @db.VarChar(1024)
  s3Key            String    @unique @map("s3_key") @db.VarChar(1024)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  restoredAt       DateTime? @map("restored_at") @db.Timestamptz(6)
  /// Durable GC claim before any external deletion. Metadata is retained.
  purgeRequestedAt DateTime? @map("purge_requested_at") @db.Timestamptz(6)
  purgedAt         DateTime? @map("purged_at") @db.Timestamptz(6)
  /// Encrypted artifact integrity. Both NULL until the immutable payload is acknowledged.
  payloadSha256    String?   @map("payload_sha256") @db.VarChar(64)
  sizeBytes        Int?      @map("size_bytes")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  site         Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  mcpCalls     McpCall[] @relation("McpCapturedSnapshot")
  restoreCalls McpCall[] @relation("McpRestoredSnapshot")

  @@index([siteId, objectRef])
  @@index([taskId])
  @@index([expiresAt])
  @@map("snapshots")
}

/// A run of the mandatory deploy workflow (spec §10): backup → deploy → verify → auto-rollback.
/// kind = revert is «Отменить»: a revert commit shipped by the same workflow.
model Deployment {
  id            String           @id @default(uuid(7)) @db.Uuid
  siteId        String           @map("site_id") @db.Uuid
  environmentId String           @map("environment_id") @db.Uuid
  taskId        String           @map("task_id") @db.Uuid
  kind          DeploymentKind   @default(deploy)
  status        DeploymentStatus @default(pending)
  /// Merge or revert commit on main that the workflow deploys.
  commitSha     String?          @map("commit_sha") @db.VarChar(64)
  /// Workflow run id at the git provider (workflow_run webhook).
  workflowRunId String?          @map("workflow_run_id") @db.VarChar(64)
  /// raditi-backups prefix: sites/<siteId>/<deployId>/.
  backupPrefix  String?          @map("backup_prefix") @db.VarChar(512)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  startedAt     DateTime?        @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime?        @map("finished_at") @db.Timestamptz(6)

  site        Site        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  task        Task        @relation("TaskDeployments", fields: [taskId], references: [id], onDelete: Restrict)
  currentOf   Task?       @relation("TaskCurrentDeployment")

  @@index([siteId, createdAt(sort: Desc)])
  @@index([environmentId])
  @@index([taskId])
  @@index([commitSha])
  @@map("deployments")
}

enum DeploymentKind {
  deploy
  revert
}

enum DeploymentStatus {
  pending
  running
  succeeded
  failed
  rolled_back
  cancelled
  /// Outcome unknown: the site lease stays until an operator decides (spec §7).
  unknown
}

// ─── Agents and models (spec §8, §9) ──────────────────────────────────────────

/// Registry of agent drivers; id is AgentDriver.id (agentDriverIds in @repo/domain, the seed test
/// checks it). A string, not an enum: adding a driver needs no migration.
model AgentDriver {
  id           String   @id @db.VarChar(32)
  /// Unread: every driver runs the shared SANDBOX_IMAGE pinned by digest (spec §8). The seed
  /// writes a placeholder until the B16 contract migration drops the column.
  image        String   @db.VarChar(512)
  /// AgentCapabilities: resume, jsonEvents, outputSchema, mcp, images.
  capabilities Json
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  turns                TaskTurn[]
  chatSessions         ChatSession[]
  tokenUsage           TokenUsage[]
  subscriptionAccounts SubscriptionAccount[]
  llmKeys              LlmKey[]
  taskAccountBindings  TaskAccountBinding[]

  @@map("agent_drivers")
}

model LlmProvider {
  id              String          @id @default(uuid(7)) @db.Uuid
  /// Stable backend slug; legacy API providers remain disabled for price history.
  slug            String          @unique @db.VarChar(64)
  name            String          @db.VarChar(255)
  /// Subscription backend; the API kind is retained for historical rows (spec §9).
  kind            LlmProviderKind @default(api)
  credentialRefId String?         @map("credential_ref_id") @db.Uuid
  enabled         Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  credentialRef         CredentialRef?         @relation(fields: [credentialRefId], references: [id], onDelete: Restrict)
  models                LlmModel[]
  subscriptionAccounts  SubscriptionAccount[]
  crossBorderClearances CrossBorderClearance[]

  @@index([credentialRefId])
  @@map("llm_providers")
}

enum LlmProviderKind {
  api
  subscription
}

model LlmModel {
  id                  String     @id @default(uuid(7)) @db.Uuid
  providerId          String     @map("provider_id") @db.Uuid
  /// Stable model slug used in gateway requests.
  slug                String     @db.VarChar(128)
  /// Display name of the profile's model.
  name                String     @db.VarChar(255)
  /// Model id in the provider API; NULL until confirmed in the PoC.
  providerModelId     String?    @map("provider_model_id") @db.VarChar(255)
  modelClass          ModelClass @map("model_class")
  /// Output tokens reserved before a call, not the provider's output cap (spec §17).
  reserveOutputTokens Int        @default(32000) @map("reserve_output_tokens")
  enabled             Boolean    @default(true)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider   LlmProvider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  prices     LlmModelPrice[]
  turns      TaskTurn[]
  tokenUsage TokenUsage[]
  llmKeys    LlmKey[]
  llmCalls   LlmCall[]

  @@unique([providerId, slug])
  @@map("llm_models")
}

/// Accounting rate history in RUB per 1M tokens including VAT (spec §16, §17). Append-only: a new
/// price is a new row with a later effective_from; token_usage keeps the price_id it was costed
/// with. NULL cache prices are charged as input.
model LlmModelPrice {
  id              String   @id @default(uuid(7)) @db.Uuid
  modelId         String   @map("model_id") @db.Uuid
  effectiveFrom   DateTime @map("effective_from") @db.Timestamptz(6)
  inputPer1m      Decimal  @map("input_per_1m") @db.Decimal(14, 6)
  cacheReadPer1m  Decimal? @map("cache_read_per_1m") @db.Decimal(14, 6)
  cacheWritePer1m Decimal? @map("cache_write_per_1m") @db.Decimal(14, 6)
  /// Reasoning tokens are part of the output.
  outputPer1m     Decimal  @map("output_per_1m") @db.Decimal(14, 6)
  /// 0.2200 for 22%.
  vatRate         Decimal  @map("vat_rate") @db.Decimal(5, 4)
  sourceUrl       String   @map("source_url") @db.VarChar(1024)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  model      LlmModel     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  tokenUsage TokenUsage[]

  @@unique([modelId, effectiveFrom])
  @@unique([id, modelId])
  @@map("llm_model_prices")
}

/// One LLM call, ingested idempotently by gateway_call_id (spec §9,
/// §17). The only source for billing: agent usage events are for the UI. Token categories match
/// tokenUsageSchema in @repo/domain; cost uses the price row in price_id.
model TokenUsage {
  id                    String   @id @default(uuid(7)) @db.Uuid
  gatewayCallId         String   @unique @map("gateway_call_id") @db.Uuid
  keyId                 String   @map("key_id") @db.Uuid
  subscriptionAccountId String   @map("subscription_account_id") @db.Uuid
  taskId                String   @map("task_id") @db.Uuid
  taskAttempt           Int      @map("task_attempt")
  /// P12 creates the turn row before issue; earlier gateway calls have no turn row.
  turnId                String?  @map("turn_id") @db.Uuid
  driverId              String   @map("driver_id") @db.VarChar(32)
  modelId               String   @map("model_id") @db.Uuid
  priceId               String   @map("price_id") @db.Uuid
  /// Input without cache reads and cache writes.
  inputUncachedTokens   Int      @map("input_uncached_tokens")
  cacheReadTokens       Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens      Int      @default(0) @map("cache_write_tokens")
  /// Includes reasoning.
  outputTokens          Int      @map("output_tokens")
  /// Informational: already inside output_tokens, never added again.
  reasoningTokens       Int      @default(0) @map("reasoning_tokens")
  costRub               Decimal  @map("cost_rub") @db.Decimal(18, 10)
  estimated             Boolean  @default(false)
  estimateReason        String?  @map("estimate_reason") @db.VarChar(16)
  /// Platform-caused estimates still consume budget but are not charged to the client.
  billable              Boolean  @default(true)
  occurredAt            DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task                Task                @relation(fields: [taskId], references: [id], onDelete: Restrict)
  turn                TaskTurn?           @relation(fields: [turnId], references: [id], onDelete: Restrict)
  driver              AgentDriver         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  model               LlmModel            @relation(fields: [modelId], references: [id], onDelete: Restrict)
  price               LlmModelPrice       @relation(fields: [priceId, modelId], references: [id, modelId], onDelete: Restrict, onUpdate: Restrict)
  call                LlmCall             @relation(fields: [gatewayCallId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  key                 LlmKey              @relation(fields: [keyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptionAccount SubscriptionAccount @relation(fields: [subscriptionAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "token_usage_account_fkey")

  @@index([taskId, turnId])
  @@index([turnId])
  @@index([modelId, occurredAt])
  @@index([occurredAt])
  @@index([keyId])
  @@index([taskId, taskAttempt], map: "token_usage_task_attempt_idx")
  @@map("token_usage")
}

/// Pool subscription account (spec §9). Only the llm role reads its token from Vault.
/// Operator status and gateway health are independent; no token value is stored here.
model SubscriptionAccount {
  id                    String                    @id @default(uuid(7)) @db.Uuid
  providerId            String                    @map("provider_id") @db.Uuid
  /// Driver the subscription serves.
  driverId              String                    @map("driver_id") @db.VarChar(32)
  /// Unique among accounts that are not retired, as the provider account id below. Look an
  /// account up by either with findFirst and `status: { not: 'retired' }`: findUnique returns
  /// whichever row it meets first, a retired predecessor included.
  label                 String                    @db.VarChar(255)
  credentialRefId       String                    @unique @map("credential_ref_id") @db.Uuid
  /// Unused legacy limits; dropped by the P4 contract migration.
  limits                Json                      @default("{}")
  plan                  String                    @db.VarChar(32)
  /// Provider account id, not a secret. Relogin must retain this identity.
  externalAccountId     String?                   @map("external_account_id") @db.VarChar(128)
  paidUntil             DateTime?                 @map("paid_until") @db.Date
  status                SubscriptionAccountStatus @default(active)
  statusReason          String?                   @map("status_reason") @db.VarChar(64)
  health                SubscriptionAccountHealth @default(ok)
  healthReason          String?                   @map("health_reason") @db.VarChar(64)
  healthChangedAt       DateTime?                 @map("health_changed_at") @db.Timestamptz(6)
  coolingUntil          DateTime?                 @map("cooling_until") @db.Timestamptz(6)
  breakerOpenUntil      DateTime?                 @map("breaker_open_until") @db.Timestamptz(6)
  usageMissingStreak    Int                       @default(0) @map("usage_missing_streak") @db.SmallInt
  maxConcurrentTurns    Int                       @map("max_concurrent_turns") @db.SmallInt
  maxConcurrentRequests Int                       @map("max_concurrent_requests") @db.SmallInt
  limitWindows          Json                      @default("[]") @map("limit_windows")
  headroomPct           Decimal?                  @map("headroom_pct") @db.Decimal(5, 2)
  limitsSeenAt          DateTime?                 @map("limits_seen_at") @db.Timestamptz(6)
  /// No reader and no writer since the removal of OAuth; dropped by a contract migration.
  creditsSeen           Json?                     @map("credits_seen")
  credentialVersion     Int                       @default(0) @map("credential_version")
  credentialExpiresAt   DateTime?                 @map("credential_expires_at") @db.Timestamptz(6)
  credentialRefreshedAt DateTime?                 @map("credential_refreshed_at") @db.Timestamptz(6)
  /// The three refresh columns: no reader and no writer since the removal of OAuth; dropped
  /// by a contract migration.
  refreshStartedAt      DateTime?                 @map("refresh_started_at") @db.Timestamptz(6)
  refreshFinishedAt     DateTime?                 @map("refresh_finished_at") @db.Timestamptz(6)
  refreshFailures       Int                       @default(0) @map("refresh_failures")
  retireRequestedAt     DateTime?                 @map("retire_requested_at") @db.Timestamptz(6)
  credentialsRevokedAt  DateTime?                 @map("credentials_revoked_at") @db.Timestamptz(6)
  /// Device and installation identifiers, not authentication secrets. No reader and no writer
  /// since the removal of OAuth; dropped by a contract migration.
  clientIdentity        Json                      @default("{}") @map("client_identity")
  lastUsedAt            DateTime?                 @map("last_used_at") @db.Timestamptz(6)
  enabled               Boolean                   @default(false)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider      LlmProvider          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  driver        AgentDriver          @relation(fields: [driverId], references: [id], onDelete: Restrict)
  credentialRef CredentialRef        @relation(fields: [credentialRefId], references: [id], onDelete: Restrict)
  taskBindings  TaskAccountBinding[]
  llmKeys       LlmKey[]
  llmCalls      LlmCall[]
  tokenUsage    TokenUsage[]

  // A retired row stays for its history and releases its identity for a new import.
  @@unique([label], map: "subscription_accounts_label_key", where: raw("status <> 'retired'"))
  @@unique([providerId, externalAccountId], map: "subscription_accounts_external_key", where: raw("status <> 'retired'"))
  @@index([providerId])
  @@index([driverId])
  @@index([providerId, status, health], map: "subscription_accounts_pick_idx", where: raw("enabled"))
  @@map("subscription_accounts")
}

enum SubscriptionAccountStatus {
  active
  banned
  retired
}

enum SubscriptionAccountHealth {
  ok
  needs_relogin
  suspended
}

/// One pool binding per task, retained across turns and attempts.
model TaskAccountBinding {
  taskId                String   @id @map("task_id") @db.Uuid
  driverId              String   @map("driver_id") @db.VarChar(32)
  subscriptionAccountId String   @map("subscription_account_id") @db.Uuid
  boundAt               DateTime @default(now()) @map("bound_at") @db.Timestamptz(6)
  rebinds               Int      @default(0)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  task                Task                @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  driver              AgentDriver         @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptionAccount SubscriptionAccount @relation(fields: [subscriptionAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([subscriptionAccountId], map: "task_account_bindings_account_idx")
  @@map("task_account_bindings")
}

/// Turn key hash and admission budget. The actual key lives only in Vault turns/.
model LlmKey {
  id                    String    @id @default(uuid(7)) @db.Uuid
  keyHash               String    @unique @map("key_hash") @db.VarChar(64)
  /// Hash of the paired per-turn MCP token; legacy keys without it cannot reach MCP.
  mcpTokenHash          String?   @unique @map("mcp_token_hash") @db.VarChar(64)
  taskId                String    @map("task_id") @db.Uuid
  taskAttempt           Int       @map("task_attempt")
  sessionId             String    @map("session_id") @db.VarChar(64)
  turnNo                Int       @map("turn_no")
  firstEpoch            Int       @map("first_epoch")
  driverId              String    @map("driver_id") @db.VarChar(32)
  modelId               String    @map("model_id") @db.Uuid
  subscriptionAccountId String    @map("subscription_account_id") @db.Uuid
  reasoningEffort       String?   @map("reasoning_effort") @db.VarChar(16)
  /// Positive budget up to 750 RUB; fractional-ruble remainder budgets are valid.
  budgetRub             Decimal   @map("budget_rub") @db.Decimal(18, 10)
  /// Runner address; NULL for the local executor.
  boundSource           String?   @map("bound_source") @db.Inet
  issuedAt              DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  validUntil            DateTime  @map("valid_until") @db.Timestamptz(6)
  revokeRequestedAt     DateTime? @map("revoke_requested_at") @db.Timestamptz(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  usageClosedAt         DateTime? @map("usage_closed_at") @db.Timestamptz(6)
  lastCallAt            DateTime? @map("last_call_at") @db.Timestamptz(6)
  lastRefusal           String?   @map("last_refusal") @db.VarChar(32)
  lastRefusalAt         DateTime? @map("last_refusal_at") @db.Timestamptz(6)

  task                Task                @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  driver              AgentDriver         @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model               LlmModel            @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptionAccount SubscriptionAccount @relation(fields: [subscriptionAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  calls               LlmCall[]
  tokenUsage          TokenUsage[]

  @@unique([taskId, turnNo, firstEpoch])
  @@index([subscriptionAccountId, expiresAt], map: "llm_keys_account_active_idx", where: raw("revoked_at IS NULL"))
  @@index([taskId, taskAttempt], map: "llm_keys_task_attempt_idx")
  @@index([revokeRequestedAt], map: "llm_keys_revoke_retry_idx", where: raw("revoke_requested_at IS NOT NULL AND revoked_at IS NULL"))
  @@index([revokedAt], map: "llm_keys_usage_open_idx", where: raw("usage_closed_at IS NULL"))
  @@map("llm_keys")
}

/// One provider request, opened before send and closed atomically with its usage row.
model LlmCall {
  id                    String       @id @default(uuid(7)) @db.Uuid
  keyId                 String       @map("key_id") @db.Uuid
  subscriptionAccountId String       @map("subscription_account_id") @db.Uuid
  modelId               String       @map("model_id") @db.Uuid
  route                 String       @db.VarChar(64)
  state                 LlmCallState @default(open)
  reservedRub           Decimal      @map("reserved_rub") @db.Decimal(18, 10)
  requestBytes          Int          @map("request_bytes")
  /// est_in the reserve was priced with; a lost call is estimated from it. NULL: opened before it was kept.
  estimatedInputTokens  Int?         @map("estimated_input_tokens")
  responseBytes         BigInt       @default(0) @map("response_bytes")
  upstreamStatus        Int?         @map("upstream_status")
  upstreamResponseId    String?      @map("upstream_response_id") @db.VarChar(256)
  signal                String?      @db.VarChar(32)
  startedAt             DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt            DateTime?    @map("finished_at") @db.Timestamptz(6)

  key                 LlmKey              @relation(fields: [keyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptionAccount SubscriptionAccount @relation(fields: [subscriptionAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model               LlmModel            @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenUsage          TokenUsage?

  @@index([startedAt], map: "llm_calls_open_idx", where: raw("state = 'open'"))
  @@index([keyId], map: "llm_calls_key_idx")
  @@index([subscriptionAccountId, startedAt], map: "llm_calls_account_started_idx")
  @@index([signal, startedAt], map: "llm_calls_signal_idx", where: raw("signal IS NOT NULL"))
  @@map("llm_calls")
}

enum LlmCallState {
  open
  completed
  failed
  aborted
  lost
}

/// Operator-maintained clearance for sending real workspace data to a provider.
model CrossBorderClearance {
  id                   String    @id @default(uuid(7)) @db.Uuid
  providerId           String    @map("provider_id") @db.Uuid
  countries            String    @db.VarChar(64)
  notice22Ref          String    @map("notice22_ref") @db.VarChar(128)
  notice22Date         DateTime  @map("notice22_date") @db.Date
  recipientsAssessedOn DateTime  @map("recipients_assessed_on") @db.Date
  notice12Ref          String    @map("notice12_ref") @db.VarChar(128)
  notice12ReceivedOn   DateTime  @map("notice12_received_on") @db.Date
  transferAllowedFrom  DateTime  @map("transfer_allowed_from") @db.Date
  documents            String    @db.VarChar(1024)
  recordedBy           String    @map("recorded_by") @db.VarChar(255)
  recordedAt           DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)

  provider LlmProvider @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([providerId], map: "cross_border_clearances_active_idx", where: raw("revoked_at IS NULL"))
  @@map("cross_border_clearances")
}

// ─── Plans and billing (spec §17) ─────────────────────────────────────────────

/// Tariffs (docs/business.md §6). Prices in RUB without VAT: the seller is self-employed.
model Plan {
  id            String   @id @default(uuid(7)) @db.Uuid
  slug          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(100)
  kind          PlanKind
  /// Monthly price (quota), one-off price (pack), 0 for pay-per-action.
  price         Decimal  @db.Decimal(12, 2)
  editsPerMonth Int?     @map("edits_per_month")
  editsPerDay   Int?     @map("edits_per_day")
  /// Edits a pack adds to the account of purchased edits (unit = edit_pack).
  packEdits     Int?     @map("pack_edits")
  /// NULL for packs: they add edits, not sites.
  maxSites      Int?     @map("max_sites")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  pricingRules         PricingRule[]
  subscriptions        Subscription[]
  /// Subscriptions that switch to this plan at their next renewal.
  plannedSubscriptions Subscription[] @relation("SubscriptionNextPlan")
  orders               Order[]

  @@map("plans")
}

enum PlanKind {
  quota
  payg
  pack
}

/// Pay-per-action price (spec §17): clamp(fee_per_action + Σ cost × markup, min_charge,
/// hold_amount), rounded HALF_UP to kopecks once per task. Versioned by effective_from and never
/// edited: a task pins its rule when queued.
model PricingRule {
  id            String     @id @default(uuid(7)) @db.Uuid
  planId        String     @map("plan_id") @db.Uuid
  modelClass    ModelClass @map("model_class")
  effectiveFrom DateTime   @map("effective_from") @db.Timestamptz(6)
  markup        Decimal    @db.Decimal(8, 4)
  feePerAction  Decimal    @map("fee_per_action") @db.Decimal(12, 2)
  minCharge     Decimal    @map("min_charge") @db.Decimal(12, 2)
  /// Reserved from the wallet when the task is queued; also the price ceiling.
  holdAmount    Decimal    @map("hold_amount") @db.Decimal(12, 2)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  plan  Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  tasks Task[]

  @@unique([planId, modelClass, effectiveFrom])
  @@map("pricing_rules")
}

/// A workspace's subscription to a quota plan; renewed by cron with the saved payment method.
/// A workspace has at most one live subscription (trial, active or past_due); cancelled and
/// expired ones stay as history, and a later purchase is a new row. The period ends after it
/// starts (CHECK in the billing_subscriptions migration).
model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  workspaceId            String             @map("workspace_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  /// A scheduled plan change: the plan of the next period, applied at renewal. NULL when no
  /// change is scheduled.
  nextPlanId             String?            @map("next_plan_id") @db.Uuid
  status                 SubscriptionStatus @default(active)
  currentPeriodStart     DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime           @map("current_period_end") @db.Timestamptz(6)
  /// The moment of the payment the monthly periods are counted from. Every period starts on its
  /// day of month and time of day by the Moscow calendar; a shorter month takes its last day and
  /// the day comes back afterwards (31.01 → 28.02 → 31.03), which the period dates alone cannot
  /// tell.
  periodAnchor           DateTime           @map("period_anchor") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  /// When auto-renewal was switched off; cleared when it is switched on again.
  cancelledAt            DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  /// Since when the subscription is past_due: the renewal charge did not go through. Without a
  /// payment it expires a set number of days later.
  pastDueSince           DateTime?          @map("past_due_since") @db.Timestamptz(6)
  /// current_period_end of the period whose renewal notice is already in the outbox: the saved
  /// payment method is charged only after the customer was told. NULL when no notice stands.
  renewalNoticePeriodEnd DateTime?          @map("renewal_notice_period_end") @db.Timestamptz(6)
  /// ЮKassa saved payment method id for renewals.
  paymentMethodId        String?            @map("payment_method_id") @db.VarChar(64)
  /// ЮKassa payment_method.title, e.g. "Bank card *4444".
  paymentMethodTitle     String?            @map("payment_method_title") @db.VarChar(128)
  /// ЮKassa payment_method.type ("bank_card", "sbp", …), card.card_type ("Mir", "Visa", …) and
  /// card.last4 of the saved method: the customer's label «Карта «Мир» •• 4444» is built from
  /// them in Russian, not from the title.
  paymentMethodType      String?            @map("payment_method_type") @db.VarChar(32)
  paymentMethodCardType  String?            @map("payment_method_card_type") @db.VarChar(32)
  paymentMethodLast4     String?            @map("payment_method_last4") @db.VarChar(4)
  /// ЮKassa payment method that is being bound to replace the saved one; NULL when no
  /// replacement is under way.
  pendingPaymentMethodId String?            @map("pending_payment_method_id") @db.VarChar(64)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  nextPlan  Plan?     @relation("SubscriptionNextPlan", fields: [nextPlanId], references: [id], onDelete: Restrict)
  orders    Order[]

  // One live subscription per workspace. The client offers workspaceId as a unique key, but the
  // index covers live rows only: findUnique, update and upsert add the status filter, or they
  // take any subscription of the workspace, an ended one included.
  // The predicate is spelled as PostgreSQL stores status IN ('trial', 'active', 'past_due'):
  // any other spelling makes migrate diff report the index as changed.
  @@unique([workspaceId], map: "subscriptions_workspace_live_key", where: raw("status = ANY (ARRAY['trial'::\"SubscriptionStatus\", 'active'::\"SubscriptionStatus\", 'past_due'::\"SubscriptionStatus\"])"))
  @@index([workspaceId])
  @@index([planId])
  @@index([nextPlanId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Must equal subscriptionStatuses in @repo/domain (checked by a test). trial is not used yet.
enum SubscriptionStatus {
  trial
  active
  past_due
  cancelled
  expired
}

/// An account of a workspace (spec §17), one per unit: the edits of the tariff (unit = edit),
/// purchased edits (unit = edit_pack) or the RUB wallet (unit = rub).
/// balance and held change only in SQL, in the transaction that writes credit_ledger or
/// credit_holds. held = Σ active holds; available = balance − held. Both edit accounts hold
/// whole numbers (CHECK in the billing_subscriptions migration).
model BillingAccount {
  id          String      @id @default(uuid(7)) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  unit        BillingUnit
  balance     Decimal     @default(0) @db.Decimal(14, 2)
  held        Decimal     @default(0) @db.Decimal(14, 2)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  holds     CreditHold[]
  entries   CreditLedger[]

  @@unique([workspaceId, unit])
  // Target of the (account_id, unit) foreign keys: a ledger entry's or hold's unit always matches
  // its account.
  @@unique([id, unit])
  @@map("billing_accounts")
}

/// A workspace has two edit accounts; their units must equal editAccountUnits in @repo/domain
/// (checked by a test). The values keep the order of the database type.
enum BillingUnit {
  /// Edits of the tariff: the quota is granted anew every period and what is left of the
  /// previous one expires.
  edit
  /// Roubles of the pay-per-action wallet.
  rub
  /// Purchased edits (a pack): they never expire and outlive the tariff.
  edit_pack
}

/// A task's reserve (spec §17): one edit, or the class hold amount in RUB. «Попробовать ещё» is a
/// new attempt with a new hold; topping up an existing budget raises amount.
/// unit copies the account's unit (composite foreign key, as in credit_ledger) so a CHECK keeps
/// edit holds whole; it also tells on which of the two edit accounts the edit is reserved.
model CreditHold {
  id        String      @id @default(uuid(7)) @db.Uuid
  accountId String      @map("account_id") @db.Uuid
  unit      BillingUnit
  taskId    String      @map("task_id") @db.Uuid
  attempt   Int         @default(1)
  amount    Decimal     @db.Decimal(14, 2)
  status    HoldStatus  @default(active)
  /// Cron expires holds of tasks stuck past this moment (e.g. in awaiting_user).
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt DateTime?   @map("settled_at") @db.Timestamptz(6)

  account BillingAccount @relation(fields: [accountId, unit], references: [id, unit], onDelete: Restrict, onUpdate: Restrict)
  task    Task           @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([taskId, attempt])
  @@index([accountId, status])
  @@index([status, expiresAt])
  @@map("credit_holds")
}

enum HoldStatus {
  active
  captured
  released
  expired
}

/// The single journal of edits and roubles (spec §17). Every balance change is one row, written
/// in the transaction that updates the balance; idempotency_key turns retries into no-ops
/// (e.g. "task:<id>:<attempt>:charge"). amount is signed: grants and top-ups are positive,
/// charges and expiries negative. unit copies the account's unit (composite foreign key) so a
/// CHECK keeps the amounts of both edit accounts whole.
model CreditLedger {
  id             String      @id @default(uuid(7)) @db.Uuid
  accountId      String      @map("account_id") @db.Uuid
  unit           BillingUnit
  kind           LedgerKind
  amount         Decimal     @db.Decimal(14, 2)
  balanceAfter   Decimal     @map("balance_after") @db.Decimal(14, 2)
  taskId         String?     @map("task_id") @db.Uuid
  orderId        String?     @map("order_id") @db.Uuid
  idempotencyKey String      @unique @map("idempotency_key") @db.VarChar(255)
  /// Reason of an adjust entry by an operator.
  note           String?     @db.VarChar(500)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  account BillingAccount @relation(fields: [accountId, unit], references: [id, unit], onDelete: Restrict, onUpdate: Restrict)
  task    Task?          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([taskId])
  @@index([orderId])
  @@map("credit_ledger")
}

enum LedgerKind {
  grant
  topup
  charge
  refund
  expire
  adjust
}

/// A ЮKassa payment: a subscription period, an edit pack or a wallet top-up (spec §17). The
/// seller is self-employed: the amount carries no VAT and no 54-FZ receipt goes with the
/// payment. A workspace has at most one pending subscription order.
model Order {
  id                String        @id @default(uuid(7)) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  /// Who paid; kept as NULL if the user is deleted.
  userId            String?       @map("user_id") @db.Uuid
  kind              OrderKind
  /// Plan for subscription and pack orders; NULL for top-ups (CHECK in the init migration).
  planId            String?       @map("plan_id") @db.Uuid
  subscriptionId    String?       @map("subscription_id") @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  status            OrderStatus   @default(pending)
  yookassaPaymentId String?       @unique @map("yookassa_payment_id") @db.VarChar(64)
  /// Idempotence-Key of the create-payment request.
  idempotenceKey    String        @unique @map("idempotence_key") @db.VarChar(64)
  /// No longer used: nothing reads or writes it, a new row keeps the default. There are no
  /// 54-FZ receipts; a later contract migration drops the column and the ReceiptStatus type.
  receiptStatus     ReceiptStatus @default(pending) @map("receipt_status")
  /// The first payment of a subscription saves the method for renewals.
  savePaymentMethod Boolean       @default(false) @map("save_payment_method")
  /// The subscription period the order pays for. Both are set or both are NULL, and the end is
  /// after the start (CHECK in the billing_subscriptions migration).
  periodStart       DateTime?     @map("period_start") @db.Timestamptz(6)
  periodEnd         DateTime?     @map("period_end") @db.Timestamptz(6)
  /// Why the payment did not go through, as a short code; the payment history turns it into
  /// text for the customer.
  failureReason     String?       @map("failure_reason") @db.VarChar(64)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  /// ЮKassa refund id: a repeated refund finds it here and sends no second request.
  yookassaRefundId  String?       @unique @map("yookassa_refund_id") @db.VarChar(64)
  /// RUB returned to the customer: positive and not above amount (CHECK in the
  /// billing_subscriptions migration).
  refundedAmount    Decimal?      @map("refunded_amount") @db.Decimal(12, 2)
  refundedAt        DateTime?     @map("refunded_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan          Plan?          @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  ledgerEntries CreditLedger[]

  // One unfinished subscription order per workspace. As in subscriptions, workspaceId alone is
  // not a key for the client: add kind = subscription and status = pending.
  @@unique([workspaceId], map: "orders_workspace_pending_subscription_key", where: raw("kind = 'subscription' AND status = 'pending'"))
  @@index([workspaceId, createdAt])
  @@index([userId])
  @@index([planId])
  @@index([subscriptionId])
  @@index([status])
  @@map("orders")
}

/// Must equal orderKinds in @repo/domain (checked by a test).
enum OrderKind {
  subscription
  pack
  topup
}

/// Must equal orderStatuses in @repo/domain (checked by a test).
enum OrderStatus {
  pending
  paid
  failed
  refunded
  cancelled
}

/// No longer used, like orders.receipt_status; dropped together with it.
enum ReceiptStatus {
  pending
  succeeded
  cancelled
}

// ─── Outbox (reliable publishing to BullMQ) ───────────────────────────────────

/// Written in the same transaction as the business change; the relay in the orchestrator
/// moves pending rows to BullMQ (queue = topic, job name = type), marks them published and
/// clears their payload.
model OutboxEvent {
  id          String            @id @default(uuid(7)) @db.Uuid
  /// BullMQ queue name, one of queueNames in @repo/domain (checked by enqueueOutbox).
  topic       String            @db.VarChar(64)
  /// Job name inside the queue, e.g. "auth.verify_email".
  type        String            @db.VarChar(128)
  /// Job data; holds addresses and one-time links, so the relay sets it to NULL once the
  /// row is published. Always set on insert (enqueueOutbox); NULL only after publishing.
  payload     Json?
  /// Idempotency key: a second row with the same key is silently skipped.
  dedupeKey   String?           @unique @map("dedupe_key") @db.VarChar(255)
  status      OutboxEventStatus @default(pending)
  attempts    Int               @default(0)
  availableAt DateTime          @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt    DateTime?         @map("locked_at") @db.Timestamptz(6)
  lockedBy    String?           @map("locked_by") @db.VarChar(64)
  publishedAt DateTime?         @map("published_at") @db.Timestamptz(6)
  lastError   String?           @map("last_error") @db.Text
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_events")
}

enum OutboxEventStatus {
  pending
  published
  failed
}

// ─── Audit ────────────────────────────────────────────────────────────────────

/// Who did what, when (spec §16, §18): people, the agent, the platform and operators.
/// Append-only and without foreign keys, so the log outlives what it describes.
model AuditLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  actorType   AuditActorType @map("actor_type")
  /// User id, agent driver id or service name, depending on actor_type.
  actorId     String?        @map("actor_id") @db.VarChar(128)
  workspaceId String?        @map("workspace_id") @db.Uuid
  /// Dotted verb, e.g. "site.credentials.write" or "task.approve".
  action      String         @db.VarChar(128)
  /// Target object: type ("site", "task", …) and id.
  targetType  String?        @map("target_type") @db.VarChar(64)
  targetId    String?        @map("target_id") @db.VarChar(128)
  meta        Json?
  ip          String?        @db.VarChar(45)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorType, actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("audit_log")
}

enum AuditActorType {
  user
  agent
  system
  operator
}
