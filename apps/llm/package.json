{
  "name": "llm",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm --filter @repo/service-runtime build && nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:db": "vitest run .integration.test.",
    "subscriptions:login": "node scripts/subscription-login.mjs",
    "subscriptions:retire": "node scripts/subscription-retire.mjs",
    "subscriptions:token": "node scripts/subscription-token.mjs"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@prometheus-io/client": "catalog:",
    "@repo/app-bootstrap": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/ip-address": "workspace:*",
    "@repo/llm-backends": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/service-runtime": "workspace:*",
    "@repo/turn-keys": "workspace:*",
    "@repo/vault": "workspace:*",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
