    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/ip-address": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/sandbox-providers": "workspace:*",
    "@repo/service-runtime": "workspace:*",
    "@repo/site-adapters": "workspace:*",
    "@repo/storage": "workspace:*",
    "express": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
