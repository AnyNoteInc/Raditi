{
  "name": "orchestrator",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "verify:snapshots": "pnpm build && node --env-file=../../.env scripts/verify-snapshots.mjs",
    "verify:transport": "pnpm build && node scripts/verify-snapshot-transport.mjs",
    "verify:publication": "pnpm build && NODE_ENV=test node scripts/verify-publication.mjs",
    "runner-token": "node scripts/runner-token.mjs"
  },
  "dependencies": {
    "@repo/agent-drivers": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/mail": "workspace:*",
    "@repo/notifications": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/sandbox-providers": "workspace:*",
    "@repo/storage": "workspace:*",
    "@repo/vault": "workspace:*",
    "@modelcontextprotocol/core": "catalog:",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@prometheus-io/client": "catalog:",
    "@rekog/mcp-nest": "catalog:",
    "bullmq": "catalog:",
    "express": "catalog:",
    "ioredis": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:",
    "tar-stream": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/core": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
