{
  "name": "core",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm --filter @repo/service-runtime build && nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test scripts/*.test.mjs && vitest run",
    "test:db": "vitest run .integration.test.",
    "verify:snapshots": "pnpm build && node --env-file=../../.env scripts/verify-snapshots.mjs",
    "verify:transport": "pnpm build && node scripts/verify-snapshot-transport.mjs",
    "verify:publication": "pnpm build && NODE_ENV=test node scripts/verify-publication.mjs",
    "verify:runner": "pnpm build && pnpm --filter runner build && node --env-file=../../.env scripts/verify-runner.mjs",
    "billing:refund": "node scripts/billing-refund.mjs",
    "billing:stop-renewal": "node scripts/billing-stop-renewal.mjs",
    "billing:refunds-needed": "node scripts/billing-refunds-needed.mjs",
    "billing:settle-payment": "node scripts/billing-settle-payment.mjs",
    "billing:rates": "node scripts/billing-rates.mjs",
    "releases:resolve": "node scripts/releases-resolve.mjs",
    "verify:llm-gateway": "exec node scripts/verify-llm-gateway.mjs",
    "verify:opencode-supervisor": "pnpm build && pnpm --filter runner build && exec node scripts/verify-opencode-supervisor.mjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@prometheus-io/client": "catalog:",
    "@repo/agent-drivers": "workspace:*",
    "@repo/app-bootstrap": "workspace:*",
    "@repo/billing": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/git-providers": "workspace:*",
    "@repo/ip-address": "workspace:*",
    "@repo/llm-backends": "workspace:*",
    "@repo/local-turns": "workspace:*",
    "@repo/mail": "workspace:*",
    "@repo/notifications": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/sandbox-providers": "workspace:*",
    "@repo/service-runtime": "workspace:*",
    "@repo/site-adapters": "workspace:*",
    "@repo/site-connections": "workspace:*",
    "@repo/site-content": "workspace:*",
    "@repo/snapshots": "workspace:*",
    "@repo/storage": "workspace:*",
    "@repo/turn-keys": "workspace:*",
    "@repo/vault": "workspace:*",
    "@repo/yookassa": "workspace:*",
    "bullmq": "catalog:",
    "express": "catalog:",
    "ioredis": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "tar-stream": "catalog:",
    "tldts": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@rekog/mcp-nest": "catalog:",
    "@repo/browser-providers": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
